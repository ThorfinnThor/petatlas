---
/**
 * M04-02 — Gemeinsames Grundgerüst für alle Seiten.
 *
 * Setzt Sprache, Viewport, Titel, canonical und robots, bindet die Design
 * Tokens ein und rahmt den Inhalt mit Kopf- und Fußbereich. Fachliche
 * Inhalte stehen in den Seiten, nicht hier.
 */
import { devFeatureOverrides, resolveBuildConfig, robotsDirective } from '../../config/build.ts';
import { createSiteConfig } from '../../config/site.ts';
import { defaultMarket, withEnabledFeatures } from '../domain/market.ts';
import { canonicalUrl, type RouteKey } from '../lib/routes.ts';
import Notice from '../components/Notice.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/tokens.css';
import '../styles/print.css';

interface Props {
  title: string;
  /** Route dieser Seite, für canonical und aktiven Navigationszustand. */
  route?: RouteKey;
  /**
   * Pfad dieser Seite, wenn sie eine Unterseite einer Route ist. Ohne diese
   * Angabe zeigte das canonical einer Stadtseite auf die Kartenseite und
   * erklärte sie damit selbst zum Duplikat.
   */
  canonicalPfad?: string;
  /** Seiten, die auch in production nie indexiert werden dürfen. */
  neverIndex?: boolean;
}

const { title, route, canonicalPfad, neverIndex = false } = Astro.props;

const build = resolveBuildConfig();
const site = createSiteConfig(build.mode, process.env);
const market = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
const robots = neverIndex ? 'noindex, nofollow' : robotsDirective(build);
const canonical = canonicalPfad
  ? new URL(canonicalPfad, build.baseUrl).toString()
  : route
    ? canonicalUrl(build.baseUrl, market, route)
    : null;
---

<!doctype html>
<html lang={market.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {site.brandName}</title>
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body data-pagefind-ignore={neverIndex ? 'all' : undefined}>
    <SiteHeader market={market} brandName={site.brandName} aktuellerPfad={Astro.url.pathname} />
    {
      build.showTestDataBanner && (
        <div class="randbreite">
          <Notice variante="testdaten" titel="Testdaten" testId="test-data-banner">
            <p>
              Dieser Build zeigt synthetische Beispieldaten. Keine echten Praxen, Preise oder
              Regeln.
            </p>
          </Notice>
        </div>
      )
    }
    <main>
      <slot />
    </main>
    <SiteFooter market={market} betreiber={site.operator.legalName} />
  </body>
</html>

<style>
  /* Der Testdatenhinweis steht außerhalb von <main> und braucht dieselbe
     Inhaltsbreite, damit er nicht über die ganze Fensterbreite läuft. */
  .randbreite {
    max-width: var(--breite-inhalt);
    margin-inline: auto;
  }
</style>
