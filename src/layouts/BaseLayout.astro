---
/**
 * M04-02 — Gemeinsames Grundgerüst für alle Seiten.
 *
 * Setzt Sprache, Viewport, Titel, canonical und robots, bindet die Design
 * Tokens ein und rahmt den Inhalt mit Kopf- und Fußbereich. Fachliche
 * Inhalte stehen in den Seiten, nicht hier.
 */
import { devFeatureOverrides, resolveBuildConfig, robotsDirective } from '../../config/build.ts';
import { createSiteConfig } from '../../config/site.ts';
import { defaultMarket, withEnabledFeatures } from '../domain/market.ts';
import { canonicalUrl, type RouteKey } from '../lib/routes.ts';
import Notice from '../components/Notice.astro';
import { aufzaehlung, vorschauBestand } from '../features/freshness/preview-notice.ts';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/typography.css';
import '../styles/base.css';
import '../styles/print.css';

interface Props {
  title: string;
  /** Route dieser Seite, für canonical und aktiven Navigationszustand. */
  route?: RouteKey;
  /**
   * Pfad dieser Seite, wenn sie eine Unterseite einer Route ist. Ohne diese
   * Angabe zeigte das canonical einer Stadtseite auf die Kartenseite und
   * erklärte sie damit selbst zum Duplikat.
   */
  canonicalPfad?: string;
  /** Seiten, die auch in production nie indexiert werden dürfen. */
  neverIndex?: boolean;
  /**
   * Breite Seiten (Karte, große Vergleiche) nutzen den Seitencontainer statt
   * der Lesebreite — Designvertrag Abschnitt 6.2 und 6.3.
   */
  weit?: boolean;
}

const { title, route, canonicalPfad, neverIndex = false, weit = false } = Astro.props;

const build = resolveBuildConfig();
const site = createSiteConfig(build.mode, process.env);
const market = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
const robots = neverIndex ? 'noindex, nofollow' : robotsDirective(build);
// Der Vorschauhinweis wird aus den Datenständen abgeleitet, nicht getippt:
// ein fest geschriebener Satz stand monatelang falsch über echten Daten.
const bestand = build.showTestDataBanner
  ? vorschauBestand(market)
  : { echt: [], ungeprueft: [], synthetisch: [] };
const canonical = canonicalPfad
  ? new URL(canonicalPfad, build.baseUrl).toString()
  : route
    ? canonicalUrl(build.baseUrl, market, route)
    : null;
---

<!doctype html>
<html lang={market.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {site.brandName}</title>
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body data-route={route} data-pagefind-ignore={neverIndex ? 'all' : undefined}>
    {
      /*
      M18-04 — Sprungmarke. Ohne sie muss jemand, der mit der Tastatur
      bedient, auf jeder Seite die ganze Navigation durchtabben, bevor er
      beim Inhalt ankommt. Sie ist unsichtbar, bis sie den Fokus bekommt.
    */
    }
    <a class="sprungmarke" href="#inhalt">Zum Hauptinhalt springen</a>
    <SiteHeader market={market} brandName={site.brandName} aktuellerPfad={Astro.url.pathname} />
    {
      build.mode === 'preview' && (
        <div class="preview-bar">
          Vorschau · Echte Daten, ohne Werbung. Kosten- und Reiseregeln noch ohne Fachfreigabe.
        </div>
      )
    }
    {
      build.showTestDataBanner && (
        <div class:list={['randbreite', weit ? 'page-container' : 'reading-container']}>
          <Notice variante="testdaten" titel="Technische Vorschau" testId="test-data-banner">
            {bestand.echt.length > 0 && (
              <p>
                <strong>Echte Daten:</strong> {aufzaehlung(bestand.echt)}. Quelle und Datenstand
                stehen an jeder Angabe.
              </p>
            )}
            {bestand.ungeprueft.length > 0 && (
              <p>
                <strong>Echt, aber ungeprüft:</strong> {aufzaehlung(bestand.ungeprueft)}. Verlassen
                Sie sich nicht auf die Ergebnisse.
              </p>
            )}
            {bestand.synthetisch.length > 0 && (
              <p>
                <strong>Erfunden:</strong> {aufzaehlung(bestand.synthetisch)}. Diese Seiten zeigen
                Platzhalter, bis echte Angaben belegt sind.
              </p>
            )}
            <p>
              Dies ist eine technische Vorschau: nicht indexierbar, ohne Betreiberangaben und ohne
              öffentliche Freigabe.
            </p>
          </Notice>
        </div>
      )
    }
    <main id="inhalt" tabindex="-1" class:list={[weit ? 'page-container' : 'reading-container']}>
      <slot />
    </main>
    <SiteFooter market={market} betreiber={site.operator.legalName} />
  </body>
</html>

<style>
  /*
   * Abschnitt 39.2: erstes fokussierbares Element. Sie liegt außerhalb des
   * Sichtfelds statt `display: none` — sonst wäre sie auch für die Tastatur
   * weg — und springt hinein, sobald sie den Fokus bekommt.
   */
  .sprungmarke {
    position: absolute;
    inset-inline-start: var(--space-3);
    inset-block-start: var(--space-3);
    z-index: 200;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-md);
    color: var(--color-primary-hover);
    font-weight: var(--weight-label);
    text-decoration: none;
    transform: translateY(-250%);
  }

  .sprungmarke:focus {
    transform: translateY(0);
  }

  /* Der Sprung darf keinen Fokusring an den Inhaltsbereich hängen. */
  main:focus {
    outline: none;
  }

  .randbreite {
    padding-block-start: var(--space-6);
  }
  .preview-bar {
    background: var(--color-brand-050);
    color: var(--color-primary-hover);
    padding: var(--space-2) var(--space-4);
    text-align: center;
    font-size: 0.875rem;
    border-bottom: 1px solid var(--color-border);
  }
</style>
