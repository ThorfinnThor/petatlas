---
/**
 * M04-02 — Kopfbereich mit Hauptnavigation.
 *
 * Die Navigation kommt aus der Route Registry. Sie enthält deshalb nur
 * Seiten, die im aktuellen Markt tatsächlich existieren.
 */
import type { MarketConfig } from '../domain/market.ts';
import { translate, type LocaleId } from '../domain/i18n.ts';
import { navigationFor, routePath } from '../lib/routes.ts';

interface Props {
  market: MarketConfig;
  brandName: string;
  aktuellerPfad?: string;
}

const { market, brandName, aktuellerPfad } = Astro.props;
const locale = market.locale as LocaleId;
const eintraege = navigationFor(market, 'main').filter((item) => item.key !== 'home');
---

<header class="kopf">
  <div class="kopf__inhalt page-container">
    <a class="kopf__marke" href={routePath(market, 'home')}>{brandName}</a>
    {
      eintraege.length > 0 && (
        <>
          {/*
            Abschnitt 9.2: auf dem Telefon ein Menüknopf statt einer über
            mehrere Zeilen umbrechenden Linkliste. Der Knopf ist zunächst
            versteckt und wird erst vom Skript eingeblendet — ohne
            JavaScript bleibt die vollständige Liste sichtbar, statt dass
            ein toter Knopf dasteht.
          */}
          <button
            id="menue-knopf"
            class="kopf__menueknopf"
            type="button"
            aria-expanded="false"
            aria-controls="hauptnavigation"
            hidden
          >
            Menü
          </button>
          <nav aria-label="Hauptnavigation" class="kopf__nav" id="hauptnavigation">
            <ul class="kopf__liste">
              {eintraege.map((item) => (
                <li>
                  <a
                    href={item.path}
                    aria-current={item.path === aktuellerPfad ? 'page' : undefined}
                  >
                    {translate(locale, item.labelKey)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </>
      )
    }
  </div>
</header>

<script>
  import { menueStarten } from '../features/navigation/mobile-menu.ts';

  menueStarten();
</script>

<style>
  /*
   * Abschnitt 9.1 und 9.2: weißer Kopf mit unterer Kante, Wortmarke links,
   * Navigation daneben. 64 px mobil, 72 px ab Tablet. Sticky, damit die
   * Navigation auf langen Toolseiten erreichbar bleibt — und mit einem
   * z-index unterhalb von Dialogen.
   */
  .kopf {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    background: var(--color-surface);
    border-block-end: 1px solid var(--color-border);
  }

  .kopf__inhalt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    min-block-size: var(--header-height-mobile);
    padding-block: var(--space-2);
  }

  @media (min-width: 768px) {
    .kopf__inhalt {
      min-block-size: var(--header-height-desktop);
      flex-wrap: nowrap;
    }
  }

  /* Abschnitt 8.4: schlichte Wortmarke, kein Emoji, kein Bild. */
  .kopf__marke {
    font-size: var(--text-h4);
    font-weight: var(--weight-h2);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .kopf__nav {
    /* Abschnitt 54: Navlabels bekommen keine feste Breite. */
    min-inline-size: 0;
  }

  /*
   * Abschnitt 9.2: der Menüknopf gilt nur bis zum Tablet. Er ist mindestens
   * 44 px hoch (Abschnitt 39.4) und sagt über `aria-expanded`, in welchem
   * Zustand er ist.
   */
  .kopf__menueknopf {
    margin-inline-start: auto;
    min-block-size: 44px;
    padding-inline: var(--space-4);
  }

  @media (min-width: 768px) {
    .kopf__menueknopf {
      display: none;
    }
  }

  /* Eingeklappt nur dort, wo der Knopf sichtbar ist. */
  @media (max-width: 767px) {
    .kopf__nav[data-eingeklappt='true'] {
      display: none;
    }

    .kopf__nav {
      flex-basis: 100%;
      padding-block-end: var(--space-2);
    }

    .kopf__liste {
      flex-direction: column;
      align-items: stretch;
    }

    .kopf__liste a {
      display: block;
      padding: var(--space-3);
      border-block-end: 1px solid var(--color-border);
      border-radius: 0;
    }

    .kopf__liste [aria-current='page'] {
      border-inline-start: 3px solid var(--color-primary);
      border-block-end-color: var(--color-border);
      padding-inline-start: var(--space-3);
      background: var(--color-primary-soft);
    }
  }

  .kopf__liste {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .kopf__liste li {
    margin: 0;
    max-inline-size: none;
  }

  .kopf__liste a {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    border-block-end: 2px solid transparent;
    color: var(--color-text);
    font-size: var(--text-small);
    text-decoration: none;
  }

  .kopf__liste a:hover {
    color: var(--color-primary-hover);
    border-block-end-color: var(--color-border-strong);
  }

  /*
   * Abschnitt 9.1: der aktive Bereich wird über Textfarbe **und** eine
   * 2-px-Kante angezeigt, nicht allein über eine Hintergrundfarbe.
   */
  .kopf__liste [aria-current='page'] {
    color: var(--color-primary-hover);
    font-weight: var(--weight-label);
    border-block-end-color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .kopf__liste {
      margin-inline-start: auto;
    }
  }
</style>
