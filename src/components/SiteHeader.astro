---
import type { MarketConfig } from '../domain/market.ts';
import { translate, type LocaleId } from '../domain/i18n.ts';
import { routeExists, routePath, type RouteKey } from '../lib/routes.ts';
import Icon from './ui/Icon.astro';
interface Props {
  market: MarketConfig;
  brandName: string;
  aktuellerPfad?: string;
}
const { market, brandName, aktuellerPfad } = Astro.props;
const home = routePath(market, 'home');
const groups: { label: string; keys: RouteKey[] }[] = [
  { label: 'Tools', keys: ['costs', 'travel', 'map'] },
  { label: 'Produkte', keys: ['food', 'toys', 'care', 'catalog'] },
  { label: 'Wissen', keys: ['method', 'sources', 'dataStatus'] },
];
---

<header class="kopf">
  <div class="kopf__inhalt page-container">
    <a class="kopf__marke" href={home} aria-label={brandName}
      ><Icon name="paw" size={30} /><span>{brandName}<small>Gute Hunde. Gute Tage.</small></span></a
    >
    <a class="kopf__suche" href={`${home}#suche-titel`} aria-label="Suche öffnen"
      ><Icon name="search" /></a
    >
    <button
      id="menue-knopf"
      class="kopf__menueknopf"
      type="button"
      aria-expanded="false"
      aria-controls="hauptnavigation"
      hidden>Menü <span aria-hidden="true">☰</span></button
    >
    <nav aria-label="Hauptnavigation" class="kopf__nav" id="hauptnavigation">
      <ul class="kopf__liste">
        {
          groups
            .slice(0, 1)
            .filter((group) => group.keys.some((key) => routeExists(market, key)))
            .map((group) => (
              <li>
                <details>
                  <>
                    <summary>
                      {group.label} <span aria-hidden="true">⌄</span>
                    </summary>
                    <ul>
                      {group.keys
                        .filter((k) => routeExists(market, k))
                        .map((key) => (
                          <li>
                            <a
                              href={routePath(market, key)}
                              aria-current={
                                routePath(market, key) === aktuellerPfad ? 'page' : undefined
                              }
                            >
                              {translate(market.locale as LocaleId, `nav.${key}`)}
                            </a>
                          </li>
                        ))}
                    </ul>
                  </>
                </details>
              </li>
            ))
        }
        <li><a href={`${home}#ratgeber`}>Ratgeber</a></li>
        {
          routeExists(market, 'map') && (
            <li>
              <a href={routePath(market, 'map')}>Karte</a>
            </li>
          )
        }
        {
          groups
            .slice(1)
            .filter((group) => group.keys.some((key) => routeExists(market, key)))
            .map((group) => (
              <li>
                <details>
                  <>
                    <summary>
                      {group.label} <span aria-hidden="true">⌄</span>
                    </summary>
                    <ul>
                      {group.keys
                        .filter((k) => routeExists(market, k))
                        .map((key) => (
                          <li>
                            <a
                              href={routePath(market, key)}
                              aria-current={
                                routePath(market, key) === aktuellerPfad ? 'page' : undefined
                              }
                            >
                              {translate(market.locale as LocaleId, `nav.${key}`)}
                            </a>
                          </li>
                        ))}
                    </ul>
                  </>
                </details>
              </li>
            ))
        }
        {
          routeExists(market, 'favorites') && (
            <li>
              <a class="kopf__save" href={routePath(market, 'favorites')} aria-label="Merkliste">
                <Icon name="save" />
              </a>
            </li>
          )
        }
        {
          routeExists(market, 'profile') && (
            <li>
              <a class="kopf__profil" href={routePath(market, 'profile')}>
                <Icon name="user" size={18} />
                Mein Hund
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>
<script>
  import { menueStarten } from '../features/navigation/mobile-menu.ts';
  menueStarten();
  document.querySelectorAll('.kopf details').forEach((detail) => {
    detail.addEventListener('toggle', () => {
      if ((detail as HTMLDetailsElement).open)
        document.querySelectorAll('.kopf details').forEach((other) => {
          if (other !== detail) (other as HTMLDetailsElement).open = false;
        });
    });
    detail.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key === 'Escape') {
        (detail as HTMLDetailsElement).open = false;
        detail.querySelector('summary')?.focus();
      }
    });
  });
</script>
<style>
  .kopf {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .kopf__inhalt {
    min-height: 76px;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .kopf__marke {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-brand-900);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .kopf__marke small {
    display: block;
    font-size: 0.625rem;
    letter-spacing: 0.025em;
    font-weight: 500;
    margin-top: -0.2rem;
  }
  .kopf__nav {
    margin-left: auto;
  }
  .kopf__liste {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .kopf li {
    margin: 0;
  }
  .kopf a,
  .kopf summary {
    font-weight: 650;
  }
  .kopf__liste > li > a,
  summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-ink);
    min-height: 44px;
    font-size: 0.875rem;
    cursor: pointer;
  }
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details {
    position: relative;
  }
  details ul {
    list-style: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    padding: var(--space-3);
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }
  details a {
    display: block;
    padding: var(--space-3);
    font-size: 0.875rem;
    text-decoration: none;
  }
  details a:hover {
    background: var(--color-primary-soft);
    border-radius: var(--radius-sm);
  }
  .kopf__liste > li > a.kopf__profil {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    padding: 0 var(--space-5);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .kopf__suche {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    color: var(--color-primary);
  }
  .kopf__menueknopf {
    display: none;
  }
  @media (max-width: 1023px) {
    .kopf__inhalt {
      flex-wrap: wrap;
      gap: var(--space-2);
      min-height: 68px;
      padding-block: var(--space-2);
    }
    .kopf__marke {
      font-size: 1.375rem;
    }
    .kopf__menueknopf:not([hidden]) {
      display: flex;
      gap: var(--space-2);
      align-items: center;
    }
    .kopf__nav {
      width: 100%;
      margin: 0;
      max-height: calc(100dvh - 90px);
      overflow: auto;
    }
    .kopf__nav[data-eingeklappt='true'] {
      display: none;
    }
    .kopf__liste {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-4) 0;
      gap: var(--space-2);
    }
    .kopf__liste > li > a,
    summary {
      padding: var(--space-2) var(--space-3);
      font-size: 1rem;
    }
    .kopf details ul {
      position: static;
      box-shadow: none;
      border: 0;
      padding-block: 0;
    }
    .kopf__profil {
      justify-content: center;
    }
    .kopf__save {
      justify-content: center;
    }
  }
</style>
