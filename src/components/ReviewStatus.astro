---
/**
 * Maschinenlesbarer Freigabestand für die internen Veröffentlichungsprüfungen.
 *
 * Die früher sichtbare Infobox wiederholte Datenstände, Verantwortliche und
 * Freigabedaten auf jeder sensiblen Seite. Diese Angaben bleiben als
 * technische Metadaten erhalten, während Quellen und fachliche Grenzen dort
 * stehen, wo sie den jeweiligen Inhalt erklären.
 */

type Status = 'draft' | 'pending' | 'approved';

interface SourceLink {
  readonly label: string;
  readonly url: string;
}

interface Props {
  status: Status;
  lastVerifiedAt: string | null;
  reviewedBy?: string | null;
  reviewedAt?: string | null;
  responsibility: string;
  sources: readonly SourceLink[];
  locale?: string;
  compact?: boolean;
}

const {
  status,
  lastVerifiedAt,
  reviewedBy = null,
  reviewedAt = null,
  responsibility,
  sources,
} = Astro.props;

if (status === 'approved' && (!reviewedBy?.trim() || !reviewedAt?.trim())) {
  throw new Error('Ein fachlich freigegebener Inhalt braucht reviewedBy und reviewedAt.');
}
---

<span
  hidden
  aria-hidden="true"
  data-review-status={status}
  data-last-verified-at={lastVerifiedAt ?? 'unknown'}
  data-review-approved-by={status === 'approved' ? reviewedBy : undefined}
  data-review-responsibility={status === 'approved' ? reviewedBy : responsibility}
  data-reviewed-at={status === 'approved' ? reviewedAt : undefined}
  data-review-source-count={sources.length}></span>
{
  sources.length > 0 && (
    <p class="review-sources">
      Quelle:{' '}
      {sources.map((source, index) => (
        <>
          {index > 0 && <span aria-hidden="true"> · </span>}
          <a href={source.url} rel="noopener">
            {source.label}
          </a>
        </>
      ))}
    </p>
  )
}

<style>
  .review-sources {
    margin-block: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
</style>
