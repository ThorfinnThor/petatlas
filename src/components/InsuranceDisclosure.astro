---
/**
 * M09-02/M09-04 — Was ein Versicherungshinweis hier ist, und was er nicht ist.
 *
 * Dieser Baustein steht **vor** jedem Partnerhinweis und erscheint auch dann,
 * wenn es gar keinen Partner gibt. Denn die wichtigere Aussage ist die zweite:
 * hier wird nicht beraten, nicht verglichen und nichts empfohlen.
 *
 * Ohne zugelassenes Programm steht hier ausdrücklich, dass es keinen Partner
 * gibt — statt einer leeren Fläche, die aussieht, als sei etwas kaputt.
 *
 * Die Texte selbst stehen in `content-data/insurance-disclosures/`. Sie sind
 * redaktionell und gelten auch ohne Partner; deshalb liegen sie nicht in
 * dieser Datei und nicht in der Partnerkonfiguration.
 */
import type { PartnerPlacement, PartnerProgram } from '../domain/schemas/partner.ts';
import { werbekennzeichnung } from '../features/commerce/partner.ts';
import { disclosuresFor } from '../features/commerce/disclosures.ts';

interface Props {
  /** Das zugelassene Programm oder `null`, wenn es keines gibt. */
  programm: PartnerProgram | null;
  /** Stelle, an der die Offenlegung steht. */
  placement?: PartnerPlacement;
}

const { programm, placement = 'information_page' } = Astro.props;
const kennzeichnung = werbekennzeichnung(programm);
// Die Texte stehen in content-data, nicht in dieser Datei: sie sind
// redaktionell und werden ohne Codeänderung gepflegt.
const texte = disclosuresFor(placement, programm !== null);
---

<section
  class="offenlegung"
  aria-labelledby="offenlegung-titel"
  data-testid="versicherung-offenlegung"
>
  <h2 id="offenlegung-titel">Was auf dieser Seite steht — und was nicht</h2>

  {
    kennzeichnung !== null && (
      <p class="offenlegung__kennzeichnung" data-testid="werbekennzeichnung">
        {kennzeichnung}
      </p>
    )
  }

  <ul>
    {
      texte.map((text) => (
        <li data-testid={`hinweis-${text.disclosureId}`}>
          <strong>{text.heading}.</strong> {text.paragraphs.join(' ')}
        </li>
      ))
    }
    {
      programm === null ? (
        <li data-testid="kein-partner">
          <strong>Derzeit kein Partner.</strong> Es besteht kein Vertrag mit einem
          Versicherungsanbieter. Deshalb steht hier kein Anbieterlink — nicht, weil gerade etwas
          fehlschlägt.
        </li>
      ) : (
        <li>
          <strong>Bezahlte Weiterleitung.</strong> Der Anbieterlink ist bezahlt. Er ist als solcher
          gekennzeichnet, führt direkt zum Anbieter und überträgt nichts, was Sie hier eingegeben
          haben.
        </li>
      )
    }
  </ul>

  {
    programm !== null && programm.restrictions.length > 0 && (
      <>
        <h3>Auflagen aus dem Vertrag</h3>
        <ul>
          {programm.restrictions.map((auflage) => (
            <li>{auflage}</li>
          ))}
        </ul>
      </>
    )
  }
</section>

<style>
  .offenlegung {
    border: var(--linie) solid var(--farbe-linie);
    border-radius: var(--radius);
    padding: var(--abstand-4);
    margin-block: var(--abstand-6);
  }

  .offenlegung h2 {
    margin-top: 0;
    font-size: var(--schrift-normal);
  }

  .offenlegung__kennzeichnung {
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: var(--schrift-klein);
  }
</style>
