---
/**
 * Fußbereich nach `docs/DESIGN_SPECIFICATIONS.md` Abschnitt 10.
 *
 * Funktional, nicht werblich: vier Gruppen und eine Unterkante. Keine
 * Social-Media-Symbole, solange es keine betriebenen Kanäle gibt.
 *
 * Die Gruppen entstehen aus der Route Registry. Eine Funktion, die es im
 * Markt nicht gibt, taucht hier nicht auf — der Fuß verlinkt nichts Leeres.
 */
import type { MarketConfig } from '../domain/market.ts';
import { translate, type LocaleId } from '../domain/i18n.ts';
import { navigationFor, type NavigationItem, type RouteKey } from '../lib/routes.ts';

interface Props {
  market: MarketConfig;
  betreiber: string | null;
}

const { market, betreiber } = Astro.props;
const locale = market.locale as LocaleId;

const alle = [...navigationFor(market, 'main'), ...navigationFor(market, 'footer')];

function gruppe(keys: readonly RouteKey[]): readonly NavigationItem[] {
  return keys
    .map((key) => alle.find((eintrag) => eintrag.key === key))
    .filter((eintrag): eintrag is NavigationItem => eintrag !== undefined);
}

const werkzeuge = gruppe(['costs', 'map', 'travel']);
const produkte = gruppe(['care', 'toys', 'food', 'catalog']);
const transparenz = gruppe([
  'sources',
  'dataStatus',
  'method',
  'privacy',
  'imprint',
  'accessibility',
]);
const jahr = new Date().getFullYear();

const SPALTEN = [
  { titel: 'Werkzeuge', eintraege: werkzeuge },
  { titel: 'Produkte', eintraege: produkte },
  { titel: 'Transparenz', eintraege: transparenz },
].filter((spalte) => spalte.eintraege.length > 0);
---

<footer class="fuss">
  <div class="fuss__inhalt page-container">
    <div class="fuss__raster">
      <div class="fuss__marke">
        <p class="fuss__name">PetAtlas</p>
        <p class="fuss__satz">
          Daten aus offenen Quellen, mit Stand und Herkunft an jeder Angabe. Ohne Konto, ohne
          Tracking.
        </p>
      </div>

      {
        SPALTEN.map((spalte) => (
          <nav aria-label={spalte.titel}>
            <p class="fuss__titel">{spalte.titel}</p>
            <ul class="fuss__liste">
              {spalte.eintraege.map((item) => (
                <li>
                  <a href={item.path}>{translate(locale, item.labelKey)}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="fuss__unterkante">
      © {jahr} PetAtlas · Datenstände je Werkzeug können abweichen ·{' '}
      {betreiber ?? 'Betreiberangaben liegen noch nicht vor.'}
    </p>
  </div>
</footer>

<style>
  .fuss {
    border-block-start: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .fuss__inhalt {
    padding-block: var(--space-12);
  }

  .fuss__raster {
    display: grid;
    gap: var(--space-8);
  }

  /* Abschnitt 10: vier Spalten auf dem Desktop, eine auf dem Telefon. */
  @media (min-width: 768px) {
    .fuss__raster {
      grid-template-columns: 1.4fr repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  .fuss__name {
    margin: 0 0 var(--space-2);
    color: var(--color-ink);
    font-size: var(--text-h4);
    font-weight: var(--weight-h2);
  }

  .fuss__satz {
    margin: 0;
    max-inline-size: 34ch;
  }

  .fuss__titel {
    margin: 0 0 var(--space-3);
    color: var(--color-ink);
    font-size: var(--text-micro);
    font-weight: var(--weight-label);
    text-transform: none;
  }

  .fuss__liste {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fuss__liste li {
    margin-block: var(--space-2);
    max-inline-size: none;
  }

  .fuss__liste a {
    color: var(--color-text);
    text-decoration-color: var(--color-border-strong);
  }

  .fuss__liste a:hover {
    color: var(--color-primary-hover);
    text-decoration-color: currentcolor;
  }

  .fuss__unterkante {
    margin: var(--space-10) 0 0;
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
    max-inline-size: none;
    font-size: var(--text-micro);
  }
</style>
