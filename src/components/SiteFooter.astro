---
/**
 * M04-02 — Fußbereich.
 *
 * Enthält Quellen, Datenstand und rechtliche Seiten. Solange keine echten
 * Betreiberangaben vorliegen, steht hier kein erfundener Name.
 */
import type { MarketConfig } from '../domain/market.ts';
import { translate, type LocaleId } from '../domain/i18n.ts';
import { navigationFor } from '../lib/routes.ts';

interface Props {
  market: MarketConfig;
  betreiber: string | null;
}

const { market, betreiber } = Astro.props;
const locale = market.locale as LocaleId;
const eintraege = navigationFor(market, 'footer');
---

<footer class="fuss">
  <nav aria-label="Rechtliches und Quellen">
    <ul class="fuss__liste">
      {
        eintraege.map((item) => (
          <li>
            <a href={item.path}>{translate(locale, item.labelKey)}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="fuss__betreiber">
    {betreiber ?? 'Betreiberangaben liegen noch nicht vor.'}
  </p>
</footer>

<style>
  .fuss {
    border-top: var(--linie) solid var(--farbe-linie);
    margin-top: var(--abstand-8);
    padding-block: var(--abstand-4);
    color: var(--farbe-text-leise);
    font-size: var(--schrift-klein);
  }

  .fuss__liste {
    display: flex;
    flex-wrap: wrap;
    gap: var(--abstand-2) var(--abstand-4);
    list-style: none;
    margin: 0 0 var(--abstand-2);
    padding: 0;
  }

  .fuss__betreiber {
    margin: 0;
  }
</style>
