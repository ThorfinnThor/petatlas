---
import { hansemerkurVersicherungsprodukte } from '../features/commerce/insurance-catalog.ts';
const produkte = hansemerkurVersicherungsprodukte();

const typLabel: Record<(typeof produkte)[number]['productType'], string> = {
  health: 'Krankenversicherung',
  op: 'OP-Versicherung',
  liability: 'Haftpflicht',
};
const tierLabel = (species: 'dog' | 'cat') => (species === 'dog' ? 'Für Hunde' : 'Für Katzen');
---

<section class="insurance-products" aria-labelledby="insurance-products-title">
  <div class="insurance-products__intro">
    <h3 id="insurance-products-title">Welche Versicherungsarten HanseMerkur führt</h3>
    <p>
      Diese Übersicht nennt die Produktarten, die HanseMerkur für Hunde und Katzen führt. Sie ist
      kein Tarifvergleich und enthält keine Preis- oder Leistungsbewertung.
    </p>
  </div>
  <ul class="insurance-products__grid">
    {
      produkte.map((produkt) => {
        return (
          <li class="insurance-products__card">
            <p class="insurance-products__species">{tierLabel(produkt.species)}</p>
            <p class="insurance-products__type">{typLabel[produkt.productType]}</p>
            <h3>{produkt.name}</h3>
            <p>{produkt.summary}</p>
            <p class="insurance-products__source">
              <a
                href={produkt.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${produkt.name} bei HanseMerkur ansehen (öffnet ein neues Fenster)`}
              >
                Bei HanseMerkur ansehen ↗
              </a>
            </p>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .insurance-products {
    margin-block: var(--space-7);
    min-inline-size: 0;
  }

  .insurance-products__intro {
    max-width: 48rem;
  }

  .insurance-products__intro h3 {
    margin-block: var(--space-2) var(--space-3);
  }

  .insurance-products__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding: 0;
    margin: var(--space-5) 0 0;
    list-style: none;
  }

  .insurance-products__card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    min-inline-size: 0;
  }

  .insurance-products__card h3 {
    margin-block: var(--space-2);
    max-inline-size: 100%;
    font-size: clamp(1.05rem, 5.25vw, 1.2rem);
    text-wrap: pretty;
  }

  .insurance-products__card p {
    margin-block: var(--space-2);
  }

  .insurance-products__species,
  .insurance-products__type {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .insurance-products__species {
    margin: 0;
    font-weight: 700;
  }

  .insurance-products__source {
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--text-small);
  }

  .insurance-products__source a {
    white-space: nowrap;
  }

  /* Höchstens drei Spalten: lange Wörter wie „Hundekrankenversicherung“ brauchen Platz. */
  @media (min-width: 640px) {
    .insurance-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .insurance-products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
