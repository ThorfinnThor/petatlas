---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

import type { EditorialSource } from '../../domain/editorial-sources.ts';
import type { RouteKey } from '../../lib/routes.ts';
import BrandImage from '../BrandImage.astro';
import CatCarrierGuide from './CatCarrierGuide.astro';
import CatEnrichmentGuide from './CatEnrichmentGuide.astro';

interface RelatedArticle {
  readonly href: string;
  readonly title: string;
}

interface ToolLink {
  readonly key: RouteKey;
  readonly label: string;
  readonly path: string;
}

interface Props {
  article: CollectionEntry<'ratgeber'>;
  Content: AstroComponentFactory;
  headings: readonly MarkdownHeading[];
  sources: readonly EditorialSource[];
  relatedArticles: readonly RelatedArticle[];
  toolLinks: readonly ToolLink[];
}

const { article, Content, headings, sources, relatedArticles, toolLinks } = Astro.props;
const data = article.data;
const publicationApproved = data.status === 'published';
const mainHeadings = headings.filter((heading) => heading.depth === 2);
const formatDate = (date: string): string =>
  new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(
    new Date(`${date}T00:00:00Z`),
  );
---

<article
  class:list={['editorial-article', data.legacyRenderer && 'editorial-article--legacy']}
  data-review-status={publicationApproved ? 'approved' : 'pending'}
  data-last-verified-at={data.updatedAt}
  data-review-responsibility={publicationApproved
    ? 'SeitenHafen361'
    : 'Redaktionelle Prüfung offen'}
>
  <p class="article-meta">
    {data.status === 'published' ? 'Veröffentlicht am' : 'Entwurf vom'}{' '}
    <time datetime={data.publishedAt}>{formatDate(data.publishedAt)}</time>
    {
      data.updatedAt !== data.publishedAt && (
        <>
          <span aria-hidden="true">·</span>
          Aktualisiert am <time datetime={data.updatedAt}>{formatDate(data.updatedAt)}</time>
        </>
      )
    }
  </p>

  {
    data.legacyRenderer === 'cat-enrichment' ? (
      <CatEnrichmentGuide />
    ) : data.legacyRenderer === 'cat-carrier' ? (
      <CatCarrierGuide />
    ) : (
      <>
        <header class="article-header">
          <p class="eyebrow">{data.topicCluster}</p>
          <h1>{data.title}</h1>
          <p class="article-intro">{data.intro}</p>
          {data.image && (
            <BrandImage name={data.image} alt="" sizes="(max-width: 759px) 100vw, 760px" priority />
          )}
        </header>

        {mainHeadings.length > 1 && (
          <nav class="article-toc" aria-label="Inhalt dieses Artikels">
            <strong>Auf dieser Seite</strong>
            <ol>
              {mainHeadings.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="article-body">
          <Content />
        </div>
      </>
    )
  }

  <section class="article-sources" aria-labelledby="article-sources-title">
    <h2 id="article-sources-title">Quellen und Einordnung</h2>
    <p>
      Stand: <time datetime={data.updatedAt}>{formatDate(data.updatedAt)}</time>. Die Aussagen
      wurden aus den folgenden Quellen und den im Projekt genannten Datengrundlagen abgeleitet.
      Herstellerangaben bleiben dem jeweiligen Hersteller zugeordnet.
    </p>
    <ul>
      {
        sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener">
              {source.publisher}: {source.title} ↗
            </a>
            <span>{source.version}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    (toolLinks.length > 0 || relatedArticles.length > 0) && (
      <section class="article-related" aria-labelledby="article-related-title">
        <h2 id="article-related-title">Passend dazu</h2>
        <div class="related-grid">
          {toolLinks.map((tool) => (
            <a href={tool.path}>
              <span>Werkzeug</span>
              <strong>{tool.label}</strong>
            </a>
          ))}
          {relatedArticles.map((related) => (
            <a href={related.href}>
              <span>Ratgeber</span>
              <strong>{related.title}</strong>
            </a>
          ))}
        </div>
      </section>
    )
  }
</article>

<style>
  .editorial-article {
    --article-measure: 72ch;
    margin-block-end: var(--space-12);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin-block: var(--space-3) var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .article-header {
    margin-block-end: var(--space-7);
  }

  .article-header h1 {
    max-inline-size: 18ch;
    overflow-wrap: normal;
    hyphens: auto;
  }

  .article-intro {
    max-inline-size: 62ch;
    color: var(--color-text-muted);
    font-size: var(--text-lead);
  }

  .article-header :global(picture) {
    display: block;
    max-inline-size: var(--article-measure);
    margin-block-start: var(--space-6);
    border-radius: var(--radius-xl);
    overflow: clip;
    aspect-ratio: 16 / 8;
  }

  .article-header :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .article-toc {
    max-inline-size: var(--article-measure);
    margin-block: var(--space-6) var(--space-9);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-subtle);
  }

  .article-toc ol {
    margin-block-end: 0;
    padding-inline-start: 1.25rem;
    columns: 2 16rem;
  }

  .article-toc li {
    break-inside: avoid;
    margin-block: var(--space-2);
  }

  .article-body {
    max-inline-size: var(--article-measure);
  }

  .article-body :global(h2) {
    margin-block-start: var(--space-10);
    scroll-margin-block-start: 7rem;
  }

  .article-body :global(h3) {
    margin-block-start: var(--space-7);
  }

  .article-body :global(p),
  .article-body :global(li) {
    max-inline-size: 70ch;
  }

  .article-sources,
  .article-related {
    max-inline-size: var(--article-measure);
    margin-block-start: var(--space-10);
    padding-block-start: var(--space-7);
    border-block-start: 1px solid var(--color-border);
  }

  .article-sources li {
    margin-block: var(--space-3);
  }

  .article-sources li span {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .related-grid {
    display: grid;
    gap: var(--space-3);
  }

  .related-grid a {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    text-decoration: none;
  }

  .related-grid a:hover {
    border-color: var(--color-primary);
    background: var(--color-brand-050);
  }

  .related-grid span {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .article-header h1 {
      font-size: clamp(2rem, 10vw, 3rem);
      overflow-wrap: break-word;
    }

    .article-toc ol {
      columns: 1;
    }
  }

  /* Kostentabellen mit mehreren Betragsspalten sind auf schmalen Handys breiter
     als der Bildschirm. Dann scrollt nur die Tabelle, nie die Seite; Beträge
     brechen nicht zwischen Zahl und Euro-Zeichen um. */
  .article-body :global(table) {
    display: block;
    max-inline-size: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .article-body :global(.tabelle-scroll) {
    max-inline-size: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .article-body :global(table.im-scrollbereich) {
    display: table;
    overflow: visible;
  }

  .article-body :global(td),
  .article-body :global(th) {
    white-space: nowrap;
  }

  /* Die Leistungsbeschreibung steht in Tabellen mit vier Spalten an zweiter
     Stelle; in Rechenbeispielen mit drei Spalten an erster. Nur diese Spalte
     darf umbrechen. */
  .article-body :global(table:has(tr > :nth-child(4)) td:nth-child(2)),
  .article-body :global(table:has(tr > :nth-child(4)) th:nth-child(2)),
  .article-body :global(table:not(:has(tr > :nth-child(4))) td:first-child) {
    min-inline-size: 9rem;
    white-space: normal;
  }

  .article-body :global(.tabelle-hinweis) {
    margin-block: var(--space-1) 0;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  @media (max-width: 639px) {
    .article-body :global(table.tabelle-gestapelt) {
      position: relative;
      display: block;
      overflow: clip;
      font-size: var(--text-body);
    }

    .article-body :global(.tabelle-gestapelt thead),
    .article-body :global(.tabelle-gestapelt thead tr),
    .article-body :global(.tabelle-gestapelt tbody) {
      display: block;
    }

    /* Überschriften bleiben für Screenreader da, sichtbar stehen sie als
       Beschriftung an jedem Betrag. */
    .article-body :global(.tabelle-gestapelt th) {
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 0;
      inline-size: 1px;
      block-size: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .article-body :global(.tabelle-gestapelt tbody tr) {
      display: flex;
      flex-wrap: wrap;
      row-gap: var(--space-1);
      padding-block: var(--space-3);
      border-block-end: 1px solid var(--color-border);
    }

    .article-body :global(.tabelle-gestapelt td) {
      display: block;
      min-inline-size: 0;
      padding: 0;
      border: 0;
      white-space: normal;
      text-align: start;
    }

    /* Nummer und Leistung füllen zusammen genau eine Zeile, damit die Beträge
       immer darunter beginnen. */
    .article-body :global(.tabelle-gestapelt td.nummer) {
      flex: 0 0 4.5rem;
      color: var(--color-text-muted);
    }

    .article-body :global(.tabelle-gestapelt td.nummer::before) {
      content: 'Nr. ';
    }

    .article-body :global(.tabelle-gestapelt td.titel) {
      flex: 1 1 100%;
      font-weight: 600;
    }

    .article-body :global(.tabelle-gestapelt td.nummer + td.titel) {
      flex-basis: calc(100% - 4.5rem);
    }

    .article-body :global(.tabelle-gestapelt td.wert) {
      flex: 1 1 0;
      padding-inline-end: var(--space-3);
      font-variant-numeric: tabular-nums;
    }

    /* Ab vier Beträgen je Zeile stehen je zwei nebeneinander, damit die
       Beschriftungen nicht mitten im Wort umbrechen. */
    .article-body
      :global(.tabelle-gestapelt tr:has(> td.wert ~ td.wert ~ td.wert ~ td.wert) td.wert) {
      flex-basis: 40%;
    }

    .article-body :global(.tabelle-gestapelt td.wert:last-child) {
      padding-inline-end: 0;
    }

    .article-body :global(.tabelle-gestapelt td.wert::before) {
      content: attr(data-label);
      display: block;
      color: var(--color-text-muted);
      font-size: var(--text-small);
    }

    .article-body :global(table:not(.tabelle-gestapelt)) {
      font-size: var(--text-small);
    }

    .article-body :global(td),
    .article-body :global(th) {
      padding-inline: var(--space-2);
    }

    .article-body :global(td:first-child),
    .article-body :global(th:first-child) {
      padding-inline-start: 0;
    }

    .article-body :global(td:last-child),
    .article-body :global(th:last-child) {
      padding-inline-end: 0;
    }
  }
</style>

<script>
  // Auf schmalen Handys werden Kostentabellen gestapelt: Leistung oben, Beträge
  // mit ihrer Spaltenüberschrift darunter. Damit die Tabellensemantik bei
  // geänderter Darstellung erhalten bleibt, bekommen Zeilen und Zellen
  // ausdrückliche Rollen. Was danach noch breiter ist als der Bildschirm, liegt
  // in einem benannten, per Tastatur erreichbaren Scrollbereich
  // (axe: scrollable-region-focusable).
  const schmal = window.matchMedia('(max-width: 639px)').matches;
  const istBetrag = (text: string): boolean => /€\s*$/.test(text.trim());

  for (const tabelle of document.querySelectorAll<HTMLTableElement>('.article-body table')) {
    const kopf = tabelle.tHead?.rows[0];
    const spalten = kopf?.cells.length ?? 0;
    const ueberlauf = tabelle.scrollWidth > tabelle.clientWidth + 1;
    // Ab vier Spalten bliebe für die Leistung auf dem Handy auch ohne
    // Überlauf nur eine sehr schmale Spalte.
    if (!ueberlauf && !(schmal && spalten >= 4)) continue;

    const koerper = [...tabelle.tBodies].flatMap((body) => [...body.rows]);
    if (schmal && kopf && koerper.length > 0) {
      const betragsspalten = [...Array(spalten).keys()].filter((index) =>
        koerper.every((zeile) => istBetrag(zeile.cells[index]?.textContent ?? '')),
      );
      if (betragsspalten.length > 0) {
        tabelle.classList.add('tabelle-gestapelt');
        tabelle.setAttribute('role', 'table');
        for (const zeile of tabelle.rows) zeile.setAttribute('role', 'row');
        for (const zelle of kopf.cells) zelle.setAttribute('role', 'columnheader');
        const mitNummer = /nr/i.test(kopf.cells[0]?.textContent ?? '');
        for (const zeile of koerper) {
          [...zeile.cells].forEach((zelle, index) => {
            zelle.setAttribute('role', 'cell');
            if (index === 0 && mitNummer) {
              zelle.classList.add('nummer');
            } else if (index === (mitNummer ? 1 : 0)) {
              zelle.classList.add('titel');
            } else {
              zelle.classList.add('wert');
              zelle.dataset.label = kopf.cells[index]?.textContent?.trim() ?? '';
            }
          });
        }
        continue;
      }
    }
    if (!ueberlauf) continue;

    const bereich = document.createElement('div');
    bereich.className = 'tabelle-scroll';
    bereich.tabIndex = 0;
    bereich.setAttribute('role', 'region');
    bereich.setAttribute('aria-label', 'Tabelle, waagerecht scrollbar');
    tabelle.before(bereich);
    bereich.append(tabelle);
    tabelle.classList.add('im-scrollbereich');
    const hinweis = document.createElement('p');
    hinweis.className = 'tabelle-hinweis';
    hinweis.setAttribute('aria-hidden', 'true');
    hinweis.textContent = 'Tabelle seitlich wischen, um alle Spalten zu sehen.';
    bereich.before(hinweis);
  }
</script>
