---
import AmazonLink from '../AmazonLink.astro';
import { amazonEnabled } from '../../features/commerce/amazon.ts';
import { defaultMarket } from '../../domain/market.ts';
import { routePath } from '../../lib/routes.ts';
import Notice from '../Notice.astro';
import supplements from '../../../content-data/products/supplements.json' with { type: 'json' };
import nutritionReview from '../../../config/reviews/nutrition.json' with { type: 'json' };
import RetailPartnerSection from '../RetailPartnerSection.astro';
import type { MarketConfig } from '../../domain/market.ts';
import { fressnapfAngebot, fressnapfAngebote } from '../../features/commerce/fressnapf-feed.ts';
import { PARTNER_LINK_ATTRIBUTE } from '../../features/commerce/links.ts';
import { zooroyalLink } from '../../features/commerce/zooroyal.ts';
import { zooroyalAngebot } from '../../features/commerce/zooroyal-feed.ts';

interface Props {
  market: MarketConfig;
}

const { market } = Astro.props;
const methodikPfad = routePath(defaultMarket(), 'method');
const fressnapfAvailable = fressnapfAngebote().length > 0;
const zooroyalAvailable = supplements.products.some((product) =>
  zooroyalLink(
    market,
    'ergaenzungsfuttermittel',
    product.species === 'cat' ? 'cat' : 'dog',
    product.id,
  ),
);
---

<p class="eyebrow">Ernährung · Hund und Katze</p>
<h1>Ergänzungsfuttermittel bewusst auswählen</h1>
<p class="lead">
  Was steckt im Produkt, wofür ist es gedacht – und passt es überhaupt zur bisherigen Fütterung?
  Hier ordnen Sie Ergänzungsfuttermittel ein und vergleichen die Kosten einer bereits festgelegten
  Tagesmenge.
</p>

<RetailPartnerSection market={market} page="ergaenzungsfuttermittel" />

<p
  class="review-note"
  data-review-status={nutritionReview.status}
  data-last-verified-at={nutritionReview.reviewedAt}
  data-review-approved-by={nutritionReview.reviewedBy}
>
  Die Seite bestimmt keine Dosierung und ersetzt keine tierärztliche Beratung. Die verwendeten
  Quellen sind bei den jeweiligen Hinweisen verlinkt; mehr zum Prüfverfahren steht in der
  <a href={methodikPfad}>Methodik</a>.
</p>

{
  (amazonEnabled(process.env) || fressnapfAvailable || zooroyalAvailable) && (
    <section class="affiliate-section" aria-labelledby="produkt-ergaenzungen">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Konkrete Produkte</p>
          <h2 id="produkt-ergaenzungen">Ergänzungsfuttermittel bei Händlern ansehen</h2>
        </div>
      </div>
      <p>
        Amazon-Links führen zu einer Produktsuche. Eindeutig zugeordnete Fressnapf-Produkte sind
        zusätzlich direkt verlinkt und verwenden das vom Awin-Feed gelieferte Produktbild. ZooRoyal
        öffnet bei vorhandenem Feed den passenden Artikel, sonst die passende Kategorie. Prüfen Sie
        beim Händler Zusammensetzung, Tierart und Packungsgröße. Die Einordnung stammt aus den
        verlinkten Herstellerangaben und ist keine Empfehlung, eine Ergänzung zu füttern.
      </p>
      <div class="supplement-products">
        {supplements.products.map((product) => {
          const fressnapf = fressnapfAngebot(product.id);
          const zooroyalFeed = zooroyalAngebot(product.id);
          const zooroyal = zooroyalLink(
            market,
            'ergaenzungsfuttermittel',
            product.species === 'cat' ? 'cat' : 'dog',
            product.id,
          );
          const image = fressnapf?.imageUrl ?? zooroyalFeed?.imageUrl ?? product.image;
          return (
            <article class="product-card">
              <figure>
                <img
                  src={image}
                  alt={
                    fressnapf
                      ? `${product.name} bei Fressnapf`
                      : zooroyalFeed
                        ? `${product.name} bei ZooRoyal`
                        : `Symbolbild für ${product.category}, keine Produktabbildung`
                  }
                  width="720"
                  height="720"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  data-feed-image={fressnapf || zooroyalFeed ? '' : undefined}
                  data-fallback-src={fressnapf || zooroyalFeed ? product.image : undefined}
                  data-fallback-alt={
                    fressnapf || zooroyalFeed
                      ? `Symbolbild für ${product.category}, keine Produktabbildung`
                      : undefined
                  }
                />
                <figcaption>
                  {fressnapf
                    ? 'Produktbild · Fressnapf-Feed'
                    : zooroyalFeed
                      ? 'Produktbild · ZooRoyal-Feed'
                      : 'Symbolbild'}
                </figcaption>
              </figure>
              <p class="species-label">{product.species === 'dog' ? 'Für Hunde' : 'Für Katzen'}</p>
              <h3>{product.name}</h3>
              <p class="product-meta">
                {product.brand} · {product.packageSize}
              </p>
              <p class="product-category">Kategorie laut Hersteller: {product.category}</p>
              <a class="source-link" href={product.sourceUrl} rel="noopener noreferrer">
                {product.sourceLabel} ↗
              </a>
              <AmazonLink selection={product.id} label={`${product.name} bei Amazon suchen`} />
              {fressnapf && (
                <p class="fressnapf-link">
                  <a href={fressnapf.affiliateUrl} {...PARTNER_LINK_ATTRIBUTE}>
                    Bei Fressnapf ansehen ↗ <span class="sr-only">(Werbung)</span>
                  </a>
                </p>
              )}
              {zooroyal && !zooroyalFeed && (
                <p class="zooroyal-link">
                  <a href={zooroyal} {...PARTNER_LINK_ATTRIBUTE}>
                    Bei ZooRoyal ansehen ↗ <span class="sr-only">(Werbung)</span>
                  </a>
                </p>
              )}
              {zooroyalFeed && (
                <p class="zooroyal-link">
                  <a href={zooroyalFeed.affiliateUrl} {...PARTNER_LINK_ATTRIBUTE}>
                    {product.name} bei ZooRoyal ansehen ↗ <span class="sr-only">(Werbung)</span>
                  </a>
                </p>
              )}
            </article>
          );
        })}
      </div>
      <p class="affiliate-note">
        Suchergebnisse können abweichende Varianten oder andere Produkte enthalten. Wir zeigen keine
        Preise, Verfügbarkeiten oder Testsiegel.
      </p>
    </section>
  )
}

<Notice variante="hinweis" titel="Zuerst das Grundfutter prüfen">
  <p>
    Ein zur Tierart und Lebensphase passendes Alleinfuttermittel soll den Nährstoffbedarf abdecken.
    Gesunde Hunde und Katzen brauchen dazu in der Regel keine zusätzlichen Vitamin- oder
    Mineralstoffmischungen. Eine selbst zusammengestellte Ration benötigt dagegen eine fachlich
    berechnete Ergänzung. Mehr ist nicht automatisch besser.
  </p>
  <p>
    <a href="https://www.ukpetfood.org/resource/pet-supplements-are-they-necessary.html"
      >Quelle: UK Pet Food, Einordnung von Ergänzungen</a
    > · Branchenverband, keine unabhängige Produktprüfung.
  </p>
</Notice>

<h2>Vier Produktgruppen – vier unterschiedliche Fragen</h2>
<div class="supplement-grid">
  <article>
    <h3>Vitamine und Mineralstoffe</h3><p>
      Passt die Ergänzung zur gesamten Ration? Vor allem bei selbst gekochtem Futter zählt die
      berechnete Gesamtversorgung. Kombinieren Sie nicht mehrere Mischungen nur aufgrund ähnlicher
      Werbeversprechen.
    </p>
  </article>
  <article>
    <h3>Öle und Fettsäuren</h3><p>
      Vergleichen Sie die konkret deklarierten Inhaltsmengen, nicht allein „Fischöl“ oder die
      Flaschengröße. Notieren Sie bei entsprechender Deklaration EPA und DHA je Tagesmenge; die
      benötigte Menge lässt sich daraus nicht automatisch ableiten.
    </p>
  </article>
  <article>
    <h3>Darmprodukte</h3><p>
      Notieren Sie Inhaltsstoffe, gegebenenfalls genaue Mikroorganismen-Stämme, Lagerung und
      Haltbarkeit. Fragen Sie nach Belegen für genau dieses Produkt, die Tierart und den
      vorgesehenen Zweck.
    </p>
  </article>
  <article>
    <h3>Gelenk- und Kombinationsprodukte</h3><p>
      Eine lange Zutatenliste ist kein Wirksamkeitsnachweis. Prüfen Sie Studien zum konkreten
      Produkt und die Mengen der einzelnen Bestandteile. Ergänzungsfuttermittel ersetzen keine
      Abklärung von Schmerzen oder Lahmheit.
    </p>
  </article>
</div>
<p class="hilfe">
  Die Gruppen sind eine Einkaufshilfe, keine Wirksamkeitsrangliste. Grundlage zur Beurteilung von
  Deklaration und Gesamtration: <a
    href="https://wsava.org/global-guidelines/global-nutrition-guidelines/"
    >WSAVA-Ernährungsleitlinien</a
  > und <a href="https://www.fediaf.org/self-regulation/nutritional-guidelines/"
    >FEDIAF-Leitlinien für Allein- und Ergänzungsfuttermittel</a
  >.
</p>

<h2>Vor dem Kauf abhaken</h2>
<ul class="supplement-checklist">
  <li>Für die richtige Tierart und Lebensphase gekennzeichnet?</li>
  <li>Konkreter Zweck und Tagesmenge aus Fütterungsplan oder Produktangaben bekannt?</li>
  <li>Inhaltsstoffe und Mengen je Portion nachvollziehbar, statt nur ein Mischungsname?</li>
  <li>Bereits im Futter oder in anderen Ergänzungen enthaltene Stoffe berücksichtigt?</li>
  <li>Lagerung, Haltbarkeit nach Öffnen und erreichbarer Hersteller angegeben?</li>
  <li>Bei Erkrankungen, Medikamenten, Wachstum oder Trächtigkeit mit der Praxis abgestimmt?</li>
</ul>

<Notice variante="warnung" titel="Humanpräparate nicht ungeprüft verwenden">
  <p>
    Xylit kann für Hunde lebensgefährlich sein; auch überhöhte Vitamin-D-Mengen können schaden. Bei
    vermuteter Aufnahme eines problematischen Produkts sofort eine Tierarztpraxis oder den
    tierärztlichen Notdienst kontaktieren und die Verpackung bereithalten.
  </p>
  <p>
    <a
      href="https://www.fda.gov/animal-veterinary/animal-health-literacy/xylitol-and-dogs-deadly-combination"
      >FDA: Xylit</a
    > · <a
      href="https://www.fda.gov/animal-veterinary/outbreaks-and-advisories/fda-alerts-pet-owners-about-potentially-toxic-levels-vitamin-d-several-dry-pet-foods"
      >FDA: Risiken überhöhter Vitamin-D-Mengen</a
    >
  </p>
</Notice>

<section class="supplement-tool" aria-labelledby="vergleich-titel">
  <h2 id="vergleich-titel">Packungskosten vergleichen</h2>
  <p>
    Dieser Rechner berechnet Kosten und rechnerische Reichweite. Er bestimmt keine geeignete Dosis.
    Verwenden Sie für beide Produkte dieselbe Einheit und jeweils eine bereits festgelegte
    Tagesmenge.
  </p>
  <form id="supplement-vergleich">
    {
      ['A', 'B'].map((id) => (
        <fieldset>
          <legend>Produkt {id}</legend>
          <>
            <label for={`preis-${id}`}>Packungspreis in Euro</label>
            <input id={`preis-${id}`} inputmode="decimal" required />
          </>
          <>
            <label for={`inhalt-${id}`}>Packungsinhalt (ml, g oder Stück)</label>
            <input id={`inhalt-${id}`} inputmode="decimal" required />
          </>
          <>
            <label for={`menge-${id}`}>Festgelegte Tagesmenge in derselben Einheit</label>
            <input id={`menge-${id}`} inputmode="decimal" required />
          </>
        </fieldset>
      ))
    }
    <button type="submit">Kosten vergleichen</button>
  </form>
  <div id="supplement-ergebnis" class="comparison-result" role="status" aria-live="polite"></div>
  <noscript
    ><p>
      Ohne JavaScript: Packungsinhalt durch Tagesmenge teilen; Preis durch die ermittelte Reichweite
      teilen. Beide Ergebnisse beziehen sich nur auf die eingegebene Menge.
    </p></noscript
  >
</section>

<p class="hilfe">
  Diese Seite bietet allgemeine Informationen für Hunde und Katzen. Für andere Tierarten lassen sich
  Bedarf und Produkte nicht übertragen.
</p>

<script>
  import { supplementComparison } from '../../features/food/supplements.ts';
  const form = document.querySelector<HTMLFormElement>('#supplement-vergleich');
  const output = document.querySelector<HTMLElement>('#supplement-ergebnis');

  for (const image of document.querySelectorAll<HTMLImageElement>('img[data-feed-image]')) {
    image.addEventListener(
      'error',
      () => {
        const fallback = image.dataset.fallbackSrc;
        if (!fallback || image.src.endsWith(fallback)) return;
        image.src = fallback;
        image.alt = image.dataset.fallbackAlt ?? 'Neutrales Symbolbild';
        image.closest('figure')?.querySelector('figcaption')?.replaceChildren('Symbolbild');
      },
      { once: true },
    );
  }

  const renderMessage = (message: string, state = 'notice') => {
    if (!output) return;
    const paragraph = document.createElement('p');
    paragraph.className = 'comparison-message';
    paragraph.textContent = message;
    output.dataset.state = state;
    output.replaceChildren(paragraph);
  };

  form?.addEventListener('input', () => {
    if (output?.textContent) renderMessage('Eingaben geändert – bitte erneut vergleichen.');
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!output) return;
    try {
      const values = ['A', 'B'].map((id) => {
        const read = (field: string) =>
          document.querySelector<HTMLInputElement>(`#${field}-${id}`)?.value ?? '';
        const value = supplementComparison(read('preis'), read('inhalt'), read('menge'));
        return { id, ...value };
      });

      const lowestDailyCost = Math.min(...values.map((value) => value.dailyCost));
      const equalCost = values.every((value) => value.dailyCost === lowestDailyCost);
      const grid = document.createElement('div');
      grid.className = 'result-grid';

      for (const value of values) {
        const card = document.createElement('article');
        const isLowest = value.dailyCost === lowestDailyCost;
        card.className = `result-card${isLowest ? ' result-card--best' : ''}`;
        card.dataset.product = value.id;

        const headingRow = document.createElement('div');
        headingRow.className = 'result-heading';
        const heading = document.createElement('h3');
        heading.textContent = `Produkt ${value.id}`;
        headingRow.append(heading);
        if (isLowest) {
          const badge = document.createElement('span');
          badge.className = 'result-badge';
          badge.textContent = equalCost ? 'Gleicher Tagespreis' : 'Niedrigerer Tagespreis';
          headingRow.append(badge);
        }

        const price = document.createElement('p');
        price.className = 'result-price';
        const amount = document.createElement('strong');
        amount.textContent = value.dailyCost.toLocaleString('de-DE', {
          style: 'currency',
          currency: 'EUR',
        });
        const perDay = document.createElement('span');
        perDay.textContent = ' pro Tag';
        price.append(amount, perDay);

        const reach = document.createElement('p');
        reach.className = 'result-reach';
        reach.textContent = `Rechnerische Reichweite: ${value.days.toLocaleString('de-DE', { maximumFractionDigits: 1 })} Tage`;
        card.append(headingRow, price, reach);
        grid.append(card);
      }

      const note = document.createElement('p');
      note.className = 'result-note';
      note.textContent =
        'Rechnerischer Vergleich ohne Aussage zu Eignung oder Wirksamkeit. Haltbarkeit nach Öffnen zusätzlich beachten.';
      output.dataset.state = 'result';
      output.replaceChildren(grid, note);
    } catch {
      renderMessage(
        'Bitte für beide Produkte gültige positive Zahlen eingeben (z. B. 19,95). Tagesmenge und Packungsinhalt müssen dieselbe Einheit verwenden.',
        'error',
      );
    }
  });
</script>
<style>
  h1 {
    hyphens: auto;
    overflow-wrap: anywhere;
  }
  .lead {
    font-size: 1.2rem;
  }
  .review-note {
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--color-primary, #0d4946);
    color: var(--color-text-muted, #526b70);
  }
  .affiliate-section {
    margin-block: 2.5rem 3.5rem;
    padding: clamp(1.1rem, 2.5vw, 2rem);
    border: 1px solid #d7e4df;
    border-radius: 1.5rem;
    background: linear-gradient(145deg, #fffaf2, #f3f8f5);
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
  .section-heading h2,
  .section-heading .eyebrow {
    margin-block: 0;
  }
  .affiliate-disclosure {
    max-inline-size: 25rem;
    margin: 0;
    color: var(--color-text-muted, #526b70);
    font-size: 0.9rem;
  }
  .supplement-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
  }
  .supplement-products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
  }
  .product-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .supplement-products figure {
    position: relative;
    margin: -1.3rem -1.3rem 1rem;
  }
  .supplement-products img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 1rem 1rem 0 0;
  }
  .supplement-products figcaption {
    position: absolute;
    inset-inline-end: 0.65rem;
    inset-block-end: 0.65rem;
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 88%);
    color: var(--color-text);
    font-size: 0.72rem;
  }
  .supplement-products h3 {
    margin: 0;
    font-size: var(--text-h3);
  }
  .species-label {
    align-self: flex-start;
    margin-block: 0 0.65rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: #e3f1ec;
    color: #174c44;
    font-size: 0.82rem;
    font-weight: 700;
  }
  .product-meta {
    margin-block: 0.5rem 0;
    font-weight: 700;
  }
  .product-category {
    color: var(--color-text-muted, #526b70);
    font-size: 0.92rem;
  }
  .source-link {
    margin-block-start: auto;
    font-size: 0.9rem;
  }
  .fressnapf-link {
    margin-block: 0.25rem 0;
    overflow-wrap: anywhere;
  }
  .zooroyal-link {
    margin-block: 0.25rem 0;
    overflow-wrap: anywhere;
  }
  .affiliate-note {
    margin-block-end: 0;
    color: var(--color-text-muted, #526b70);
    font-size: 0.9rem;
  }
  article,
  .supplement-tool {
    background: var(--color-surface, #fff);
    border: 1px solid #d9e3df;
    border-radius: 1rem;
    padding: 1.3rem;
  }
  article h3 {
    margin-top: 0;
  }
  .supplement-checklist li {
    margin-block: 0.7rem;
  }
  fieldset {
    display: grid;
    gap: 0.5rem;
    margin-block: 1rem;
  }
  input {
    width: 100%;
    min-height: 44px;
  }
  .comparison-result:not(:empty) {
    margin-block-start: 1.5rem;
  }
  @media (max-width: 600px) {
    .supplement-grid,
    .supplement-products {
      grid-template-columns: 1fr;
    }
    .section-heading {
      align-items: start;
      flex-direction: column;
    }
  }
  @media (min-width: 601px) and (max-width: 960px) {
    .supplement-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<style is:global>
  .comparison-result .result-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .comparison-result .result-card {
    padding: 1.15rem;
    border: 1px solid #d5e1dd;
    border-radius: 1rem;
    background: #f8fbfa;
  }
  .comparison-result .result-card--best {
    border-color: #5b988b;
    background: #edf7f3;
    box-shadow: inset 0 0 0 1px #5b988b;
  }
  .comparison-result .result-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .comparison-result .result-heading h3 {
    margin: 0;
    font-size: 1rem;
  }
  .comparison-result .result-badge {
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: #0d4946;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }
  .comparison-result .result-price {
    margin-block: 1rem 0.35rem;
  }
  .comparison-result .result-price strong {
    color: #0d4946;
    font-size: clamp(1.7rem, 4vw, 2.25rem);
    line-height: 1;
  }
  .comparison-result .result-price span,
  .comparison-result .result-reach,
  .comparison-result .result-note,
  .comparison-result .comparison-message {
    color: #526b70;
  }
  .comparison-result .result-reach,
  .comparison-result .result-note,
  .comparison-result .comparison-message {
    margin-block: 0.5rem 0;
  }
  .comparison-result[data-state='error'] .comparison-message {
    padding: 0.85rem 1rem;
    border-inline-start: 4px solid #b9452d;
    background: #fff4f0;
    color: #71301f;
  }
  @media (max-width: 600px) {
    .comparison-result .result-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
