---
/**
 * M08-04 — Tierarztkosten-Rechner.
 *
 * Die Rechnung ist aus den Einzelpositionen nachvollziehbar: jede Zeile
 * nennt Basisbetrag, Faktor, Menge und die Fundstelle in der Verordnung.
 *
 * Die Gebührendaten kommen als statische JSON-Datei über das Manifest; es
 * gibt keinen Server und keine Anfrage an Dritte. Gerechnet wird im Browser
 * mit **derselben** Engine wie im Build — sie wird importiert, nicht
 * nachgebaut, damit die Regeln nicht auseinanderlaufen können.
 */
import Notice from '../Notice.astro';
import ToolShell from '../tools/ToolShell.astro';
import RadioCard from '../forms/RadioCard.astro';
import DataStatus from '../DataStatus.astro';
import ErrorSummary from '../forms/ErrorSummary.astro';
import Field from '../forms/Field.astro';
import { COST_CONFIG, NICHT_ENTHALTEN } from '../../features/costs/engine.ts';
import { defaultMarket, withEnabledFeatures } from '../../domain/market.ts';
import { devFeatureOverrides } from '../../../config/build.ts';
import { subroutePath } from '../../lib/routes.ts';
import snapshot from '../../../data-snapshots/got/got-2022.json' with { type: 'json' };

const market = defaultMarket();
const quelle = snapshot.source as {
  name: string;
  url: string;
  retrievalDate: string;
  sourceVersion: string;
  effectiveFrom: string | null;
  amendmentNote: string | null;
  legalBasis: string;
};

const katalogMarkt = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
const katalogPfad = subroutePath(katalogMarkt, 'costs', 'katalog');
---

<h1>Tierarztkosten berechnen</h1>

<p>
  Der Rechner setzt Positionen der Gebührenordnung für Tierärztinnen und Tierärzte zusammen und
  zeigt, wie sich ein Betrag ergibt. Er ist <strong>kein amtlicher Rechner</strong> und kein Kostenvoranschlag:
  eine echte Rechnung kann Positionen enthalten, die hier niemand ausgewählt hat.
</p>

{
  COST_CONFIG.clinicalReview !== 'approved' && (
    <Notice variante="warnung" titel="Fachlich noch nicht geprüft" testId="ungeprueft">
      <p>
        Die Rechenannahmen dieses Rechners — Faktorbereiche, Notdienstgebühr, Steuerbehandlung und
        Rundung — sind <strong>von keiner fachlich geeigneten Person abgenommen</strong>. Der
        Rechner ist zum Ausprobieren freigeschaltet, nicht als Auskunft. Verlassen Sie sich nicht
        auf die Beträge.
      </p>
    </Notice>
  )
}

<DataStatus
  stand={quelle.effectiveFrom}
  quelle={`${quelle.sourceVersion} · ${quelle.legalBasis}`}
  locale={market.locale}
/>

<ToolShell eingabeTitel="Eingaben" ergebnisTitel="Rechnung" ergebnisId="ergebnis-titel">
  <Fragment slot="eingabe">
    <ErrorSummary id="rechner-fehler" />

    <form id="rechner" data-validierung data-fehlerliste="rechner-fehler" novalidate>
      <fieldset>
        <legend>Behandlungskontext</legend>
        <p class="hilfe">
          Der Kontext wird nicht aus der Uhrzeit abgeleitet. Wählen Sie, was tatsächlich zutrifft;
          im Zweifel fragen Sie in der Praxis nach.
        </p>
        <div class="karten">
          <RadioCard
            name="kontext"
            value="regular"
            label="Regulär"
            erlaeuterung={`Faktor ${COST_CONFIG.standardFactorMin} bis ${COST_CONFIG.standardFactorMax}`}
            checked
          />
          <RadioCard
            name="kontext"
            value="emergency"
            label="Notdienst"
            erlaeuterung={`Faktor ${COST_CONFIG.emergencyFactorMin} bis ${COST_CONFIG.emergencyFactorMax}, zuzüglich Notdienstgebühr`}
          />
        </div>
      </fieldset>

      <fieldset>
        <legend>Tier</legend>
        <div class="karten">
          <RadioCard
            name="tierart"
            value="unbekannt"
            label="Keine Angabe"
            erlaeuterung="Zeigt alle Positionen der Verordnung."
            checked
          />
          <RadioCard
            name="tierart"
            value="dog"
            label="Hund"
            erlaeuterung="Blendet Positionen aus, die ausdrücklich eine andere Tierart nennen."
          />
          <RadioCard
            name="tierart"
            value="cat"
            label="Katze"
            erlaeuterung="Blendet Positionen aus, die ausdrücklich eine andere Tierart nennen."
          />
        </div>
        <p class="hilfe">
          Die Verordnung ordnet die meisten Positionen keiner Tierart zu. Eine Angabe schließt hier
          nur Positionen aus, die im Originaltext ausdrücklich eine andere Tierart nennen.
        </p>
      </fieldset>

      <fieldset>
        <legend>Position hinzufügen</legend>
        <label for="suche">Leistung suchen</label>
        <input id="suche" type="search" autocomplete="off" placeholder="z. B. Untersuchung" />
        <p id="suche-hinweis" class="hilfe" role="status" aria-live="polite"></p>
        <ul id="treffer" class="treffer"></ul>

        <Field
          id="menge"
          name="menge"
          label="Menge"
          hilfe="Ganze Zahl, mindestens 1."
          fehlertext="Die Menge muss eine ganze Zahl größer als 0 sein."
          regel="zahl-positiv"
          inputmode="numeric"
          pflicht
        />
        <Field
          id="faktor"
          name="faktor"
          label="Faktor"
          hilfe="Höchstens zwei Nachkommastellen. Der zulässige Bereich hängt vom Kontext ab."
          fehlertext="Der Faktor liegt außerhalb des für diesen Kontext zulässigen Bereichs."
          regel="zahl-bereich"
          inputmode="decimal"
          min={1}
          max={4}
          pflicht
        />
        <p>
          <button type="submit">Position übernehmen</button>
        </p>
      </fieldset>
    </form>
  </Fragment>

  <Fragment slot="ergebnis">
    <p id="rechner-status" role="status" aria-live="polite">Noch keine Position ausgewählt.</p>
    <div id="ergebnis" data-testid="rechner-ergebnis"></div>
    <p class="drucken">
      <button type="button" id="drucken">Rechnung drucken</button>
      <span class="hilfe">
        Auf dem Ausdruck stehen Quelle, Fassung und die Fundstelle jeder Position.
      </span>
    </p>
  </Fragment>
</ToolShell>

<Notice variante="warnung" titel="Was der Rechner nicht kann">
  <p>Nicht enthalten sind:</p>
  <ul>
    {NICHT_ENTHALTEN.map((eintrag) => <li>{eintrag}</li>)}
  </ul>
  <p>
    Die Zusammenstellung der Positionen ist Ihre Auswahl. Ob sie zu einer Behandlung passt, kann nur
    die behandelnde Praxis beurteilen.
  </p>
</Notice>

<h2>Alle Positionen nachschlagen</h2>
<p>
  Jede der {snapshot.itemCount} Positionen hat eine eigene Seite mit Grundbetrag, Gebührensätzen und Fundstelle.
  Der <a href={katalogPfad}>Gebührenkatalog</a> führt über die Gliederung der Verordnung dorthin.
</p>

<h2>Quelle</h2>
<p>
  {quelle.name}, Fassung {quelle.sourceVersion}{
    quelle.amendmentNote !== null && <> — {quelle.amendmentNote}</>
  }. Bezogen am {quelle.retrievalDate.slice(0, 10)} von <a href={quelle.url}>{quelle.url}</a>.
  Rechtsgrundlage der Übernahme: {quelle.legalBasis}.
</p>

<style>
  fieldset {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-block: var(--space-4);
  }

  legend {
    font-weight: 600;
    padding-inline: var(--space-2);
  }

  .hilfe {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin-block: var(--space-1);
  }

  .karten {
    display: grid;
    gap: var(--space-3);
    margin-block: var(--space-3);
  }

  @media (min-width: 480px) {
    .karten {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    }
  }

  select,
  input[type='search'] {
    width: 100%;
    max-width: 28rem;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .treffer {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0;
    max-height: 18rem;
    overflow-y: auto;
  }

  .treffer li {
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-2);
  }

  .treffer button {
    text-align: start;
    width: 100%;
    background: none;
    border: 0;
    padding: var(--space-1);
    cursor: pointer;
    color: inherit;
  }

  .treffer button:hover {
    background: var(--color-surface-subtle);
  }

  :global(#ergebnis table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--space-4);
  }

  :global(#ergebnis th),
  :global(#ergebnis td) {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-2);
    text-align: start;
    vertical-align: top;
  }

  :global(#ergebnis td.zahl),
  :global(#ergebnis th.zahl) {
    text-align: end;
    white-space: nowrap;
  }

  :global(#ergebnis tfoot td) {
    font-weight: 600;
  }

  :global(#ergebnis .fundstelle) {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
</style>

<script>
  import { rechnerStarten } from '../../features/costs/ui.ts';

  rechnerStarten();
</script>
