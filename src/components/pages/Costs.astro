---
/**
 * M08-04 — Tierarztkosten-Rechner.
 *
 * Die Berechnungsübersicht ist aus den Einzelpositionen nachvollziehbar: jede Zeile
 * nennt Basisbetrag, Faktor, Menge und die Fundstelle in der Verordnung.
 *
 * Die Gebührendaten kommen als statische JSON-Datei über das Manifest; es
 * gibt keinen Server und keine Anfrage an Dritte. Gerechnet wird im Browser
 * mit **derselben** Engine wie im Build — sie wird importiert, nicht
 * nachgebaut, damit die Regeln nicht auseinanderlaufen können.
 */
import SavedProfileButton from '../tools/SavedProfileButton.astro';
import Notice from '../Notice.astro';
import ToolShell from '../tools/ToolShell.astro';
import RadioCard from '../forms/RadioCard.astro';
import DataStatus from '../DataStatus.astro';
import ReviewStatus from '../ReviewStatus.astro';
import ErrorSummary from '../forms/ErrorSummary.astro';
import Field from '../forms/Field.astro';
import { COST_CONFIG, NICHT_ENTHALTEN } from '../../features/costs/engine.ts';
import { defaultMarket, withEnabledFeatures } from '../../domain/market.ts';
import { devFeatureOverrides } from '../../../config/build.ts';
import { subroutePath } from '../../lib/routes.ts';
import snapshot from '../../../data-snapshots/got/got-2022.json' with { type: 'json' };
import BrandImage from '../BrandImage.astro';
import { BEHANDLUNGEN } from '../../features/costs/treatments.ts';

const market = defaultMarket();
const quelle = snapshot.source as {
  name: string;
  url: string;
  retrievalDate: string;
  sourceVersion: string;
  effectiveFrom: string | null;
  amendmentNote: string | null;
  legalBasis: string;
};

const katalogMarkt = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
const katalogPfad = subroutePath(katalogMarkt, 'costs', 'katalog');
const beispiele = BEHANDLUNGEN.slice(0, 4);
/** „Was kostet eine Impfung beim Hund?“ → „Impfung beim Hund“ */
const kurztitel = (titel: string) => {
  const kern = titel.replace(/^Was kostet (eine?|die|der|das) /, '').replace(/\?$/, '');
  return kern.charAt(0).toUpperCase() + kern.slice(1);
};
---

<header class="costs-hero">
  <div class="costs-hero__copy">
    <p class="costs-hero__eyebrow">Gebührenordnung für Tierärzte · GOT 2022</p>
    <h1>Tierarztkosten berechnen</h1>
    <p class="costs-hero__lead">
      Setz die Leistungen deiner Behandlung zusammen und sieh, wie sich der Betrag aus Grundbetrag,
      Faktor und Menge ergibt – mit Fundstelle für jede Position.
    </p>
    <p class="costs-hero__note">
      Der Rechner ist <strong>kein amtlicher Rechner</strong>. Die Berechnungsübersicht ist keine
      Rechnung einer Tierarztpraxis und kein verbindlicher Kostenvoranschlag: Eine echte Rechnung
      kann Positionen enthalten, die hier niemand ausgewählt hat.
    </p>
  </div>
  <aside class="costs-hero__aside" aria-labelledby="beispiele-titel">
    <BrandImage
      name="health-dog-home"
      class="costs-hero__image"
      sizes="(max-width: 899px) 100vw, 30vw"
      priority
    />
    <div class="costs-hero__examples">
      <p id="beispiele-titel" class="costs-hero__examples-title">Kostenbeispiele</p>
      <ul>
        {
          beispiele.map((b) => (
            <li>
              <a href={subroutePath(katalogMarkt, 'costs', 'behandlung', b.slug)}>
                {kurztitel(b.titel)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </aside>
</header>

<div class="costs-meta">
  <ReviewStatus
    status={COST_CONFIG.clinicalReview === 'approved' ? 'approved' : 'pending'}
    reviewedAt={COST_CONFIG.reviewedAt}
    reviewedBy={COST_CONFIG.reviewedBy}
    lastVerifiedAt={quelle.retrievalDate.slice(0, 10)}
    responsibility="Noch keiner fachlich prüfenden Person zugeordnet"
    sources={[{ label: quelle.sourceVersion, url: quelle.url }]}
    compact
  >
    {
      COST_CONFIG.clinicalReview === 'approved' ? (
        <p>Die Rechenannahmen dieses Rechners wurden fachlich geprüft.</p>
      ) : (
        <p data-testid="ungeprueft">
          Die Rechenannahmen dieses Rechners — Faktorbereiche, Notdienstgebühr, Steuerbehandlung und
          Rundung — sind <strong>von keiner fachlich geeigneten Person abgenommen</strong>. Der
          Rechner ist zum Ausprobieren freigeschaltet, nicht als Auskunft. Verlass dich nicht auf
          die Beträge.
        </p>
      )
    }
  </ReviewStatus>

  <DataStatus
    stand={quelle.effectiveFrom}
    quelle={`${quelle.sourceVersion} · ${quelle.legalBasis}`}
    locale={market.locale}
  />

  <details class="rechner-grenzen">
    <summary>Grenzen der Berechnung: Sonderfälle und enthaltene Leistungen</summary>
    <p>
      Standardmäßig werden ausgewählte Gebühren mit 19 % Umsatzsteuer berechnet. Für mit der Praxis
      geklärte Sonderfälle kannst du abweichende Faktoren, Steuer und den Erlass der Notdienstgebühr
      eingeben. Eine reguläre Sprechstunde am Abend oder Wochenende ist nicht automatisch Notdienst.
    </p>
    <p>
      Der Rechner prüft nicht, ob eine Leistung bereits in einer anderen enthalten ist (§ 6 GOT).
      Die Menge richtet sich nach der Einheit der gewählten Gebührenposition, etwa je Behandlung
      oder Zeitabschnitt. Die Praxis muss die Auswahl und Kombination der Leistungen bestätigen.
    </p>
  </details>
</div>

<SavedProfileButton />
<ToolShell
  eingabeTitel="Eingaben"
  ergebnisTitel="Berechnungsübersicht"
  ergebnisId="ergebnis-titel"
  sticky
>
  <Fragment slot="eingabe">
    <ErrorSummary id="rechner-fehler" />

    <form id="rechner" data-validierung data-fehlerliste="rechner-fehler" novalidate>
      <fieldset>
        <legend>Behandlungskontext</legend>
        <p class="hilfe">
          Der Kontext wird nicht aus der Uhrzeit abgeleitet. Wähl, was tatsächlich zutrifft; im
          Zweifel frag in der Praxis nach.
        </p>
        <div class="karten">
          <RadioCard
            name="kontext"
            value="regular"
            label="Regulär"
            erlaeuterung={`Faktor ${COST_CONFIG.standardFactorMin} bis ${COST_CONFIG.standardFactorMax}`}
            checked
          />
          <RadioCard
            name="kontext"
            value="emergency"
            label="Notdienst"
            erlaeuterung={`Faktor ${COST_CONFIG.emergencyFactorMin} bis ${COST_CONFIG.emergencyFactorMax}, zuzüglich Notdienstgebühr`}
          />
        </div>
        <p class="hilfe">
          Die Notdienstgebühr beträgt grundsätzlich 50,00 Euro netto. In derselben Angelegenheit
          wird sie nur einmal angesetzt, auch wenn mehrere Tiere desselben Halters behandelt werden.
          Diese Berechnung bildet eine Angelegenheit ab. Bestätigte Abweichungen sind gesondert zu
          berücksichtigen.
        </p>
      </fieldset>

      <details>
        <summary>Abweichende Abrechnung mit der Praxis geklärt</summary>
        <p>
          Nur für einen konkret bestätigten Fall: Gebührenvereinbarungen nach § 5 GOT bedürfen
          grundsätzlich vor der Leistung der Textform. § 3 GOT enthält besondere Sätze bei
          öffentlich angeordneten oder geförderten Leistungen; auf Verlangen außerhalb regulärer
          Zeiten gelten dort andere Zuschläge. Die rechtliche Einordnung trifft die Praxis.
        </p>
        <label
          ><input type="checkbox" id="sonderfall-bestaetigt" /> Die abweichende Behandlung ist für diese
          Berechnung mit der Praxis geklärt.</label
        >
        <label
          ><input type="checkbox" id="vereinbarter-faktor" /> Bestätigten abweichenden Faktor verwenden
          (auch außerhalb des Standardbereichs)</label
        >
        <label
          ><input type="checkbox" id="notdienst-erlass" /> Die Praxis erhebt in diesem Fall keine Notdienstgebühr.</label
        >
        <label for="steuer">Bestätigte Umsatzsteuer für diese Berechnung</label><select id="steuer"
          ><option value="19">19 % (Standard)</option><option value="7"
            >7 % (bestätigter begünstigter Fall)</option
          ><option value="0">Keine Umsatzsteuer laut Praxis</option></select
        >
        <p>
          7 % gilt nicht pauschal für Nutztiere. Gemischte Steuersätze in einer Rechnung werden
          nicht unterstützt: getrennt berechnen. Kein automatischer Anspruch auf einen Rabatt, eine
          Steuerbefreiung oder einen Gebührenerlass.
        </p>
        <p>
          Bei Sonderfällen nach § 3: grundsätzlich einfacher Satz; auf Verlangen nachts, am
          Wochenende oder Feiertag 2-fach, bei landwirtschaftlich zur Erwerbstätigkeit genutzten
          Tieren 1,75-fach. Besondere Schwierigkeiten, Vereinbarungen und Notdienst bitte
          ausdrücklich durch die Praxis einordnen lassen.
        </p>
        <p>
          Quellen: <a href="https://www.gesetze-im-internet.de/got_2022/__3.html">§ 3 GOT</a>, <a
            href="https://www.gesetze-im-internet.de/got_2022/__4.html">§ 4 GOT</a
          >, <a href="https://www.gesetze-im-internet.de/got_2022/__5.html">§ 5 GOT</a>, <a
            href="https://www.gesetze-im-internet.de/ustg_1980/__12.html">§ 12 UStG</a
          >.
        </p>
      </details>
      <fieldset>
        <legend>Tier</legend>
        <div class="karten">
          <RadioCard
            name="tierart"
            value="unbekannt"
            label="Keine Angabe"
            erlaeuterung="Zeigt alle Positionen der Verordnung."
            checked
          />
          <RadioCard
            name="tierart"
            value="dog"
            label="Hund"
            erlaeuterung="Filtert eindeutig als Hund oder Katze zugeordnete Positionen."
          />
          <RadioCard
            name="tierart"
            value="cat"
            label="Katze"
            erlaeuterung="Filtert eindeutig als Hund oder Katze zugeordnete Positionen."
          />
        </div>
        <p class="hilfe">
          Der Filter erkennt nur eindeutig zugeordnete Hund- und Katzenpositionen. Gemischte und
          nicht zugeordnete Positionen bleiben sichtbar, auch für andere Tierarten. Prüfe deshalb
          immer den vollständigen Leistungstext.
        </p>
      </fieldset>

      <fieldset>
        <legend>Position hinzufügen oder ändern</legend>
        <p class="hilfe">
          Ein Suchtreffer fügt die Leistung mit der eingetragenen Menge und dem Faktor hinzu.
          Bereits ausgewählte Positionen kannst du darunter ändern.
        </p>
        <label for="suche">Leistung suchen</label>
        <div class="search-combobox">
          <input
            id="suche"
            type="search"
            autocomplete="off"
            placeholder="z. B. Untersuchung"
            role="combobox"
            aria-autocomplete="list"
            aria-controls="treffer"
            aria-expanded="false"
            disabled
          />
          <ul id="treffer" class="treffer" role="listbox" hidden></ul>
        </div>
        <p id="suche-hinweis" class="hilfe" role="status" aria-live="polite"></p>
        <button type="button" id="katalog-erneut" hidden>Daten erneut laden</button>
        <div id="auswahl-steuerung" hidden>
          <label for="position-bearbeiten">Ausgewählte Position bearbeiten</label>
          <select id="position-bearbeiten"></select>
          <p id="auswahl-hinweis" class="hilfe"></p>
        </div>

        <Field
          id="menge"
          name="menge"
          label="Menge"
          hilfe="Ganze Zahl, mindestens 1."
          fehlertext="Die Menge muss eine ganze Zahl größer als 0 sein."
          regel="zahl-positiv"
          inputmode="numeric"
          pflicht
        />
        <Field
          id="faktor"
          name="faktor"
          label="Faktor"
          hilfe="Höchstens zwei Nachkommastellen. Der zulässige Bereich hängt vom Kontext ab."
          fehlertext="Der Faktor liegt außerhalb des für diesen Kontext zulässigen Bereichs."
          regel="zahl-bereich"
          inputmode="decimal"
          min={1}
          max={4}
          pflicht
        />
        <p>
          <button type="submit" id="position-uebernehmen" disabled>Änderungen übernehmen</button>
          <button type="button" id="auswahl-entfernen" hidden>Position entfernen</button>
        </p>
      </fieldset>
    </form>
  </Fragment>

  <Fragment slot="ergebnis">
    <p id="rechner-status" role="status" aria-live="polite">Noch keine Position ausgewählt.</p>
    <div class="preis-hinweis">
      <h3>Warum ein Einzelbetrag niedrig wirken kann</h3>
      <p>
        Angezeigt werden nur die Positionen, die du selbst hinzufügst. Eine allgemeine Untersuchung
        oder Beratung kann als eigene GOT-Position dazukommen. Zeitaufwand und Schwierigkeit
        beeinflussen den Faktor; Medikamente, Material, Labor, Auslagen oder Wegegeld können
        zusätzlich berechnet werden. Eine pauschale weitere „Arbeitszeitgebühr“ setzt der Rechner
        nicht an.
      </p>
    </div>
    <div
      id="ergebnis"
      role="region"
      data-testid="rechner-ergebnis"
      tabindex="0"
      aria-label="Berechnung mit Gebührenpositionen"
    >
    </div>
    <div class="drucken">
      <button type="button" id="drucken" disabled>Übersicht drucken</button>
      <p class="hilfe">
        Auf dem Ausdruck stehen Quelle, Fassung und die Fundstelle jeder Position.
      </p>
    </div>
  </Fragment>
</ToolShell>

<Notice variante="warnung" titel="Was der Rechner nicht kann">
  <p>Nicht enthalten sind:</p>
  <ul>
    {NICHT_ENTHALTEN.map((eintrag) => <li>{eintrag}</li>)}
  </ul>
  <p>
    Die Zusammenstellung der Positionen ist deine Auswahl. Ob sie zu einer Behandlung passt, kann
    nur die behandelnde Praxis beurteilen.
  </p>
</Notice>

<h2>Alle Positionen nachschlagen</h2>
<p>
  Jede der {snapshot.itemCount} Positionen hat eine eigene Seite mit Grundbetrag, Gebührensätzen und Fundstelle.
  Der <a href={katalogPfad}>Gebührenkatalog</a> führt über die Gliederung der Verordnung dorthin.
</p>

<h2>Quelle</h2>
<p>
  {quelle.name}, Fassung {quelle.sourceVersion}{
    quelle.amendmentNote !== null && <> — {quelle.amendmentNote}</>
  }. Bezogen am {quelle.retrievalDate.slice(0, 10)} von <a href={quelle.url}>{quelle.url}</a>.
  Rechtsgrundlage der Übernahme: {quelle.legalBasis}.
</p>

<style>
  .costs-hero {
    display: grid;
    gap: var(--space-5);
    align-items: start;
    margin-block: var(--space-2) var(--space-5);
  }
  .costs-hero__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .costs-hero h1 {
    margin-block: 0 var(--space-3);
  }
  .costs-hero__lead {
    max-inline-size: 58ch;
    margin-block: 0 var(--space-3);
    color: var(--color-ink);
    font-size: var(--text-lead);
  }
  .costs-hero__note {
    max-inline-size: 64ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
  .costs-hero__aside {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    align-self: center;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .costs-hero__aside :global(.costs-hero__image),
  .costs-hero__aside :global(.costs-hero__image img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .costs-hero__examples {
    padding: var(--space-3) var(--space-4);
  }
  .costs-hero__examples-title {
    margin: 0 0 var(--space-1);
    color: var(--color-ink);
    font-size: var(--text-small);
    font-weight: 700;
  }
  .costs-hero__examples ul {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .costs-hero__examples a {
    color: var(--color-primary-hover);
    font-size: var(--text-small);
    font-weight: 600;
  }
  /* Quelle, Prüfstatus und Grenzen als ruhige Infozeile unter dem Kopf. */
  .costs-meta {
    display: grid;
    gap: var(--space-2);
    margin-block: 0 var(--space-6);
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .costs-meta :global(p),
  .costs-meta :global(details) {
    margin-block: 0;
  }
  @media (min-width: 900px) {
    .costs-hero {
      grid-template-columns: minmax(0, 1.6fr) minmax(16rem, 1fr);
    }
  }

  fieldset {
    min-inline-size: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-block: var(--space-4);
    box-shadow: var(--shadow-xs);
  }

  /* Legende als Überschrift in der Karte statt auf dem Rahmen. */
  legend {
    float: inline-start;
    inline-size: 100%;
    margin-block-end: var(--space-2);
    padding: 0;
    color: var(--color-ink);
    font-size: var(--text-lead);
    font-weight: 700;
  }

  legend + * {
    clear: both;
  }

  .hilfe {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin-block: var(--space-1);
  }

  .drucken {
    margin-block-start: var(--space-5);
  }

  .drucken .hilfe {
    margin-block: var(--space-2) 0;
  }

  .karten {
    display: grid;
    gap: var(--space-3);
    margin-block: var(--space-3);
  }

  @media (min-width: 480px) {
    .karten {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    }
  }

  select,
  input[type='search'] {
    min-width: 0;
    width: 100%;
    max-width: 28rem;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .treffer {
    list-style: none;
    padding: 0;
    margin: var(--space-1) 0 0;
    max-height: 18rem;
    overflow-y: auto;
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: 20;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .search-combobox {
    position: relative;
    width: 100%;
    max-width: 28rem;
  }

  .search-combobox input[type='search'] {
    max-width: none;
  }

  .treffer li {
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-2);
  }

  .treffer button {
    text-align: start;
    width: 100%;
    background: none;
    border: 0;
    padding: var(--space-1);
    cursor: pointer;
    color: inherit;
    overflow-wrap: anywhere;
  }

  .treffer button:hover {
    background: var(--color-surface-subtle);
  }

  .treffer button:focus-visible {
    background: var(--color-surface-subtle);
    outline-offset: -3px;
  }

  .preis-hinweis {
    background: var(--color-surface-subtle);
    border-inline-start: 3px solid var(--color-primary);
    padding: var(--space-3) var(--space-4);
    margin-block: var(--space-4);
  }

  .preis-hinweis h3 {
    font-size: var(--text-body);
    margin: 0 0 var(--space-1);
  }

  .preis-hinweis p {
    font-size: var(--text-small);
    margin: 0;
  }

  :global(#ergebnis table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--space-4);
  }

  :global(#ergebnis th),
  :global(#ergebnis td) {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-2);
    text-align: start;
    vertical-align: top;
  }

  :global(#ergebnis td.zahl),
  :global(#ergebnis th.zahl) {
    text-align: end;
    white-space: nowrap;
  }

  :global(#ergebnis tfoot td) {
    font-weight: 600;
  }

  :global(#ergebnis .fundstelle) {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  :global(#ergebnis .drucktitel) {
    display: none;
  }

  @media print {
    :global(#ergebnis .drucktitel) {
      display: block;
    }
  }
</style>

<script>
  import { rechnerStarten } from '../../features/costs/ui.ts';

  rechnerStarten();
</script>

<style>
  #ergebnis :global(.bill-summary strong) {
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.1;
  }
  #ergebnis :global(.bill-summary) {
    font-size: 0.875rem;
  }
  #ergebnis :global([data-remove-cost]) {
    font-size: 0.875rem;
    margin-top: var(--space-2);
  }
</style>

<style>
  #ergebnis {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  #ergebnis :global(.tabellenrahmen) {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
  }

  @media print {
    #ergebnis,
    #ergebnis :global(.tabellenrahmen) {
      overflow: visible;
    }
  }
</style>

<script is:inline src="/formular.js" defer></script>
<noscript
  ><p>
    Suche und Berechnung benötigen JavaScript. Alle Gebührenpositionen kannst du im <a
      href="/de-de/tierarztkosten/katalog/">Gebührenkatalog</a
    > nachlesen.
  </p></noscript
>
