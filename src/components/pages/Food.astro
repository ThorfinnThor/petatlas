---
/**
 * M15-03 — Futter suchen.
 *
 * Die Seite sucht über Name, Marke und die Nummer vom Etikett. Sie vergleicht
 * Mengen und Preise; sie bewertet keine Zusammensetzung und vergibt keine
 * Punkte — dafür bräuchte es eine Methodik, die niemand geprüft hat.
 */
import Notice from '../Notice.astro';
import { defaultMarket, withEnabledFeatures } from '../../domain/market.ts';
import { devFeatureOverrides } from '../../../config/build.ts';
import { routePath, subroutePath } from '../../lib/routes.ts';
import { alleFutter, futterDatenArt } from '../../features/food/catalog.ts';
import { mengenText } from '../../features/food/unit-price.ts';
import { futterTaxonomie } from '../../features/food/taxonomy.ts';

const markt = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
const basisPfad = routePath(markt, 'food');
const synthetisch = futterDatenArt() === 'synthetic';
const produkte = alleFutter();
const taxonomie = futterTaxonomie();

const kurz = (foodId: string): string => foodId.replace('synthetisch:', '');
---

<h1>Futter</h1>
<p>
  <a href={routePath(markt, 'supplements')}>Nahrungsergänzung einordnen und Etiketten vergleichen</a
  >
</p>

<p>
  Vergleiche deklarierte Inhaltswerte und Packungsgrößen einer kleinen Auswahl echter Hundefutter.
  Die Werte stammen von den verlinkten Herstellerseiten; aktuelle Händlerpreise sind noch nicht
  erfasst.
</p>

{
  synthetisch && (
    <Notice variante="testdaten" titel="Synthetische Futterdaten">
      <p>
        Die hinterlegten Produkte sind <strong>erfunden</strong>, einschließlich Marken und Nummern.
        Echte Produkte erscheinen erst mit Angebotsrechten und geprüften Etikettangaben.
      </p>
    </Notice>
  )
}

<form id="futtersuche" data-basis={basisPfad}>
  <div class="feld">
    <label for="futter-begriff">Marke, Produktname oder Nummer vom Etikett</label>
    <input
      id="futter-begriff"
      type="search"
      autocomplete="off"
      inputmode="text"
      placeholder="z. B. Royal Canin oder Mini Adult"
    />
    <p class="hilfe">
      Suche nach Marke oder Name. Für die aktuelle Auswahl sind noch keine verifizierten Barcodes
      hinterlegt.
    </p>
  </div>
  <p id="futter-ohne-js" class="hilfe">
    Die Suche rechnet im Browser und braucht JavaScript. Die vollständige Liste steht darunter.
  </p>
  <p><button type="submit" id="futter-suchen" hidden>Suchen</button></p>
</form>

<div id="futter-treffer" role="status" aria-live="polite"></div>

<h2>Alle erfassten Produkte ({produkte.length})</h2>
<ul class="produkte">
  {
    produkte.map((produkt) => (
      <li data-futter={produkt.foodId}>
        <a href={subroutePath(markt, 'food', kurz(produkt.foodId))}>
          {produkt.brand} — {produkt.productName}
        </a>
        <span class="hilfe">
          {' '}
          · {mengenText(produkt) ?? 'Menge nicht angegeben'}
          {produkt.gtin === null ? '' : ` · ${produkt.gtin}`}
        </span>
      </li>
    ))
  }
</ul>

<h2>Deklarationen nebeneinander</h2>
<p>
  Herstellerwerte je 100 g Frischmasse. Unterschiedliche Werte sind keine Rangliste und sagen allein
  nichts über die Eignung für deinen Hund.
</p>
<div
  class="food-comparison"
  tabindex="0"
  role="region"
  aria-label="Nährwertvergleich, horizontal scrollbar"
>
  <table>
    <caption>Erfasste Produktlinien, Herstellerdeklarationen vom 09.09.2026</caption>
    <thead
      ><tr
        ><th scope="col">Produkt</th><th scope="col">Protein</th><th scope="col">Fett</th><th
          scope="col">Rohfaser</th
        ><th scope="col">Rohasche</th><th scope="col">Quelle</th></tr
      ></thead
    >
    <tbody
      >{
        produkte
          .filter(
            (product, index, all) =>
              all.findIndex(
                (other) =>
                  other.brand === product.brand && other.productName === product.productName,
              ) === index,
          )
          .map((product) => (
            <tr>
              <th scope="row">
                {product.brand} {product.productName}
              </th>
              {['protein', 'fat', 'fiber', 'ash'].map((key) => {
                const nutrient = product.nutrients.find((item) => item.nutrient === key);
                return (
                  <td>
                    {nutrient && nutrient.value !== null
                      ? `${nutrient.value.toLocaleString('de-DE')} ${nutrient.unit}`
                      : 'nicht erfasst'}
                  </td>
                );
              })}
              <td>
                <a href={product.declarationSourceUrl ?? undefined}>Hersteller</a>
              </td>
            </tr>
          ))
      }</tbody
    >
  </table>
</div>
<h2>Was hier nicht passiert</h2>
<ul class="ausschluesse">
  {
    taxonomie.excluded.map((eintrag) => (
      <li data-ausschluss>
        <strong>{eintrag.topic}.</strong> {eintrag.reason}
      </li>
    ))
  }
</ul>

<script>
  import { futtersucheStarten } from '../../features/food/search-ui.ts';

  futtersucheStarten();
</script>

<style>
  .feld {
    margin-block: var(--space-4);
  }

  .feld label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  input[type='search'] {
    width: 100%;
    max-width: 24rem;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .hilfe {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .produkte,
  .ausschluesse {
    padding-inline-start: var(--space-5);
  }

  .produkte li,
  .ausschluesse li {
    margin-block: var(--space-2);
  }

  #futter-treffer :global(.treffer__liste) {
    list-style: none;
    padding: 0;
  }

  #futter-treffer :global(.treffer__liste > li) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-block: var(--space-3);
  }

  #futter-treffer :global(.treffer__meta) {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  #futter-treffer :global(.treffer__kopf) {
    font-weight: 600;
  }
</style>

<style>
  .food-comparison {
    overflow-x: auto;
    margin-block: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .food-comparison table {
    min-width: 660px;
  }
  .food-comparison td {
    white-space: nowrap;
  }
</style>
