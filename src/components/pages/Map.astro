---
/**
 * M11-01 — Tierärzte und Orte in der Nähe, als Liste.
 *
 * Die Liste ist die Hauptsache, nicht ein Beiwerk der Karte. Sie wird
 * statisch mit einem Standardausschnitt gebaut und ist ohne JavaScript
 * vollständig lesbar; die Filter erweitern sie, sie ermöglichen sie nicht.
 *
 * Die Karte selbst kommt in M11-02 und lädt erst auf Klick.
 */
import Notice from '../Notice.astro';
import DataStatus from '../DataStatus.astro';
import { darstellung } from '../../features/map/website.ts';
import { defaultMarket, withEnabledFeatures } from '../../domain/market.ts';
import { devFeatureOverrides } from '../../../config/build.ts';
import { subroutePath } from '../../lib/routes.ts';
import { baubareStadtseiten } from '../../features/map/city-allowlist.ts';
import { TILES } from '../../features/map/tiles.ts';
import { STANDORT_TEXTE } from '../../features/map/geolocation.ts';
import {
  KATEGORIE_LABEL,
  RADIEN_METER,
  filtereOrte,
  formatiereEntfernung,
  notdienstHinweis,
  type ListenOrt,
} from '../../features/map/list.ts';
import snapshot from '../../../data-snapshots/places/places-de.json' with { type: 'json' };
import { oeffentlicheProjektion } from '../../../scripts/publish/places.ts';
import type { Place } from '../../domain/schemas/places.ts';

const market = defaultMarket();

/** Standardausschnitt der statischen Liste. */
const STANDARD = { name: 'Berlin', latitude: 52.5174, longitude: 13.3951, radius: 5_000 };

const alleOrte = (snapshot.places as unknown as Place[]).map(
  oeffentlicheProjektion,
) as unknown as ListenOrt[];

const standardTreffer = filtereOrte(alleOrte, {
  mitte: { latitude: STANDARD.latitude, longitude: STANDARD.longitude },
  gemeinde: STANDARD.name,
  radiusMeter: STANDARD.radius,
  kategorien: [],
  maxTreffer: 25,
});

// M11-04 — Städte mit eigener Seite. Die Liste kommt aus derselben Prüfung
// wie die Seiten selbst; sie kann deshalb nicht auf eine Seite verweisen, die
// gar nicht gebaut wurde.
const stadtMarkt = withEnabledFeatures(market, devFeatureOverrides());
const stadtseiten = baubareStadtseiten(alleOrte).map((seite) => ({
  name: seite.stadt.name,
  pfad: subroutePath(stadtMarkt, 'map', seite.slug),
  anzahl: seite.befund.gesamt,
}));

const quelle = snapshot.source as {
  name: string;
  licenseId: string;
  attribution: string;
  attributionUrl: string;
};
const abdeckung = snapshot.coverage as { placeCount: number; byCategory: Record<string, number> };
---

<h1>Tierärzte und Orte in der Nähe</h1>

<p>
  Erfasste Tierarztpraxen, Tierheime, Zoofachhandel und Hundewiesen in Deutschland. Die Daten
  stammen aus OpenStreetMap. Sie sind <strong>nicht vollständig</strong>: was hier fehlt, ist nicht
  erfasst — es ist deshalb nicht unbedingt nicht vorhanden.
</p>

<DataStatus
  stand={snapshot.source.retrievalDate}
  quelle={`${quelle.name} · ${quelle.licenseId}`}
  locale={market.locale}
/>

<Notice variante="warnung" titel="Kein Notdienstverzeichnis">
  <p>
    Von {abdeckung.placeCount.toLocaleString('de-DE')} erfassten Orten tragen neun eine Notdienstangabe.
    Diese Liste ist deshalb <strong>keine Notdienstauskunft</strong>. Im Notfall hilft der
    Notdienstplan der zuständigen Tierärztekammer oder ein Anruf in der Praxis.
  </p>
</Notice>

<nav class="map-view" aria-label="Ansicht wählen" hidden>
  <button type="button" data-map-view="list" aria-pressed="true">Liste</button>
  <button type="button" data-map-view="map" aria-pressed="false">Karte</button>
</nav>
<div class="map-workspace">
  <div class="map-sidebar">
    <form id="ortsfilter" aria-labelledby="filter-titel">
      <h2 id="filter-titel">Suchen</h2>

      <div class="feld">
        <label for="ort">Ort</label>
        <input
          id="ort"
          type="search"
          autocomplete="off"
          placeholder="z. B. Bremen"
          aria-describedby="ort-hinweis"
        />
        <p id="ort-hinweis" class="hilfe" role="status" aria-live="polite">
          Ohne Auswahl zeigt die Liste den Ausschnitt um {STANDARD.name}.
        </p>
        <ul id="ort-treffer" class="ortstreffer"></ul>
        <p>
          <button type="button" id="standort">Meinen Standort verwenden</button>
        </p>
        <p class="hilfe">{STANDORT_TEXTE.hinweisVorher}</p>
        <p id="standort-status" role="status" aria-live="polite"></p>
      </div>

      <fieldset>
        <legend>Kategorie</legend>
        {
          Object.entries(KATEGORIE_LABEL).map(([schluessel, label]) => (
            <label class="wahl">
              <input type="checkbox" name="kategorie" value={schluessel} />
              {label} ({(abdeckung.byCategory[schluessel] ?? 0).toLocaleString('de-DE')})
            </label>
          ))
        }
        <p class="hilfe">Keine Auswahl bedeutet alle Kategorien.</p>
      </fieldset>

      <div class="feld">
        <label for="radius">Umkreis</label>
        <select id="radius">
          {
            RADIEN_METER.map((meter) => (
              <option value={meter} selected={meter === STANDARD.radius}>
                {formatiereEntfernung(meter)}
              </option>
            ))
          }
        </select>
      </div>
    </form>
    <section aria-labelledby="treffer-titel">
      <h2 id="treffer-titel">Treffer</h2>
      <p id="treffer-status" role="status" aria-live="polite">
        {standardTreffer.length} erfasste Orte im Umkreis von {
          formatiereEntfernung(STANDARD.radius)
        } um
        {' '}{STANDARD.name}.
      </p>

      <ul id="trefferliste" class="treffer" tabindex="0" aria-label="Erfasste Orte">
        {
          standardTreffer.map((treffer) => (
            <li>
              <h3>{treffer.ort.name}</h3>
              <p class="meta">
                {KATEGORIE_LABEL[treffer.ort.category] ?? treffer.ort.category} ·{' '}
                {formatiereEntfernung(treffer.entfernungMeter)} · {treffer.ortsLabel}
                {treffer.punktBerechnet && ' · Position berechnet'}
              </p>
              {treffer.ort.openingHours !== null && (
                <p>Öffnungszeiten: {treffer.ort.openingHours}</p>
              )}
              {treffer.ort.openingHours === null && (
                <p class="unbekannt">Öffnungszeiten nicht erfasst</p>
              )}
              {treffer.ort.phone !== null && (
                <p>
                  Telefon:{' '}
                  <a href={`tel:${treffer.ort.phone.replace(/\s/g, '')}`}>{treffer.ort.phone}</a>
                </p>
              )}
              {(() => {
                const web = darstellung(treffer.ort.website);
                if (web.art === 'link') {
                  return (
                    <p>
                      <a href={web.url} rel="nofollow noopener">
                        Website
                      </a>
                    </p>
                  );
                }
                if (web.art === 'text') {
                  return (
                    <p class="unbekannt">
                      Website: {web.adresse} ({web.hinweis})
                    </p>
                  );
                }
                return null;
              })()}
              {notdienstHinweis(treffer.ort.emergency) !== null && (
                <p class="notdienst">{notdienstHinweis(treffer.ort.emergency)}</p>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <div class="map-output">
    <section aria-labelledby="karte-titel" class="map-panel">
      <h2 id="karte-titel">Karte</h2>
      <p>
        Die Karte lädt erst, wenn Sie sie anfordern. Vorher wird keine einzige Kachel geladen und
        Ihre IP-Adresse geht an keinen Kartendienst.
      </p>
      <p class="kartenhinweis">{TILES.noticeText}</p>
      <p>
        <button type="button" id="karte-anzeigen">Karte anzeigen</button>
      </p>
      <div id="karte" class="karte" hidden></div>
      <p id="karte-status" role="status" aria-live="polite"></p>
      <p class="hilfe">
        Die Karte ist eine Ergänzung. Alles, was sie zeigt, steht auch in der Trefferliste.
      </p>
    </section>
  </div>
</div>
<section aria-labelledby="staedte-titel">
  <h2 id="staedte-titel">Städte mit eigener Seite</h2>
  <p>
    Für diese {stadtseiten.length} Städte gibt es eine eigene Übersicht — dort, wo in allen vier Kategorien
    genug erfasst ist. Fehlt eine Stadt, reichen die Daten dafür nicht; das heißt nicht, dass es dort
    nichts gibt.
  </p>
  <ul class="staedte">
    {
      stadtseiten.map((stadt) => (
        <li>
          <a href={stadt.pfad}>{stadt.name}</a> <span class="meta">({stadt.anzahl})</span>
        </li>
      ))
    }
  </ul>
</section>

<h2>Quelle</h2>
<p>
  {quelle.attribution}. Die Daten stehen unter der Open Database License;
  {' '}<a href={quelle.attributionUrl} rel="nofollow noopener">Herkunft und Lizenz</a>. Die
  ausgelieferten Ortsdaten sind eine abgeleitete Datenbank und werden unter derselben Lizenz
  weitergegeben.
</p>

<style>
  .karte {
    height: 24rem;
    max-height: 70vh;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-block: var(--space-3);
  }

  .kartenhinweis {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .feld {
    margin-block: var(--space-4);
  }

  .feld label,
  legend {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  input[type='search'],
  select {
    width: 100%;
    max-width: 24rem;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  fieldset {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-block: var(--space-4);
  }

  .wahl {
    display: block;
    font-weight: 400;
    margin-block: var(--space-1);
  }

  .hilfe {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin-block: var(--space-1);
  }

  .ortstreffer {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0;
  }

  .ortstreffer li {
    border-bottom: 1px solid var(--color-border);
  }

  .ortstreffer button {
    width: 100%;
    text-align: start;
    background: none;
    border: 0;
    padding: var(--space-2);
    color: inherit;
    cursor: pointer;
  }

  .ortstreffer button:hover {
    background: var(--color-surface-subtle);
  }

  .treffer {
    list-style: none;
    padding: 0;
  }

  .treffer > li {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-block: var(--space-3);
  }

  .treffer h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-body);
  }

  .treffer p {
    margin-block: var(--space-1);
  }

  .meta {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .staedte {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .unbekannt {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .notdienst {
    border-inline-start: 3px solid var(--color-warning);
    padding-inline-start: var(--space-2);
  }
</style>

<script>
  import { listeStarten } from '../../features/map/list-ui.ts';

  listeStarten();

  const workspace = document.querySelector<HTMLElement>('.map-workspace');
  const viewNav = document.querySelector<HTMLElement>('.map-view');
  if (workspace && viewNav) {
    viewNav.hidden = false;
    workspace.dataset.view = 'list';
    for (const button of viewNav.querySelectorAll<HTMLButtonElement>('button')) {
      button.addEventListener('click', () => {
        workspace.dataset.view = button.dataset.mapView;
        for (const option of viewNav.querySelectorAll('button'))
          option.setAttribute('aria-pressed', String(option === button));
        window.dispatchEvent(new Event('resize'));
      });
    }
  }
</script>

<style>
  .map-workspace {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    margin-block: var(--space-8);
  }
  #ortsfilter {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    position: static;
  }
  #filter-titel {
    margin-top: 0;
  }
  .map-output {
    min-width: 0;
  }
  .map-view {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .map-view button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
  }
  @media (max-width: 900px) {
    .map-workspace {
      grid-template-columns: 1fr;
    }
    #ortsfilter {
      position: static;
    }
    .map-workspace[data-view='list'] .map-output {
      display: none;
    }
    .map-workspace[data-view='map'] [aria-labelledby='treffer-titel'] {
      display: none;
    }
  }
</style>

<style>
  .map-sidebar {
    min-width: 0;
  }
  .map-output {
    position: sticky;
    top: 6rem;
    background: var(--color-blue-100);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    min-height: 520px;
  }
  .map-panel h2 {
    margin-top: 0;
  }
  .map-view[hidden] {
    display: none;
  }
  .map-view button[aria-pressed='true'] {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
  }
  @media (min-width: 901px) {
    .map-view {
      display: none;
    }
    .map-sidebar .treffer {
      max-height: 620px;
      overflow-y: auto;
    }
    .map-sidebar .treffer li {
      overflow-wrap: anywhere;
    }
  }
  @media (max-width: 900px) {
    .map-output {
      position: static;
      min-height: 0;
    }
  }
</style>
