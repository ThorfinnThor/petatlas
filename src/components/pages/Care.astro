---
/**
 * M14-04 — Pflegekategorien.
 *
 * Die Seite führt durch fünf Zubehörkategorien und sagt bei jeder, wonach
 * gefiltert wird. Sie nennt außerdem, was hier **nicht** geführt wird — und
 * warum. Ohne diesen zweiten Teil sähe die Liste aus, als deckte sie den
 * Gesundheitsbedarf eines Tieres ab.
 */
import Notice from '../Notice.astro';
import { merkmalLabel } from '../../features/care/attributes.ts';
import { defaultMarket, withEnabledFeatures } from '../../domain/market.ts';
import { devFeatureOverrides } from '../../../config/build.ts';
import { subroutePath } from '../../lib/routes.ts';
import { careGuide } from '../../features/care/guides.ts';
import { pflegeTaxonomie } from '../../features/care/taxonomy.ts';

const markt = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
const taxonomie = pflegeTaxonomie();
---

<h1>Pflege</h1>

<p class="intro">
  Fünf ausführliche Auswahlhilfen für den Pflegealltag mit Hund und Katze. Vergleiche Werkzeuge nach
  Aufgabe und Passform, miss vor dem Kauf die entscheidenden Größen und erkenne Situationen, in
  denen Zubehör nicht die nächste Handlung ist.
</p>

<Notice variante="warnung" titel="Kein Gesundheitsbereich">
  <p>
    Hier steht Zubehör, keine Behandlung. Arzneimittel, Ergänzungsfuttermittel, medizinische Tests,
    Antiparasitika und Therapiegeräte werden <strong>nicht</strong> geführt; die Gründe stehen unten.
    Was Ihrem Tier fehlt, klärt die Tierarztpraxis — nicht ein Katalog.
  </p>
</Notice>

<h2>Kategorien</h2>
<ul class="kategorien">
  {
    taxonomie.categories.map((kategorie) => (
      <li data-kategorie={kategorie.categoryId}>
        {careGuide(kategorie.categoryId) && (
          <picture>
            <source
              type="image/avif"
              srcset={`/images/care/${careGuide(kategorie.categoryId)?.imageStem}-800.avif`}
            />
            <img
              src={`/images/care/${careGuide(kategorie.categoryId)?.imageStem}-800.webp`}
              alt={
                careGuide(kategorie.categoryId)?.imageAlt ?? `${kategorie.label} für Hund und Katze`
              }
              width="800"
              height="533"
              loading="lazy"
            />
          </picture>
        )}
        <div class="kategorie__inhalt">
          <p class="kategorie__kicker">{careGuide(kategorie.categoryId)?.kicker}</p>
          <h3>
            <a href={subroutePath(markt, 'care', kategorie.categoryId)}>{kategorie.label}</a>
          </h3>
          <p>{kategorie.description}</p>
          <p class="hilfe">
            Auswahl nach: {kategorie.matchAttributes.map(merkmalLabel).join(', ')}.
          </p>
          <a class="kategorie__aktion" href={subroutePath(markt, 'care', kategorie.categoryId)}>
            Auswahlhilfe öffnen →
          </a>
        </div>
      </li>
    ))
  }
</ul>

<h2>Was hier nicht geführt wird</h2>
<ul class="ausschluesse">
  {
    taxonomie.excluded.map((eintrag) => (
      <li data-ausschluss>
        <strong>{eintrag.topic}.</strong> {eintrag.reason}
      </li>
    ))
  }
</ul>

<style>
  .kategorien,
  .ausschluesse {
    list-style: none;
    padding: 0;
  }

  /* Abschnitt 23.2: auf breiten Seiten ein Raster, keine Spalte, die die
     halbe Fläche leer lässt. */
  .kategorien {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-4);
  }

  @media (min-width: 640px) {
    .kategorien {
      grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    }
  }

  .kategorien > li {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin-block: 0;
    background: var(--color-surface);
  }

  .kategorien picture,
  .kategorien img {
    display: block;
    inline-size: 100%;
  }

  .kategorien img {
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .kategorie__inhalt {
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .kategorie__kicker {
    margin: 0 0 var(--space-1);
    color: var(--color-primary-hover);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .kategorien h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-body);
  }

  .kategorie__aktion {
    display: inline-block;
    margin-block-start: var(--space-2);
    font-weight: 750;
  }

  .ausschluesse > li {
    margin-block: var(--space-2);
  }

  .hilfe {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .intro {
    max-inline-size: 72ch;
    font-size: 1.1rem;
  }
</style>
