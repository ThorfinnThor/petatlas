---
/**
 * M14-04 — Pflegekategorien.
 *
 * Die Seite führt durch fünf Zubehörkategorien und sagt bei jeder, wonach
 * gefiltert wird. Sie nennt außerdem, was hier **nicht** geführt wird — und
 * warum. Ohne diesen zweiten Teil sähe die Liste aus, als deckte sie den
 * Gesundheitsbedarf eines Tieres ab.
 */
import Notice from '../Notice.astro';
import { merkmalLabel } from '../../features/care/attributes.ts';
import { defaultMarket, withEnabledFeatures } from '../../domain/market.ts';
import { devFeatureOverrides } from '../../../config/build.ts';
import { subroutePath } from '../../lib/routes.ts';
import { pflegeTaxonomie } from '../../features/care/taxonomy.ts';

const markt = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
const taxonomie = pflegeTaxonomie();
---

<h1>Pflege</h1>

<p>
  Zubehör für die Fell-, Krallen- und Zahnpflege sowie für Mobilität — beschrieben über belegte
  Eigenschaften wie Maß, Material und Herstellerangaben. Nicht über eine vermutete gesundheitliche
  Wirkung.
</p>

<Notice variante="warnung" titel="Kein Gesundheitsbereich">
  <p>
    Hier steht Zubehör, keine Behandlung. Arzneimittel, Ergänzungsfuttermittel, medizinische Tests,
    Antiparasitika und Therapiegeräte werden <strong>nicht</strong> geführt; die Gründe stehen unten.
    Was Ihrem Tier fehlt, klärt die Tierarztpraxis — nicht ein Katalog.
  </p>
</Notice>

<h2>Kategorien</h2>
<ul class="kategorien">
  {
    taxonomie.categories.map((kategorie) => (
      <li data-kategorie={kategorie.categoryId}>
        <h3>
          <a href={subroutePath(markt, 'care', kategorie.categoryId)}>{kategorie.label}</a>
        </h3>
        <p>{kategorie.description}</p>
        <p class="hilfe">
          Gefiltert wird nach: {kategorie.matchAttributes.map(merkmalLabel).join(', ')}.
        </p>
      </li>
    ))
  }
</ul>

<h2>Was hier nicht geführt wird</h2>
<ul class="ausschluesse">
  {
    taxonomie.excluded.map((eintrag) => (
      <li data-ausschluss>
        <strong>{eintrag.topic}.</strong> {eintrag.reason}
      </li>
    ))
  }
</ul>

<style>
  .kategorien,
  .ausschluesse {
    list-style: none;
    padding: 0;
  }

  /* Abschnitt 23.2: auf breiten Seiten ein Raster, keine Spalte, die die
     halbe Fläche leer lässt. */
  .kategorien {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-4);
  }

  @media (min-width: 640px) {
    .kategorien {
      grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    }
  }

  .kategorien > li {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    margin-block: 0;
    background: var(--color-surface);
  }

  .kategorien h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-body);
  }

  .ausschluesse > li {
    margin-block: var(--space-2);
  }

  .hilfe {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
</style>
