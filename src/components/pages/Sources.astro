---
/**
 * M05-03 — Quellenseite.
 *
 * Die Liste kommt aus `config/sources/`, nicht aus einem separat gepflegten
 * Text. Eine Quelle, die noch nicht geprüft ist, steht als ungeprüft da —
 * sie verschwindet nicht und wird nicht beschönigt.
 */
import { allSources, pendingSources, verifiedSources } from '../../domain/source-registry.ts';
import { defaultMarket } from '../../domain/market.ts';
import { routePath } from '../../lib/routes.ts';
import Notice from '../Notice.astro';
import PageIntro from '../ui/PageIntro.astro';
import TransparencyNav from '../ui/TransparencyNav.astro';
import { editorialSources } from '../../domain/editorial-sources.ts';

const quellen = allSources();
const geprueft = verifiedSources();
const offen = pendingSources();
const markt = defaultMarket();
const redaktionelleQuellen = editorialSources();
const ARTEN: readonly { art: string; titel: string }[] = [
  { art: 'redaktionelle Fachquelle', titel: 'Fachquellen' },
  { art: 'Herstellerquelle', titel: 'Herstellerquellen' },
  { art: 'Händlerfeed', titel: 'Händlerfeeds' },
  { art: 'externer Dienst', titel: 'Externe Dienste' },
];
const bekannteArten = new Set(ARTEN.map((eintrag) => eintrag.art));
const gruppen = [
  ...ARTEN.map(({ art, titel }) => ({
    titel,
    quellen: redaktionelleQuellen.filter((quelle) => quelle.category === art),
  })),
  {
    titel: 'Weitere',
    quellen: redaktionelleQuellen.filter((quelle) => !bekannteArten.has(quelle.category)),
  },
].filter((gruppe) => gruppe.quellen.length > 0);

const statusMarke: Record<string, { text: string; art: string }> = {
  pending: { text: 'ungeprüft', art: 'offen' },
  verified: { text: 'geprüft', art: 'ok' },
  rejected: { text: 'abgelehnt', art: 'gesperrt' },
  expired: { text: 'abgelaufen', art: 'offen' },
};

const statusText: Record<string, string> = {
  pending: 'Rechte noch nicht geprüft',
  verified: 'Rechte geprüft und bestätigt',
  rejected: 'Nutzung abgelehnt',
  expired: 'Freigabe abgelaufen',
};
---

<PageIntro titel="Quellen" eyebrow="Transparenz">
  <p>
    Jede fachliche Angabe auf dieser Website stammt aus einer benannten Quelle. Diese Liste kommt
    aus derselben Konfiguration, aus der auch die Daten geladen werden.
  </p>
  <p>
    Wie wir Quellen auswählen und Änderungen prüfen, steht in der{' '}
    <a href={routePath(markt, 'method')}>Methodik</a>. Die Aktualität der ausgelieferten Daten zeigt
    der{' '}
    <a href={routePath(markt, 'dataStatus')}>Datenstand</a>.
  </p>
</PageIntro>

<TransparencyNav aktuell="sources" />

<dl class="kennzahlen">
  <div>
    <dt>Übernommene Datensätze</dt>
    <dd>{quellen.length}</dd>
  </div>
  <div>
    <dt>davon Rechte geprüft</dt>
    <dd>{geprueft.length}</dd>
  </div>
  <div>
    <dt>weitere Quellen und Dienste</dt>
    <dd>{redaktionelleQuellen.length}</dd>
  </div>
</dl>

{
  geprueft.length === 0 && (
    <Notice variante="hinweis" titel="Noch keine Quelle freigegeben">
      <p>
        Es ist bisher keine Quelle geprüft, und es werden keine fachlichen Daten ausgeliefert. Die
        folgenden Einträge sind Kandidaten: ihre Bedingungen sind erfasst, ihre Rechte aber noch
        nicht bestätigt.
      </p>
    </Notice>
  )
}

<h2 id="datensaetze">Erfasste Quellen ({quellen.length})</h2>
<p>
  Die folgenden Einträge sind übernommene <strong>Datensätze</strong>. Ihre Rechte werden je
  Ausgabeform geprüft.
</p>
<ul class="quellen">
  {
    quellen.map((quelle) => (
      <li>
        <div class="quellen__kopf">
          <h3>{quelle.resourceName}</h3>
          <span
            class:list={[
              'quellen__status',
              `quellen__status--${statusMarke[quelle.rights.status]?.art ?? 'offen'}`,
            ]}
          >
            {statusMarke[quelle.rights.status]?.text ?? quelle.rights.status}
          </span>
        </div>
        <dl>
          <dt>Anbieter</dt>
          <dd>{quelle.publisher}</dd>
          <dt>Rolle im Projekt</dt>
          <dd>{quelle.role}</dd>
          <dt>Distribution</dt>
          <dd>
            <a href={quelle.distributionUrl}>{quelle.distributionUrl}</a> ({quelle.format})
          </dd>
          <dt>Geltende Bedingungen</dt>
          <dd>
            <a href={quelle.primaryTermsUrl}>{quelle.primaryTermsUrl}</a>
          </dd>
          <dt>Abdeckung</dt>
          <dd>
            {quelle.coverage.spatial}, {quelle.coverage.temporal}, Aktualisierung:{' '}
            {quelle.updateCadence}
          </dd>
          <dt>Rechtestand</dt>
          <dd>
            {statusText[quelle.rights.status] ?? quelle.rights.status}
            {quelle.rights.licenseId !== null && ` · Lizenz: ${quelle.rights.licenseId}`}
            {quelle.rights.checkedAt !== null &&
              ` · geprüft am ${quelle.rights.checkedAt.slice(0, 10)}`}
          </dd>
          <dt>Attribution</dt>
          <dd>{quelle.rights.attributionRequired ? 'verpflichtend' : 'nicht verpflichtend'}</dd>
          {quelle.rights.shareAlike && (
            <>
              <dt>Share-Alike</dt>
              <dd>ja — abgeleitete Datenbanken können weitergabepflichtig sein</dd>
            </>
          )}
        </dl>
        {quelle.notes.length > 0 && (
          <ul class="quellen__notizen">
            {quelle.notes.map((notiz) => (
              <li>{notiz}</li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>

<h2 id="fachquellen">
  Fach-, Hersteller- und Händlerquellen, externe Dienste ({redaktionelleQuellen.length})
</h2>
<p>
  Diese Quellen werden verlinkt oder in eigenen Worten ausgewertet. Ein Quellenlink ist keine
  Freigabe zur Übernahme von Bildern, Seitentexten, Preisen oder Bewertungen.
</p>
{
  gruppen.map((gruppe) => (
    <section class="fachgruppe">
      <h3>
        {gruppe.titel} <span class="fachgruppe__anzahl">({gruppe.quellen.length})</span>
      </h3>
      <ul class="fachquellen">
        {gruppe.quellen.map((quelle) => (
          <li>
            <h4>{quelle.title}</h4>
            <p class="fachquellen__herkunft">
              {quelle.publisher} ·{' '}
              <a href={quelle.url.replace('{z}/{x}/{y}.png', '')}>{quelle.url}</a>
            </p>
            <dl>
              <div class="fachquellen__breit">
                <dt>Verwendung</dt>
                <dd>{quelle.usage}</dd>
              </div>
              <div>
                <dt>Fassung</dt>
                <dd>{quelle.version}</dd>
              </div>
              <div>
                <dt>Letzte tatsächliche Prüfung</dt>
                <dd>{quelle.checkedAt}</dd>
              </div>
              <div>
                <dt>Rechtebasis</dt>
                <dd>{quelle.rightsBasis}</dd>
              </div>
              <div>
                <dt>Erlaubte Ausgabe</dt>
                <dd>{quelle.allowedOutputs}</dd>
              </div>
              <div class="fachquellen__breit">
                <dt>Prüfnachweis</dt>
                <dd>
                  <code>{quelle.evidence}</code>
                </dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<p class="quellen__fazit">
  {offen.length} von {quellen.length} Quellen sind noch ungeprüft. Eine ungeprüfte Quelle darf weder im
  HTML noch als Datei ausgegeben werden. Die Lizenzgrenzen je Datenklasse stehen in{' '}
  <code>licenses/README.md</code> im Repository.
</p>

<style>
  .kennzahlen {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-10);
  }

  .kennzahlen > div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
  }

  .kennzahlen dt {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .kennzahlen dd {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-h2);
    font-weight: 700;
    line-height: 1.1;
  }

  .quellen {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin-block: var(--space-6) var(--space-12);
    padding: 0;
    list-style: none;
  }

  .quellen > li,
  .fachquellen > li {
    max-inline-size: none;
  }

  .quellen > li {
    margin: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
  }

  .quellen__kopf {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: flex-start;
    justify-content: space-between;
    margin-block-end: var(--space-4);
  }

  .quellen h3 {
    flex: 1 1 16rem;
    min-inline-size: 0;
    margin: 0;
    font-size: var(--text-h4);
    /* Ressourcennamen enthalten Dateinamen und Adressen, die auf einem
     * schmalen Bildschirm sonst über den Rand hinauslaufen. */
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: auto;
  }

  .quellen > li > h3 {
    margin-block-end: var(--space-4);
  }

  .quellen__status {
    flex: none;
    padding: 0.15em 0.65em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .quellen__status--ok {
    border-color: var(--color-success-border);
    background: var(--color-success-soft);
    color: var(--color-success);
  }

  .quellen__status--offen {
    border-color: var(--color-warning-border);
    background: var(--color-warning-soft);
    color: var(--color-warning);
  }

  .quellen__status--gesperrt {
    border-color: var(--color-danger-border);
    background: var(--color-danger-soft);
    color: var(--color-danger);
  }

  .fachgruppe {
    margin-block: var(--space-8) var(--space-10);
  }

  .fachgruppe h3 {
    margin-block: 0 var(--space-4);
  }

  .fachgruppe__anzahl {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .fachquellen {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fachquellen > li {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .fachquellen h4 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-body);
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .fachquellen__herkunft {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    overflow-wrap: anywhere;
  }

  .fachquellen dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--color-border);
    font-size: var(--text-small);
  }

  .fachquellen__breit {
    grid-column: 1 / -1;
  }

  .fachquellen dt {
    color: var(--color-text-muted);
    font-size: var(--text-micro);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .fachquellen dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .quellen dl {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1);
    margin: 0;
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }

  .quellen dt {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .quellen dd {
    margin: 0 0 var(--space-2);
    overflow-wrap: anywhere;
  }

  .quellen__notizen {
    margin: var(--space-3) 0 0;
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-8);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .quellen__fazit {
    padding: var(--space-4) var(--space-5);
    border-inline-start: 3px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: var(--color-surface-subtle);
  }

  @media (min-width: 32rem) {
    .quellen dl {
      grid-template-columns: minmax(9rem, auto) 1fr;
      column-gap: var(--space-4);
    }

    .quellen dt {
      grid-column: 1;
    }

    .quellen dd {
      grid-column: 2;
    }
  }
</style>
