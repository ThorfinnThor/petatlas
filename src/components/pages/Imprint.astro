---
import { resolveBuildConfig } from '../../../config/build.ts';
import { createSiteConfig } from '../../../config/site.ts';
import Notice from '../Notice.astro';
const build = resolveBuildConfig();
const betreiber = createSiteConfig(build.mode, process.env).operator;
---

<h1>Impressum</h1>
{
  betreiber.legalName === null ? (
    <Notice variante="warnung" titel="Betreiberangaben liegen nicht vor">
      <p>Für diesen Entwicklungsstand sind keine Betreiberangaben hinterlegt.</p>
    </Notice>
  ) : (
    <>
      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        {betreiber.legalName}
        <br />
        {betreiber.address}
      </p>
      <h2>Kontakt</h2>
      <p>
        E-Mail: <a href={`mailto:${betreiber.contactEmail}`}>{betreiber.contactEmail}</a>
      </p>
      <h2>Verantwortlich für journalistisch-redaktionelle Inhalte gemäß § 18 Abs. 2 MStV</h2>
      <p>
        {betreiber.responsibleForContent}
        <br />
        {betreiber.address}
      </p>
      {betreiber.registerEntry && <p>Registereintrag: {betreiber.registerEntry}</p>}
      {betreiber.vatId && <p>Umsatzsteuer-Identifikationsnummer: {betreiber.vatId}</p>}
      <h2>Über dieses Angebot</h2>
      <p>
        Wau &amp; Miau bietet Informationen und Werkzeuge für Hunde- und Katzenhalter. Wir verkaufen
        auf dieser Website keine Waren und nehmen keine Bestellungen entgegen. Über Händlerlinks
        verlässt du unsere Website; ein Kaufvertrag kommt gegebenenfalls mit dem dort genannten
        Verkäufer zustande.
      </p>
      <p>
        Hinweise zur Datenverarbeitung findest du unter <a href="../datenschutz/">Datenschutz</a>,
        zur Auswahl von Quellen und zur Finanzierung unter <a href="../methodik/">Methodik</a>.
      </p>
    </>
  )
}
