---
/**
 * M14-04 — Spielzeugfinder.
 *
 * Der Finder beantwortet eine Frage: was ist nach Ihren Angaben **nicht
 * ausgeschlossen**? Er beantwortet ausdrücklich nicht, was das beste
 * Spielzeug ist — dafür bräuchte es Eigenschaften, die niemand belegt hat.
 *
 * Zu jedem Ergebnis stehen zwei Dinge: warum es erscheint und was nicht
 * geprüft ist. Ohne die zweite Angabe wäre die Liste eine Empfehlung.
 */
import { amazonEnabled, amazonSearchUrl, AMAZON_SEARCHES } from '../../features/commerce/amazon.ts';
import SavedProfileButton from '../tools/SavedProfileButton.astro';
import Notice from '../Notice.astro';
import { merkmalLabel } from '../../features/care/attributes.ts';
import { BEDUERFNISSE } from '../../features/care/matching.ts';
import { attributPruefung } from '../../features/care/attributes.ts';
import { spielzeugTaxonomie } from '../../features/care/taxonomy.ts';
import RetailPartnerSection from '../RetailPartnerSection.astro';
import type { MarketConfig } from '../../domain/market.ts';
import { fressnapfAngebote } from '../../features/commerce/fressnapf-feed.ts';
import { zooroyalAngebote } from '../../features/commerce/zooroyal-feed.ts';
import { fressnapfKatalog, zooroyalKatalog } from '../../features/commerce/feed-catalog.ts';
import FeedProductGrid from '../commerce/FeedProductGrid.astro';

interface Props {
  market: MarketConfig;
}

const { market } = Astro.props;

const taxonomie = spielzeugTaxonomie();
const pruefung = attributPruefung();
const synthetisch = pruefung.dataKind === 'synthetic';
const fressnapfProducts = Object.fromEntries(
  fressnapfAngebote().map((product) => [
    product.productId,
    { imageUrl: product.imageUrl, affiliateUrl: product.affiliateUrl },
  ]),
);
const zooroyalProducts = Object.fromEntries(
  zooroyalAngebote().map((product) => [
    product.productId,
    { imageUrl: product.imageUrl, affiliateUrl: product.affiliateUrl },
  ]),
);
const fressnapfCatalog = fressnapfKatalog();
const zooroyalCatalog = zooroyalKatalog();
---

<h1>Spielzeug finden</h1>

<p>
  Ein kurzer Fragebogen, ein nachvollziehbares Ergebnis: Der Finder schließt aus, was laut
  Herstellerangabe nicht passt, und ordnet den Rest nach belegten Übereinstimmungen. Er bewertet
  keine Produkte und vergibt keine Punkte für Sicherheit oder Haltbarkeit — solche Zahlen wären
  erfunden.
</p>

<RetailPartnerSection market={market} page="spielzeug" />

<FeedProductGrid
  offers={fressnapfCatalog}
  category="toy"
  title="Spielzeug aus dem Fressnapf-Sortiment"
  retailerLabel="Fressnapf"
/>
<FeedProductGrid
  offers={zooroyalCatalog}
  category="toy"
  title="Spielzeug aus dem ZooRoyal-Sortiment"
  retailerLabel="ZooRoyal"
/>

{
  synthetisch && (
    <Notice variante="testdaten" titel="Synthetische Produktdaten">
      <p>
        Die hinterlegten Produkte sind <strong>erfunden</strong>. Echte Produkte erscheinen erst,
        wenn Angebotsrechte bestehen und ihre Eigenschaften einzeln geprüft sind.
      </p>
    </Notice>
  )
}

<SavedProfileButton />
{
  amazonEnabled(process.env) && (
    <p class="hilfe">
      Händlerlinks öffnen eine Amazon-Suche. Bitte Tierart, Größe und Ausführung dort prüfen.
    </p>
  )
}
<form
  id="finder"
  data-amazon-links={amazonEnabled(process.env)
    ? JSON.stringify(
        Object.fromEntries(
          Object.keys(AMAZON_SEARCHES)
            .filter((key) => !key.startsWith('supplements-'))
            .map((key) => [key, amazonSearchUrl(key)]),
        ),
      )
    : undefined}
  data-fressnapf-offers={JSON.stringify(fressnapfProducts)}
  data-zooroyal-offers={JSON.stringify(zooroyalProducts)}
>
  <div class="feld">
    <label for="finder-tierart">Tierart</label>
    <select id="finder-tierart">
      <option value="dog">Hund</option>
      <option value="cat">Katze</option>
    </select>
  </div>

  <div class="feld">
    <label for="finder-gewicht">Gewicht in Kilogramm</label>
    <input id="finder-gewicht" type="text" inputmode="decimal" placeholder="z. B. 20" />
    <p class="hilfe">
      Leer lassen, wenn Sie es nicht wissen. Dann wird nichts wegen der Größe ausgeschlossen — und
      nichts wegen der Größe empfohlen.
    </p>
  </div>

  <fieldset>
    <legend>Was trifft zu?</legend>
    <div class="auswahl">
      {
        Object.entries(BEDUERFNISSE)
          .filter(([key]) => key !== 'langhaar')
          .map(([schluessel, eintrag]) => (
            <label class="wahl">
              <input type="checkbox" name="bedarf" value={schluessel} />
              <span class="wahl__text">
                <>
                  <strong>{eintrag.label}</strong>
                  <span class="hilfe">{eintrag.erklaerung}</span>
                </>
              </span>
            </label>
          ))
      }
    </div>
  </fieldset>

  <p id="finder-ohne-js" class="hilfe">
    Der Finder rechnet im Browser und braucht dafür JavaScript. Die Kategorien und ihre Grenzen
    unten bleiben auch ohne lesbar.
  </p>
  <p><button type="submit" id="finder-suchen" hidden>Passendes anzeigen</button></p>
</form>

<p class="hilfe">
  Der Katalog enthält {
    pruefung.products.filter((product) =>
      taxonomie.categories.some((category) => category.categoryId === product.categoryId),
    ).length
  } redaktionell erfasste Spielzeuge und Kratzmöbel. Er bildet nicht das gesamte Amazon-Sortiment ab.
  Wünsche ändern die Reihenfolge; ausgeschlossene Tierarten erscheinen nicht. Eindeutig zugeordnete Fressnapf-Produkte
  erhalten ein Bild und einen direkten Händlerlink aus dem freigegebenen Awin-Feed.
</p>
<div id="finder-ergebnis" role="status" aria-live="polite"></div>

<h2>Kategorien</h2>
<ul class="kategorien">
  {
    taxonomie.categories.map((kategorie) => (
      <li data-kategorie={kategorie.categoryId}>
        <strong>{kategorie.label}.</strong> {kategorie.description}
        <p class="hilfe">
          Gefiltert wird nach: {kategorie.matchAttributes.map(merkmalLabel).join(', ')}.
        </p>
      </li>
    ))
  }
</ul>

<h2>Was hier nicht geführt wird</h2>
<ul class="ausschluesse">
  {
    taxonomie.excluded.map((eintrag) => (
      <li>
        <strong>{eintrag.topic}.</strong> {eintrag.reason}
      </li>
    ))
  }
</ul>

<script>
  import { finderStarten } from '../../features/toys/finder-ui.ts';

  finderStarten();
</script>

<style>
  .feld {
    margin-block: var(--space-4);
  }

  .feld label,
  legend {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  input[type='text'],
  select {
    width: 100%;
    max-width: 24rem;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  fieldset {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
  }

  .wahl {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    cursor: pointer;
    margin: 0;
  }

  .auswahl {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .wahl:has(input:checked) {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .wahl input {
    flex: 0 0 20px;
    margin: 3px 0 0;
  }

  .wahl__text {
    min-width: 0;
  }

  .wahl__text strong,
  .wahl__text .hilfe {
    display: block;
  }

  .hilfe {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin-block: var(--space-1);
  }

  .kategorien,
  .ausschluesse {
    padding-inline-start: var(--space-5);
  }

  .kategorien li,
  .ausschluesse li {
    margin-block: var(--space-2);
  }

  #finder-ergebnis :global(.finder__liste) {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    margin-block: var(--space-5);
  }

  #finder-ergebnis :global(.finder__liste > li) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin: 0;
    max-inline-size: none;
    min-width: 0;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
  }

  #finder-ergebnis :global(.finder__bild) {
    margin: calc(-1 * var(--space-5)) calc(-1 * var(--space-5)) var(--space-4);
    position: relative;
  }

  #finder-ergebnis :global(.finder__bild img) {
    display: block;
    inline-size: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  #finder-ergebnis :global(.finder__bild figcaption) {
    position: absolute;
    inset-inline-end: var(--space-2);
    inset-block-end: var(--space-2);
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 88%);
    color: var(--color-text);
    font-size: 0.72rem;
    line-height: 1.3;
  }

  #finder-ergebnis :global(h3) {
    margin-top: 0;
    font-size: var(--text-h4);
  }

  #finder-ergebnis :global(.finder__aktion) {
    margin-block: var(--space-2) 0;
  }

  #finder-ergebnis :global(.finder__aktionen) {
    margin-top: auto;
    padding-top: var(--space-4);
  }

  @media (min-width: 700px) {
    .auswahl,
    #finder-ergebnis :global(.finder__liste) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    #finder-ergebnis :global(.finder__liste) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  #finder-ergebnis :global(.finder__kopf) {
    font-weight: 600;
  }

  #finder-ergebnis :global(.finder__offen),
  #finder-ergebnis :global(.finder__neutral),
  #finder-ergebnis :global(.finder__kategorie) {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
</style>
