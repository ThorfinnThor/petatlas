---
/**
 * M12-01 — Reisecheck: zuerst der Umfang.
 *
 * Bevor irgendetwas geprüft wird, steht hier, **was** geprüft wird. Eine
 * Reiseseite, die das nicht sagt, wirkt wie eine weltweite Auskunft — und
 * genau das ist sie nicht.
 *
 * Die eigentliche Prüfung folgt mit belegten und fachlich freigegebenen
 * Regeln. Bis dahin steht hier der Umfang und sonst nichts: eine
 * Beispielprüfung mit erfundenen Regeln wäre schlimmer als keine.
 */
import SavedProfileButton from '../tools/SavedProfileButton.astro';
import Notice from '../Notice.astro';
import ToolStepper from '../tools/ToolStepper.astro';
import RadioCard from '../forms/RadioCard.astro';
import { reiseUmfang, umfangsSatz } from '../../features/travel/scope.ts';
import { defaultMarket, withEnabledFeatures } from '../../domain/market.ts';
import { devFeatureOverrides } from '../../../config/build.ts';
import { routePath } from '../../lib/routes.ts';

const umfang = reiseUmfang();
const quellenPfad = routePath(
  withEnabledFeatures(defaultMarket(), devFeatureOverrides()),
  'sources',
);

const LAENDER: Readonly<Record<string, string>> = {
  DE: 'Deutschland',
  AT: 'Österreich',
  BE: 'Belgien',
  FR: 'Frankreich',
  IT: 'Italien',
  LU: 'Luxemburg',
  NL: 'Niederlande',
};

const name = (code: string): string => LAENDER[code] ?? code;
const ziele = umfang.destinations.map(name);
const transit = umfang.transitCountries.map(name);
---

<h1>Reisecheck</h1>

<p>{umfangsSatz()}</p>

<Notice variante="warnung" titel="Keine weltweite Auskunft, keine Garantie">
  <p>
    Dieser Check deckt <strong>vier Zielstaaten</strong> ab, nicht die Welt. Er ersetzt keine Auskunft
    der zuständigen Behörde und keine Beratung durch eine Tierarztpraxis. Was hier nicht geprüft wird,
    ist deshalb nicht erlaubt und nicht verboten — es ist ungeprüft.
  </p>
</Notice>

<Notice variante="warnung" titel="Fachlich noch nicht geprüft">
  <p>
    Die Regeln sind aus den amtlichen Quellen erfasst und mit Fundstelle hinterlegt (<a
      href={quellenPfad}>Quellen</a
    >), aber <strong>fachlich noch nicht abgenommen</strong>. Deshalb gibt es hier kein grünes
    Gesamtergebnis, sondern eine Vorschau: einzelne Punkte werden ausgewertet, das Gesamturteil
    bleibt offen. Verbindlich ist die Auskunft der zuständigen Behörde.
  </p>
</Notice>

<SavedProfileButton />
<section aria-labelledby="check-titel">
  <h2 id="check-titel">Angaben zur Reise</h2>

  <ToolStepper
    label="Schritte des Reisechecks"
    aktiv="schritt-reise"
    schritte={[
      { id: 'schritt-reise', titel: 'Reise' },
      { id: 'schritt-tier', titel: 'Tier' },
      { id: 'schritt-angaben', titel: 'Angaben' },
      { id: 'schritt-ergebnis', titel: 'Ergebnis' },
    ]}
  />

  <form id="reiseform">
    <fieldset id="schritt-reise" class="schritt">
      <legend><span class="schritt__nummer">Schritt 1</span> Reise</legend>

      <div class="feld">
        <label for="richtung">Richtung</label>
        <select id="richtung">
          <option value="outbound">Hinreise aus Deutschland</option>
          <option value="return">Rückreise nach Deutschland</option>
        </select>
      </div>

      <div class="feld">
        <label for="ziel">Zielland (bei Rückreise: Herkunftsland)</label>
        <select id="ziel">
          {umfang.destinations.map((code) => <option value={code}>{name(code)}</option>)}
          <option value="XX">anderes Land</option>
        </select>
      </div>

      <fieldset>
        <legend>Durchreise</legend>
        {
          umfang.transitCountries.map((code) => (
            <label class="wahl">
              <input type="checkbox" name="transit" value={code} />
              {name(code)}
            </label>
          ))
        }
        <label class="wahl">
          <input type="checkbox" name="transit" value="XX" />
          anderes Land
        </label>
      </fieldset>

      <div class="feld">
        <label for="reisedatum">Tag der Reise</label>
        <input id="reisedatum" type="date" required />
      </div>
    </fieldset>

    <fieldset id="schritt-tier" class="schritt">
      <legend><span class="schritt__nummer">Schritt 2</span> Tier</legend>

      <div class="feld">
        <p class="feld__frage" id="tierart-frage">Tierart</p>
        <div class="karten" role="group" aria-labelledby="tierart-frage">
          <RadioCard name="tierart" value="dog" label="Hund" checked />
          <RadioCard name="tierart" value="cat" label="Katze" />
          <RadioCard
            name="tierart"
            value="other"
            label="Anderes Tier"
            erlaeuterung="Für andere Arten gelten andere Regeln; der Check gibt dafür keine Auskunft."
          />
        </div>
      </div>

      <div class="feld">
        <label for="anzahl">Anzahl der Tiere</label>
        <input
          id="anzahl"
          type="number"
          min="1"
          max="20"
          value="1"
          aria-describedby="anzahl-hilfe"
        />
        <p class="hilfe" id="anzahl-hilfe">
          Bei einer gemeinsamen Fahrt alle mitgeführten Hunde, Katzen und Frettchen im Fahrzeug
          zählen, auch die anderer Halter.
        </p>
      </div>

      <div class="feld">
        <label for="geburtsdatum">Geburtsdatum des Tieres</label>
        <input id="geburtsdatum" type="date" />
        <p class="hilfe">Leer lassen, wenn unbekannt. Unbekannt bleibt unbekannt.</p>
      </div>
    </fieldset>

    <fieldset id="schritt-angaben" class="schritt">
      <legend><span class="schritt__nummer">Schritt 3</span> Angaben</legend>
      <p class="hilfe">
        Gefragt wird nur, was für die Regeln des gewählten Wegs gebraucht wird. „Weiß ich nicht“
        bleibt „weiß ich nicht“ und wird nicht als Ja gewertet.
      </p>

      <div class="feld">
        <label for="chip">Ist das Tier mit einem Transponder gekennzeichnet?</label>
        <select id="chip">
          <option value="unbekannt">weiß ich nicht</option>
          <option value="ja">ja</option>
          <option value="nein">nein</option>
        </select>
      </div>

      <div class="feld">
        <label for="chipdatum">Datum der Kennzeichnung</label>
        <input id="chipdatum" type="date" />
      </div>

      <div class="feld">
        <label for="impfung">Besteht eine gültige Tollwutimpfung?</label>
        <select id="impfung">
          <option value="unbekannt">weiß ich nicht</option>
          <option value="ja">ja</option>
          <option value="nein">nein</option>
        </select>
      </div>

      <div class="feld">
        <label for="impfdatum">Datum der Erstimpfung</label>
        <input id="impfdatum" type="date" aria-describedby="impfdatum-hilfe" />
        <p class="hilfe" id="impfdatum-hilfe">
          Gemeint ist der Abschluss der vollständigen Erstimpfung, nicht die erste Dosis einer
          mehrteiligen Impfserie. „Gültig“ muss die Impfung am Reisetag sein. Nach einer lückenlosen
          Auffrischung beginnt die Wartezeit nicht erneut; nach einer Unterbrechung lassen Sie das
          maßgebliche Datum in der Tierarztpraxis bestätigen.
        </p>
      </div>

      <div class="feld">
        <label for="ausweis">Liegt ein EU-Heimtierausweis vor?</label>
        <select id="ausweis">
          <option value="unbekannt">weiß ich nicht</option>
          <option value="ja">ja</option>
          <option value="nein">nein</option>
        </select>
      </div>

      <div class="feld">
        <label for="begleitung">Reist das Tier mit Ihnen?</label>
        <select id="begleitung">
          <option value="unbekannt">weiß ich nicht</option>
          <option value="ja">ja</option>
          <option value="nein">nein</option>
        </select>
      </div>
    </fieldset>

    <p id="ohne-javascript" class="hilfe">
      Das Ausrechnen braucht JavaScript. Umfang, Ausnahmen und die amtlichen Verweise auf dieser
      Seite bleiben auch ohne lesbar.
    </p>
    <p><button type="submit" id="pruefen" hidden>Angaben prüfen</button></p>
  </form>

  <div id="schritt-ergebnis" class="schritt schritt--ergebnis">
    <h3><span class="schritt__nummer">Schritt 4</span> Ergebnis</h3>
    <div id="reiseergebnis" role="status" aria-live="polite"></div>
  </div>
</section>

<h2>Geprüfter Umfang (Fassung {umfang.scopeVersion})</h2>
<dl class="umfang">
  <dt>Von</dt>
  <dd>{name(umfang.origin)}</dd>
  <dt>Nach</dt>
  <dd>{ziele.join(', ')}</dd>
  <dt>Richtung</dt>
  <dd>Hinreise und Rückreise</dd>
  <dt>Durchreise</dt>
  <dd>{transit.join(', ')}</dd>
  <dt>Tiere</dt>
  <dd>
    eigener Hund oder eigene Katze, ab {umfang.minAgeMonths} Monaten, bis zu {umfang.maxAnimals} Tiere
  </dd>
  <dt>Anlass</dt>
  <dd>private Reise mit Begleitperson</dd>
</dl>

<h2>Ausdrücklich nicht geprüft</h2>
<p>
  Diese Fälle prüft der Check nicht. Das ist keine Aussage darüber, ob sie zulässig sind — nur
  darüber, dass hier niemand sie beurteilt.
</p>
<ul class="ausnahmen">
  {
    umfang.unsupported.map((fall) => (
      <li data-testid={`nicht-geprueft-${fall.caseId}`}>
        <strong>{fall.label}.</strong> {fall.reason}
      </li>
    ))
  }
</ul>

{umfang.notes.map((hinweis) => <p class="hinweis">{hinweis}</p>)}

<script>
  import { schritteVerfolgen } from '../../features/travel/stepper.ts';
  import { reisecheckStarten } from '../../features/travel/wizard-ui.ts';

  schritteVerfolgen();

  reisecheckStarten();
</script>

<style>
  .feld {
    margin-block: var(--space-4);
  }

  .feld label,
  .schritt {
    margin-block: var(--space-8);
  }

  .feld__frage {
    margin-block: 0 var(--space-2);
    font-weight: var(--weight-label);
  }

  .karten {
    display: grid;
    gap: var(--space-3);
    margin-block: var(--space-3);
  }

  @media (min-width: 480px) {
    .karten {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    }
  }

  .schritt__nummer {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-small);
    font-weight: var(--weight-label);
  }

  .schritt--ergebnis {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    background: var(--color-surface);
  }

  .schritt--ergebnis h3 {
    margin-block-start: 0;
  }

  legend {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  input[type='date'],
  input[type='number'],
  select {
    width: 100%;
    max-width: 24rem;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  fieldset {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-block: var(--space-4);
  }

  .wahl {
    display: block;
    font-weight: 400;
    margin-block: var(--space-1);
  }

  .hilfe {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin-block: var(--space-1);
  }

  #reiseergebnis :global(.ergebnis__kopf) {
    font-weight: 700;
    border-inline-start: 4px solid var(--color-border);
    padding-inline-start: var(--space-3);
  }

  #reiseergebnis :global(.ergebnis__punkte),
  #reiseergebnis :global(.ergebnis__gruende) {
    list-style: none;
    padding: 0;
  }

  #reiseergebnis :global(.ergebnis__punkte > li),
  #reiseergebnis :global(.ergebnis__gruende > li) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-block: var(--space-3);
  }

  #reiseergebnis :global(.punkt__zustand) {
    font-weight: 600;
    margin-top: 0;
  }

  .umfang {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    margin-block: var(--space-4);
  }

  .umfang dt {
    font-weight: 600;
  }

  .umfang dd {
    margin: 0;
  }

  .ausnahmen {
    padding-inline-start: var(--space-5);
  }

  .ausnahmen li {
    margin-block: var(--space-2);
  }

  .hinweis {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
</style>
