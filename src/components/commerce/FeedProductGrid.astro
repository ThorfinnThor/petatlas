---
import type { CatalogCategory } from '../../../scripts/awin/fressnapf.ts';
import type { CatalogProductOffer } from '../../features/commerce/feed-catalog.ts';
import { PARTNER_LINK_ATTRIBUTE } from '../../features/commerce/links.ts';

interface Props {
  offers: readonly CatalogProductOffer[];
  category: CatalogCategory;
  title: string;
  retailerLabel: string;
  perSpeciesLimit?: number;
  deduplicateVariants?: boolean;
}

const {
  offers,
  category,
  title,
  retailerLabel,
  perSpeciesLimit,
  deduplicateVariants = false,
} = Astro.props;
const allProducts = offers.filter((offer) => offer.category === category);

const variantKey = (product: CatalogProductOffer): string =>
  `${product.species}:${product.brand}:${product.productName}`
    .toLocaleLowerCase('de-DE')
    .replace(/\b\d+\s*x\s*\d+(?:[.,]\d+)?\s*(?:kg|g|ml|l)\b/giu, '')
    .replace(/\b\d+(?:[.,]\d+)?\s*(?:kg|g|ml|l)\b/giu, '')
    .replace(/\s+/g, ' ')
    .trim();

const distinctProducts = deduplicateVariants
  ? allProducts.filter(
      (product, index, products) =>
        products.findIndex((candidate) => variantKey(candidate) === variantKey(product)) === index,
    )
  : allProducts;

const products =
  perSpeciesLimit === undefined
    ? distinctProducts
    : (['dog', 'cat'] as const).flatMap((species) =>
        distinctProducts.filter((product) => product.species === species).slice(0, perSpeciesLimit),
      );
const selectionIsLimited = products.length < allProducts.length;
---

{
  products.length > 0 && (
    <section
      class="feed-catalog"
      aria-labelledby={`feed-${category}-${retailerLabel.toLowerCase()}`}
    >
      <div class="feed-catalog__heading">
        <p class="eyebrow">{retailerLabel} · Sortiment</p>
        <h2 id={`feed-${category}-${retailerLabel.toLowerCase()}`}>{title}</h2>
        <p>
          Eine Auswahl realer Artikel aus dem freigegebenen Händlerfeed. Wir zeigen Produktname,
          Tierart und Herstellerbild; Preise und Verfügbarkeit prüfst du direkt beim Händler.
          {selectionIsLimited &&
            ` Sichtbar sind ${products.length} von ${allProducts.length} Feedartikeln.`}
        </p>
      </div>
      <ul class="feed-catalog__grid">
        {products.map((product) => (
          <li class="feed-catalog__card">
            <a
              class="feed-catalog__image-link"
              href={product.affiliateUrl}
              {...PARTNER_LINK_ATTRIBUTE}
              aria-label={`${product.productName} bei ${retailerLabel} ansehen`}
            >
              <img
                src={product.imageUrl}
                alt={`${product.productName} · Produktbild von ${retailerLabel}`}
                width="480"
                height="480"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </a>
            <div class="feed-catalog__body">
              <p class="feed-catalog__species">
                {product.species === 'dog' ? 'Für Hunde' : 'Für Katzen'}
              </p>
              <h3>{product.productName}</h3>
              <p class="feed-catalog__meta">
                {product.brand} · {product.categoryLabel}
              </p>
              <a class="feed-catalog__link" href={product.affiliateUrl} {...PARTNER_LINK_ATTRIBUTE}>
                Bei {retailerLabel} ansehen ↗ <span class="sr-only">(Werbung)</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .feed-catalog {
    margin-block: var(--space-8);
    min-inline-size: 0;
  }

  .feed-catalog__heading {
    max-inline-size: 70ch;
    margin-block-end: var(--space-4);
  }

  .feed-catalog__heading h2 {
    margin-block: var(--space-1) var(--space-2);
  }

  .feed-catalog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feed-catalog__card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .feed-catalog__image-link {
    display: grid;
    place-items: center;
    padding: var(--space-4);
    background: var(--color-surface-subtle);
  }

  /* Gleich hohe, ruhige Produktbilder statt quadratischer Riesenflächen. */
  .feed-catalog__image-link img {
    display: block;
    inline-size: 100%;
    block-size: 9.5rem;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .feed-catalog__body {
    display: flex;
    flex-direction: column;
    min-block-size: 10rem;
    padding: var(--space-3) var(--space-4) var(--space-4);
    min-inline-size: 0;
  }

  .feed-catalog__species {
    margin: 0 0 var(--space-1);
    color: var(--color-primary-hover);
    font-size: var(--text-small);
    font-weight: 700;
  }

  .feed-catalog__body h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-h4);
    overflow-wrap: normal;
    word-break: normal;
    hyphens: auto;
  }

  .feed-catalog__meta {
    color: var(--color-text-muted);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .feed-catalog__link {
    margin-block-start: auto;
    padding-block-start: var(--space-3);
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  @media (min-width: 600px) {
    .feed-catalog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 920px) {
    .feed-catalog__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .feed-catalog__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
