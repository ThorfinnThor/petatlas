---
import type { CatalogCategory } from '../../../scripts/awin/fressnapf.ts';
import {
  katalogAuswahl,
  katalogMeta,
  startauswahl,
  type CatalogProductOffer,
} from '../../features/commerce/feed-catalog.ts';
import { PARTNER_LINK_ATTRIBUTE } from '../../features/commerce/links.ts';

interface Props {
  offers: readonly CatalogProductOffer[];
  category: CatalogCategory;
  title: string;
  retailerLabel: string;
  perSpeciesLimit?: number;
  deduplicateVariants?: boolean;
  /** Filter nach Tierart und Händlerrubrik sowie „Mehr anzeigen“; für große Kataloge. */
  filterbar?: boolean;
  /** Mit `filterbar`: so viele Karten sind zunächst sichtbar. */
  startAnzahl?: number;
  /** Der Spielzeugfinder übernimmt diese Karten in seine Ergebnisse (mit JavaScript). */
  finderQuelle?: boolean;
  /**
   * Mit `filterbar`: Im HTML steht nur die Startauswahl; die übrigen Produkte
   * lädt der Browser bei Bedarf aus dieser JSON-Datei nach.
   */
  nachladen?: string;
}

const {
  offers,
  category,
  title,
  retailerLabel,
  perSpeciesLimit,
  deduplicateVariants = false,
  filterbar = false,
  startAnzahl = 12,
  finderQuelle = false,
  nachladen,
} = Astro.props;
const allProducts = offers.filter((offer) => offer.category === category);
const products = katalogAuswahl(offers, category, { perSpeciesLimit, deduplicateVariants });
const selectionIsLimited = products.length < allProducts.length;
const sectionId = `feed-${category}-${retailerLabel.toLowerCase()}`;
const meta = katalogMeta;
// Mit Nachladen steht nur die Startauswahl im HTML (Hund und Katze im Wechsel).
const gerendert =
  filterbar && nachladen !== undefined ? startauswahl(products, startAnzahl) : products;
const rubriken = filterbar
  ? [
      ...products.reduce((zaehler, product) => {
        if (product.subcategoryLabel)
          zaehler.set(product.subcategoryLabel, (zaehler.get(product.subcategoryLabel) ?? 0) + 1);
        return zaehler;
      }, new Map<string, number>()),
    ]
      .filter(([, anzahl]) => anzahl >= 2)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 8)
      .map(([rubrik]) => rubrik)
  : [];
const hatBeideArten = new Set(products.map((p) => p.species)).size > 1;
---

{
  products.length > 0 && (
    <section
      class="feed-catalog"
      aria-labelledby={sectionId}
      data-feed-catalog={filterbar ? String(startAnzahl) : undefined}
      data-finder-katalog={finderQuelle ? retailerLabel : undefined}
      data-katalog-quelle={filterbar && nachladen !== undefined ? nachladen : undefined}
      data-katalog-gesamt={
        filterbar && nachladen !== undefined ? String(products.length) : undefined
      }
      data-haendler={retailerLabel}
    >
      <div class="feed-catalog__heading">
        <p class="eyebrow">{retailerLabel} · Sortiment</p>
        <h2 id={sectionId}>{title}</h2>
        <p>
          Eine Auswahl realer Artikel aus dem {retailerLabel}-Produktfeed über Awin. Wir zeigen
          Produktname, Tierart und das Produktbild aus dem Feed; Preise und Verfügbarkeit prüfst du
          direkt beim Händler.
          {selectionIsLimited &&
            ` Sichtbar sind ${products.length} von ${allProducts.length} Feedartikeln.`}
        </p>
      </div>
      {filterbar && (hatBeideArten || rubriken.length > 0) && (
        <div class="feed-catalog__filter" role="group" aria-label={`${title} filtern`} hidden>
          <button type="button" aria-pressed="true" data-filter="alle">
            Alle
          </button>
          {hatBeideArten && (
            <>
              <button type="button" aria-pressed="false" data-filter="art:dog">
                Hunde
              </button>
              <button type="button" aria-pressed="false" data-filter="art:cat">
                Katzen
              </button>
            </>
          )}
          {rubriken.map((rubrik) => (
            <button type="button" aria-pressed="false" data-filter={`rubrik:${rubrik}`}>
              {rubrik}
            </button>
          ))}
        </div>
      )}
      <ul class={`feed-catalog__grid${products.length < 4 ? ' feed-catalog__grid--wenige' : ''}`}>
        {gerendert.map((product) => (
          <li
            class="feed-catalog__card"
            data-id={product.productId}
            data-art={product.species}
            data-rubrik={product.subcategoryLabel ?? ''}
          >
            <a
              class="feed-catalog__image-link"
              href={product.affiliateUrl}
              {...PARTNER_LINK_ATTRIBUTE}
              aria-label={`${product.productName} bei ${retailerLabel} ansehen`}
            >
              <img
                src={product.imageUrl}
                alt={`${product.productName} · Produktbild von ${retailerLabel}`}
                width="480"
                height="480"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
              <span class="feed-catalog__bildquelle" aria-hidden="true">
                Produktbild · {retailerLabel}-Feed
              </span>
            </a>
            <div class="feed-catalog__body">
              <p class="feed-catalog__species">
                {product.species === 'dog' ? 'Für Hunde' : 'Für Katzen'}
              </p>
              <h3>{product.productName}</h3>
              <p class="feed-catalog__meta">{meta(product)}</p>
              <a class="feed-catalog__link" href={product.affiliateUrl} {...PARTNER_LINK_ATTRIBUTE}>
                Bei {retailerLabel} ansehen ↗ <span class="sr-only">(Werbung)</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
      {filterbar && (
        <p class="feed-catalog__mehr" hidden>
          <button type="button" data-mehr>
            Mehr anzeigen
          </button>
        </p>
      )}
    </section>
  )
}

<script>
  import { karteAusVorlage, ladeKatalog } from '../../features/commerce/katalog-nachladen.ts';

  // Ohne JavaScript bleiben alle Karten sichtbar; Filter und „Mehr“ erscheinen erst hier.
  for (const sektion of document.querySelectorAll<HTMLElement>('[data-feed-catalog]')) {
    const start = Number(sektion.dataset.feedCatalog) || 12;
    const karten = [...sektion.querySelectorAll<HTMLElement>('.feed-catalog__card')];
    const filterLeiste = sektion.querySelector<HTMLElement>('.feed-catalog__filter');
    const mehrZeile = sektion.querySelector<HTMLElement>('.feed-catalog__mehr');
    const mehr = sektion.querySelector<HTMLButtonElement>('[data-mehr]');
    const quelle = sektion.dataset.katalogQuelle;
    // Mit Nachladen steht nur die Startauswahl im HTML; bis zum Laden zählt die Gesamtzahl.
    let gesamt = Number(sektion.dataset.katalogGesamt) || karten.length;
    let geladen = quelle === undefined;
    let filter = 'alle';
    let sichtbar = start;

    // Erst bei Bedarf: Auf der Spielzeugseite übernimmt der Finder die Karten,
    // und diese Bereiche bleiben ausgeblendet.
    const ergaenzen = async (): Promise<void> => {
      if (geladen || quelle === undefined) return;
      geladen = true;
      const vorlage = karten[0];
      const liste = sektion.querySelector<HTMLElement>('.feed-catalog__grid');
      if (!vorlage || !liste) return;
      try {
        const vorhanden = new Set(karten.map((karte) => karte.dataset.id));
        for (const eintrag of await ladeKatalog(quelle)) {
          if (eintrag.haendler !== sektion.dataset.haendler || vorhanden.has(eintrag.id)) continue;
          const karte = karteAusVorlage(vorlage, eintrag);
          liste.append(karte);
          karten.push(karte);
        }
      } catch {
        // Ohne Datei bleibt es bei der Startauswahl.
      }
      gesamt = karten.length;
    };

    const passt = (karte: HTMLElement) =>
      filter === 'alle' ||
      (filter.startsWith('art:') && karte.dataset.art === filter.slice(4)) ||
      (filter.startsWith('rubrik:') && karte.dataset.rubrik === filter.slice(7));
    const zeigen = () => {
      const treffer = karten.filter(passt);
      for (const karte of karten) karte.hidden = true;
      treffer.slice(0, sichtbar).forEach((karte) => (karte.hidden = false));
      const anzahl = geladen ? treffer.length : gesamt;
      if (mehrZeile) mehrZeile.hidden = anzahl <= sichtbar;
      if (mehr) {
        const rest = anzahl - sichtbar;
        mehr.textContent = rest > 0 ? `Mehr anzeigen (${rest} weitere)` : 'Mehr anzeigen';
      }
    };
    if (filterLeiste) {
      filterLeiste.hidden = false;
      filterLeiste.addEventListener('click', async (event) => {
        const knopf = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
        if (!knopf) return;
        filter = knopf.dataset.filter ?? 'alle';
        sichtbar = start;
        for (const anderer of filterLeiste.querySelectorAll('[data-filter]'))
          anderer.setAttribute('aria-pressed', String(anderer === knopf));
        await ergaenzen();
        zeigen();
      });
    }
    mehr?.addEventListener('click', async () => {
      await ergaenzen();
      sichtbar += start;
      zeigen();
    });
    zeigen();
  }
</script>

<style>
  .feed-catalog {
    margin-block: var(--space-8);
    min-inline-size: 0;
  }

  .feed-catalog__heading {
    max-inline-size: 70ch;
    margin-block-end: var(--space-4);
  }

  .feed-catalog__heading h2 {
    margin-block: var(--space-1) var(--space-2);
  }

  .feed-catalog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feed-catalog__card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .feed-catalog__image-link {
    position: relative;
    display: grid;
    place-items: center;
    padding: var(--space-4) var(--space-4) var(--space-6);
    border-block-end: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  /* Gleich hohe, ruhige Produktbilder statt quadratischer Riesenflächen. */
  .feed-catalog__image-link img {
    display: block;
    inline-size: 100%;
    block-size: 9.5rem;
    object-fit: contain;
  }

  /* Bildnachweis wie bei den redaktionellen Karten: wer das Bild liefert. */
  .feed-catalog__bildquelle {
    position: absolute;
    inset-inline-end: var(--space-2);
    inset-block-end: var(--space-2);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 92%);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    line-height: 1.2;
  }

  .feed-catalog__body {
    display: flex;
    flex-direction: column;
    min-block-size: 10rem;
    padding: var(--space-3) var(--space-4) var(--space-4);
    min-inline-size: 0;
  }

  .feed-catalog__species {
    margin: 0 0 var(--space-1);
    color: var(--color-primary-hover);
    font-size: var(--text-small);
    font-weight: 700;
  }

  .feed-catalog__body h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-h4);
    overflow-wrap: normal;
    word-break: normal;
    hyphens: auto;
  }

  .feed-catalog__meta {
    color: var(--color-text-muted);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .feed-catalog__link {
    margin-block-start: auto;
    padding-block-start: var(--space-3);
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .feed-catalog__filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block: 0 var(--space-4);
  }

  .feed-catalog__filter button,
  .feed-catalog__mehr button {
    min-block-size: 2.5rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--text-small);
    font-weight: 600;
    cursor: pointer;
  }

  .feed-catalog__filter button[aria-pressed='true'] {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-primary-contrast);
  }

  .feed-catalog__mehr {
    max-inline-size: none;
    margin-block: var(--space-5) 0;
    text-align: center;
  }

  .feed-catalog__card[hidden] {
    display: none;
  }

  /* Bei ein bis drei Produkten keine leeren Rasterspalten: Karten in fester Breite. */
  .feed-catalog__grid.feed-catalog__grid--wenige {
    display: flex;
    flex-wrap: wrap;
    grid-template-columns: none;
  }

  .feed-catalog__grid--wenige .feed-catalog__card {
    flex: 0 1 18rem;
  }

  @media (min-width: 600px) {
    .feed-catalog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 920px) {
    .feed-catalog__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .feed-catalog__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
