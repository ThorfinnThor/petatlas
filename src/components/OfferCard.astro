---
/**
 * M13-04 — Ein Angebot als Karte.
 *
 * Die Karte zeigt einen Preis und sagt dazu, was in ihm **nicht** enthalten
 * ist. Sie behauptet nichts, was die Daten nicht hergeben:
 *
 * - unbekannter Versand wird als unbekannt beschriftet, nicht als kostenlos,
 * - unbekannte Verfügbarkeit wird als nicht angegeben beschriftet,
 * - der Grundpreis erscheint nur bei bekannter Menge,
 * - der Stand des Preises steht dabei, weil ein Feedpreis altern kann.
 *
 * Ohne Anzeigeerlaubnis rendert die Karte gar nichts.
 */
import type { Offer, Product } from '../domain/schemas/catalog.ts';
import {
  VERFUEGBARKEIT_LABEL,
  abgelaufen,
  formatiereBetrag,
  grundpreis,
  preisAussage,
  versandkostenfrei,
} from '../features/commerce/pricing.ts';
import { PARTNER_LINK_ATTRIBUTE } from '../features/commerce/links.ts';
import { ABLAUF_ATTRIBUT } from '../features/freshness/offer-expiry.ts';

interface Props {
  angebot: Offer;
  produkt: Product;
  /** Zeitpunkt, gegen den Ablauf geprüft wird. */
  jetzt: string;
}

const { angebot, produkt, jetzt } = Astro.props;

const sichtbar = angebot.displayPermission && !abgelaufen(angebot, jetzt);
const aussage = preisAussage(angebot);
const basis = grundpreis(angebot, produkt);
const stand = angebot.fetchedAt.slice(0, 10);
---

{
  sichtbar && (
    <article
      class="angebot"
      data-testid={`angebot-${angebot.offerId}`}
      {...(angebot.expiresAt === null ? {} : { [ABLAUF_ATTRIBUT]: angebot.expiresAt })}
    >
      <p class="angebot__kennzeichnung">Anzeige</p>
      <h3>
        {produkt.brand} {produkt.variant === null ? '' : produkt.variant}
      </h3>

      <p class="angebot__preis" data-preis>
        {formatiereBetrag(angebot.priceMinor, angebot.currency)}
        <span class="angebot__bezug"> Artikelpreis</span>
      </p>

      {/* Wird sichtbar, sobald der Preis im Browser abgelaufen ist. */}
      <p class="angebot__abgelaufen" data-preis-ersatz data-testid="preis-abgelaufen" hidden />

      {angebot.shippingMinor === null && (
        <p class="angebot__unbekannt" data-testid="versand-unbekannt">
          Versandkosten nicht angegeben — der Gesamtpreis steht damit nicht fest.
        </p>
      )}
      {versandkostenfrei(angebot) && (
        <p data-preis data-testid="versand-frei">
          Versand laut Händler kostenlos.
        </p>
      )}
      {angebot.shippingMinor !== null && angebot.shippingMinor > 0 && (
        <p data-preis>
          Versand: {formatiereBetrag(angebot.shippingMinor, angebot.currency)} ·{' '}
          {formatiereBetrag(aussage.betragMinor, angebot.currency)} gesamt
        </p>
      )}

      {basis === null ? (
        <p class="angebot__unbekannt">Grundpreis nicht berechenbar: Füllmenge nicht angegeben.</p>
      ) : (
        <p class="angebot__grundpreis" data-preis>
          {formatiereBetrag(basis.proKilogrammMinor, angebot.currency)} je kg · {basis.basis}
        </p>
      )}

      <p class="angebot__meta">
        {VERFUEGBARKEIT_LABEL[angebot.availability]} · Preisstand {stand}
      </p>

      <p>
        <a
          href={angebot.affiliateUrl}
          rel={PARTNER_LINK_ATTRIBUTE.rel}
          target={PARTNER_LINK_ATTRIBUTE.target}
        >
          Zum Händler
        </a>
      </p>
    </article>
  )
}

<script>
  import { verbergeAbgelaufenePreise } from '../features/freshness/offer-expiry.ts';

  // Zur Bauzeit war der Preis gültig; jetzt ist eine andere Zeit. Was
  // abgelaufen ist, verschwindet — ohne Nachladen und ohne Meldung.
  verbergeAbgelaufenePreise(document, new Date().toISOString());
</script>

<style>
  .angebot__abgelaufen {
    font-weight: 600;
    margin-block: var(--space-1);
  }

  .angebot {
    background: var(--color-surface-subtle);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-block: var(--space-4);
  }

  .angebot__kennzeichnung {
    margin: 0 0 var(--space-2);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .angebot h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-body);
  }

  .angebot__preis {
    font-size: 1.25rem;
    font-weight: 700;
    margin-block: var(--space-1);
  }

  .angebot__bezug {
    font-size: var(--text-small);
    font-weight: 400;
  }

  .angebot__grundpreis,
  .angebot__meta,
  .angebot__unbekannt {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin-block: var(--space-1);
  }

  .angebot__unbekannt {
    font-style: italic;
  }
</style>
