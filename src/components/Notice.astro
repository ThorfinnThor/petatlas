---
/**
 * M04-02 / M21-01 — Hinweis-, Warn- und Ergebnisbox.
 *
 * Seit der Komponentenbibliothek ist das hier nur noch die Übersetzung der
 * gewachsenen Rollen in die vier Varianten des Designvertrags (Abschnitt
 * 16). Die Darstellung liegt in `ui/Alert.astro`; zwei Boxen mit
 * unterschiedlichem Aussehen für dieselbe Aussage soll es nicht geben.
 *
 * `testdaten` bleibt eine eigene Rolle, weil sie eine eigene Aussage ist:
 * „was hier steht, ist erfunden“. Der Vertrag kennt dafür keine fünfte
 * Farbe, deshalb wird sie als Warnung dargestellt — der Unterschied steht
 * im Text, nicht in der Farbe (Farbregel 5).
 *
 * Angesagt wird das Testdatenbanner nicht: es steht seit dem Laden da und
 * ändert sich nie. Ein Live-Bereich, in dem nie etwas passiert, übertönt
 * die, in denen etwas passiert.
 */
import Alert from './ui/Alert.astro';
import type { AlertVariante } from './ui/varianten.ts';

interface Props {
  variante: 'hinweis' | 'warnung' | 'ergebnis' | 'testdaten';
  titel: string;
  /** Für Tests und gezielte Ansteuerung. */
  testId?: string;
}

const ZU_ALERT: Readonly<Record<Props['variante'], AlertVariante>> = {
  hinweis: 'info',
  warnung: 'warnung',
  ergebnis: 'erfolg',
  testdaten: 'warnung',
};

const { variante, titel, testId } = Astro.props;
---

<Alert
  variante={ZU_ALERT[variante]}
  titel={titel}
  ansage={variante === 'testdaten' ? false : undefined}
  testId={testId}
>
  <slot />
</Alert>
