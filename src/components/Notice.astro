---
/**
 * M04-02 — Hinweis-, Warn- und Ergebnisbox.
 *
 * Drei Rollen mit klar unterschiedlicher Darstellung. `warnung` und
 * `ergebnis` bekommen `role="status"`, damit Screenreader ein neu
 * berechnetes Ergebnis auch ansagen.
 */
interface Props {
  variante: 'hinweis' | 'warnung' | 'ergebnis' | 'testdaten';
  titel?: string;
  /** Für Tests und gezielte Ansteuerung. */
  testId?: string;
}

const { variante, titel, testId } = Astro.props;
const ansage = variante === 'ergebnis' || variante === 'warnung';
---

<div
  class:list={['notiz', `notiz--${variante}`]}
  role={ansage ? 'status' : undefined}
  aria-live={variante === 'ergebnis' ? 'polite' : undefined}
  data-testid={testId}
>
  {titel && <p class="notiz__titel">{titel}</p>}
  <slot />
</div>

<style>
  .notiz {
    border: 1px solid var(--color-border);
    border-inline-start-width: 4px;
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
    margin-block: var(--space-6);
  }

  .notiz__titel {
    margin: 0 0 var(--space-2);
    font-weight: 600;
  }

  .notiz :global(p:last-child) {
    margin-bottom: 0;
  }

  .notiz--hinweis {
    background: var(--color-info-soft);
    border-inline-start-color: var(--color-info);
  }

  .notiz--warnung,
  .notiz--testdaten {
    background: var(--color-warning-soft);
    border-inline-start-color: var(--color-warning);
  }

  .notiz--ergebnis {
    background: var(--color-success-soft);
    border-inline-start-color: var(--color-success);
  }
</style>
