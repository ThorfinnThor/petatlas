---
/**
 * M04-05 — Fehlerzusammenfassung.
 *
 * Steht über dem Formular, sammelt alle Fehler und verlinkt sie. Nach einem
 * fehlgeschlagenen Absenden bekommt sie den Fokus, damit auch jemand ohne
 * Maus und ohne Blick auf den Bildschirm sofort erfährt, was fehlt.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div id={id} class="fehlerliste" role="alert" tabindex="-1" hidden>
  <p class="fehlerliste__titel">Bitte prüfen Sie Ihre Eingaben</p>
  <ul></ul>
</div>

<style>
  .fehlerliste {
    border: 2px solid var(--farbe-fehler);
    border-radius: var(--radius);
    padding: var(--abstand-3) var(--abstand-4);
    margin-block: var(--abstand-4);
  }

  .fehlerliste__titel {
    margin: 0 0 var(--abstand-2);
    font-weight: 700;
    color: var(--farbe-fehler);
  }

  .fehlerliste ul {
    margin: 0;
    padding-inline-start: var(--abstand-4);
  }
</style>
