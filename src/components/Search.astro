---
/**
 * M04-04 — Suche.
 *
 * Die Suche läuft vollständig im Browser gegen den statisch gebauten
 * Pagefind-Index. Es gibt keinen Suchserver, keine Anfrage an einen Dritten
 * und keine Übertragung der Eingabe.
 *
 * Ohne JavaScript bleibt die Seite bedienbar: das Suchfeld erscheint erst,
 * wenn das Skript läuft, statt ein totes Formular anzubieten.
 */
---

<section class="suche" data-pagefind-ignore="all">
  <h2 id="suche-titel">Suche</h2>
  <noscript>
    <p>Die Suche benötigt JavaScript. Die Inhalte sind über die Navigation erreichbar.</p>
  </noscript>
  <form id="suche-form" role="search" aria-labelledby="suche-titel" hidden>
    <label for="suche-feld">Suchbegriff</label>
    <input id="suche-feld" type="search" autocomplete="off" enterkeyhint="search" />
  </form>
  <p id="suche-status" role="status" aria-live="polite"></p>
  <ul id="suche-treffer" class="suche__treffer"></ul>
</section>

<style>
  .suche {
    margin-block-start: var(--space-16);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-subtle);
    /* Ein Suchfeld über die volle Rasterbreite liest sich schlecht. */
    max-inline-size: var(--content-reading);
  }

  .suche :global(h2) {
    margin-block-start: 0;
  }

  .suche label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .suche input {
    width: 100%;
    max-width: 26rem;
    padding: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .suche__treffer {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
  }

  .suche__treffer li {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .suche__treffer :global(mark) {
    background: var(--color-warning-soft);
    color: inherit;
  }
</style>

<script is:inline type="module" src="/suche.js"></script>
