---
/**
 * M04-02 — Werbefläche.
 *
 * Die Fläche erscheint nur, wenn der Markt das Feature `ads` ausdrücklich
 * eingeschaltet hat. Ein Layoutplatzhalter wird nicht mit einer echten
 * Anzeige verwechselt: ohne Freigabe wird gar nichts gerendert.
 *
 * Wenn sie erscheint, trägt sie sichtbar das Wort „Anzeige“ und ist optisch
 * deutlich von redaktionellen Boxen getrennt.
 */
import { isFeatureEnabled, type MarketConfig } from '../domain/market.ts';

interface Props {
  market: MarketConfig;
  platzierung: string;
}

const { market, platzierung } = Astro.props;
const sichtbar = isFeatureEnabled(market, 'ads');
---

{
  sichtbar && (
    <aside class="anzeige" aria-label="Anzeige" data-testid={`anzeige-${platzierung}`}>
      <p class="anzeige__kennzeichnung">Anzeige</p>
      <slot />
    </aside>
  )
}

<style>
  .anzeige {
    background: var(--color-surface-subtle);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    padding: var(--space-3);
    margin-block: var(--space-6);
  }

  .anzeige__kennzeichnung {
    margin: 0 0 var(--space-2);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
