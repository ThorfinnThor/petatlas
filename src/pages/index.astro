---
/**
 * M01-01/M01-05 — Minimale statische Startseite. Sie belegt, dass der Build
 * reines HTML erzeugt. Informationsarchitektur und Inhalte folgen in M04.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveBuildConfig } from '../../config/build.ts';

const build = resolveBuildConfig();
---

<BaseLayout title="Aufbau">
  <main>
    <h1>PetAtlas</h1>
    <p>
      Diese Seite ist ein Aufbaustand. Es sind noch keine Inhalte, Daten oder Rechner
      veröffentlicht. Build-Modus: {build.mode}, Datenquelle: {build.dataSource}.
    </p>
    {
      build.mode !== 'production' && (
        <p>
          <a href="/entwicklung/formularprobe/">Technische Formularprobe</a>
        </p>
      )
    }
  </main>
</BaseLayout>
