---
/**
 * M04-05/M01-06 — Formularprobe.
 *
 * Zeigt die wiederverwendbaren Formularbausteine im echten Build:
 * Label-Zuordnung, Pflichtfeldkennzeichnung, Fehlerzusammenfassung mit
 * Fokusführung und die Ergebnisansage für Screenreader.
 *
 * Gerechnet wird die Einheitenumrechnung aus der Architektur (Gewichte
 * intern in Gramm). Das ist echte Projektlogik, keine erfundene
 * Beispielrechnung. Es werden keine Daten übertragen.
 *
 * Wird in production nicht ausgeliefert.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ErrorSummary from '../../components/forms/ErrorSummary.astro';
import Field from '../../components/forms/Field.astro';
import Notice from '../../components/Notice.astro';
import { resolveBuildConfig } from '../../../config/build.ts';

const build = resolveBuildConfig();
const isProduction = build.mode === 'production';
---

<BaseLayout title={isProduction ? 'Seite nicht gefunden' : 'Formularprobe'} neverIndex>
  {
    isProduction ? (
      <>
        <h1>Seite nicht gefunden</h1>
        <p>Diese technische Testseite wird in production nicht ausgeliefert.</p>
      </>
    ) : (
      <>
        <h1>Formularprobe</h1>
        <Notice variante="hinweis">
          <p>
            Technische Testseite für den Browser-Smoke. Kein fachlicher Inhalt, keine
            Datenübertragung, nicht indexierbar.
          </p>
        </Notice>

        <ErrorSummary id="probe-fehler" />

        <form id="probe" data-validierung data-fehlerliste="probe-fehler" novalidate>
          <Field
            id="kilogramm"
            name="kilogramm"
            label="Gewicht in Kilogramm"
            hilfe="Dezimaltrennzeichen Komma oder Punkt, größer als 0."
            fehlertext="Bitte eine Zahl größer als 0 eingeben."
            regel="zahl-positiv"
            inputmode="decimal"
            pflicht
          />
          <Field
            id="faktor"
            name="faktor"
            label="Faktor"
            hilfe="Zwischen 1 und 4. Leer lassen bedeutet Faktor 1."
            fehlertext="Der Faktor muss zwischen 1 und 4 liegen."
            regel="zahl-bereich"
            inputmode="decimal"
            min={1}
            max={4}
          />
          <p>
            <button type="submit">In Gramm umrechnen</button>
          </p>
        </form>

        <p id="ergebnis" data-testid="ergebnis" role="status" aria-live="polite" />
      </>
    )
  }
</BaseLayout>

<script type="module" src="/formular.js"></script>
<script type="module" src="/formularprobe.js"></script>
