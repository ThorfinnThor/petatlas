---
/**
 * M13-04 — Probe für die Angebotskarte.
 *
 * Zeigt dieselbe Karte in den Zuständen, die im Betrieb vorkommen: bekannter
 * und unbekannter Versand, versandkostenfrei, unbekannte Menge, unbekannte
 * Verfügbarkeit, abgelaufen und ohne Anzeigeerlaubnis.
 *
 * Alle Daten sind **synthetisch** und zeigen auf `beispiel.invalid`.
 *
 * Wird in production nicht ausgeliefert.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Notice from '../../components/Notice.astro';
import OfferCard from '../../components/OfferCard.astro';
import ProductCard from '../../components/commerce/ProductCard.astro';
import { resolveBuildConfig } from '../../../config/build.ts';
import { OfferSchema, ProductSchema } from '../../domain/schemas/catalog.ts';
import { vergleicheAngebote } from '../../features/commerce/pricing.ts';

const build = resolveBuildConfig();
const isProduction = build.mode === 'production';
const JETZT = '2026-09-07T12:00:00+00:00';

const produkt = ProductSchema.parse({
  productId: 'awin:901:SYN-100',
  species: 'dog',
  category: 'dry_food',
  brand: 'Beispielmarke (synthetisch)',
  gtin: null,
  variant: 'Trockenfutter 2 kg',
  netContentGrams: 2000,
  packUnits: 1,
  material: null,
  verifiedAttributes: {},
});

const ohneMenge = ProductSchema.parse({
  ...produkt,
  productId: 'awin:903:SYN-102',
  variant: 'Leine 3 m',
  netContentGrams: null,
  packUnits: null,
});

const basisAngebot = {
  productId: produkt.productId,
  merchantId: '901',
  marketId: 'DE',
  currency: 'EUR',
  availability: 'in_stock' as const,
  kind: 'regular' as const,
  affiliateUrl: 'https://beispiel.invalid/p/1',
  fetchedAt: '2026-09-07T00:00:00+00:00',
  expiresAt: null,
  displayPermission: true,
  imagePermission: false,
};

const angebote = [
  OfferSchema.parse({
    ...basisAngebot,
    offerId: 'probe-versand-bekannt',
    priceMinor: 2499,
    shippingMinor: 395,
  }),
  OfferSchema.parse({
    ...basisAngebot,
    offerId: 'probe-versand-frei',
    priceMinor: 2599,
    shippingMinor: 0,
  }),
  OfferSchema.parse({
    ...basisAngebot,
    offerId: 'probe-versand-unbekannt',
    priceMinor: 2399,
    shippingMinor: null,
  }),
  OfferSchema.parse({
    ...basisAngebot,
    offerId: 'probe-ohne-menge',
    productId: ohneMenge.productId,
    priceMinor: 1200,
    shippingMinor: null,
    availability: 'unknown',
  }),
  OfferSchema.parse({
    ...basisAngebot,
    offerId: 'probe-abgelaufen',
    priceMinor: 999,
    shippingMinor: 0,
    expiresAt: '2026-09-07T06:00:00+00:00',
  }),
  // M17-04: zur Bauzeit gültig, beim Ansehen längst abgelaufen. Genau der
  // Fall, den eine statische Seite ohne Browserprüfung falsch darstellt.
  OfferSchema.parse({
    ...basisAngebot,
    offerId: 'probe-im-browser-abgelaufen',
    priceMinor: 1799,
    shippingMinor: 0,
    expiresAt: '2026-09-07T18:00:00+00:00',
  }),
  OfferSchema.parse({
    ...basisAngebot,
    offerId: 'probe-ohne-erlaubnis',
    priceMinor: 888,
    shippingMinor: 0,
    displayPermission: false,
  }),
];

const produkte = [produkt, ohneMenge];
const vergleich = vergleicheAngebote(angebote.slice(0, 2), [produkt], 'DE');
---

<BaseLayout title={isProduction ? 'Seite nicht gefunden' : 'Angebotsprobe'} neverIndex>
  {
    isProduction ? (
      <>
        <h1>Seite nicht gefunden</h1>
        <p>Diese technische Testseite wird in production nicht ausgeliefert.</p>
      </>
    ) : (
      <>
        <h1>Angebotsprobe</h1>

        <Notice variante="testdaten" titel="Synthetische Angebote">
          <p>
            Alle Preise, Händler und Adressen auf dieser Seite sind erfunden. Es besteht kein
            Partnervertrag; im Betrieb entsteht ohne Anzeigeerlaubnis keine einzige Karte.
          </p>
        </Notice>

        <h2>Karten</h2>
        <p>
          Die Karte <code>probe-im-browser-abgelaufen</code> ist zur Bauzeit dieser Seite gültig und
          heute abgelaufen. Sie zeigt, was der Browser mit einem stehen gebliebenen Deployment
          macht.
        </p>
        {angebote.map((angebot) => (
          <OfferCard
            angebot={angebot}
            produkt={produkte.find((eintrag) => eintrag.productId === angebot.productId) ?? produkt}
            jetzt={JETZT}
          />
        ))}

        <h2>Produktkarte (Abschnitt 20)</h2>
        <p>
          Dieselbe Karte in drei Zuständen: mit belegten Merkmalen, mit einem unbekannten Wert und
          ohne jede belegte Übereinstimmung. Alle Angaben sind erfunden.
        </p>
        <div class="produktproben">
          <ProductCard
            name="Beispielball (synthetisch)"
            marke="Beispielmarke"
            merkmale={[
              {
                label: 'Größe',
                wert: 'M',
                beleg: 'Herstellerangabe, beispiel.invalid, geprüft am 2026-09-01.',
              },
              {
                label: 'Waschbar',
                wert: 'ja',
                beleg: 'Herstellerangabe, beispiel.invalid, geprüft am 2026-09-01.',
              },
            ]}
            passtZu={['10–25 kg', 'Apportieren']}
            nichtGeprueft={['Haltbarkeit bei sehr starkem Kauen']}
            werbelink
          >
            <p slot="preis" class="produktproben__preis">
              ab 29,99 € bei Beispielhändler
            </p>
            <a
              slot="aktion"
              class="produktproben__cta"
              href="https://beispiel.invalid/"
              rel="nofollow noopener sponsored"
            >
              Angebot ansehen
            </a>
          </ProductCard>

          <ProductCard
            name="Beispielbürste (synthetisch)"
            marke={null}
            merkmale={[
              {
                label: 'Borstenlänge',
                wert: null,
                beleg: 'Angabe aus dem Händlerfeed, beispiel.invalid, geprüft am 2026-09-01.',
              },
            ]}
            nichtGeprueft={['Hautverträglichkeit']}
          />

          <ProductCard
            name="Beispielseil (synthetisch)"
            marke="Beispielmarke"
            merkmale={[]}
            passtZu={[]}
            nichtGeprueft={['Größe', 'Material']}
          />
        </div>

        <h2>Vergleich</h2>
        <p data-testid="vergleich-grund">{vergleich.grund}</p>
        <p data-testid="vergleich-bezug">Bezug: {vergleich.bezug}</p>
        <p data-testid="vergleich-guenstigstes">
          Günstigstes: {vergleich.guenstigstes?.offerId ?? 'keines'}
        </p>
      </>
    )
  }
</BaseLayout>

<style>
  .produktproben {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-6);
  }

  @media (min-width: 768px) {
    .produktproben {
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    }
  }

  .produktproben__preis {
    margin-block: var(--space-3) 0;
    font-weight: 700;
  }

  .produktproben__cta {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: 18px;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    text-decoration: none;
    font-weight: var(--weight-button);
  }
</style>
