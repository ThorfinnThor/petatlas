---
/**
 * M20-01 — Eine Gruppe des Gebührenkatalogs.
 *
 * Listet die Positionen einer Gruppe mit Grundbetrag und Bezugsgröße. Die
 * Reihenfolge ist die der Verordnung, nicht eine Rangfolge.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/ui/Breadcrumbs.astro';
import DataStatus from '../../../../components/DataStatus.astro';
import ReviewStatus from '../../../../components/ReviewStatus.astro';
import { defaultMarket, isFeatureEnabled, withEnabledFeatures } from '../../../../domain/market.ts';
import { devFeatureOverrides } from '../../../../../config/build.ts';
import { subroutePath } from '../../../../lib/routes.ts';
import { formatMoney, money } from '../../../../domain/money.ts';
import { COST_CONFIG } from '../../../../features/costs/engine.ts';
import { gruppen, type Gruppe } from '../../../../features/costs/detail.ts';
import snapshot from '../../../../../data-snapshots/got/got-2022.json' with { type: 'json' };

export function getStaticPaths() {
  const market = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
  if (!isFeatureEnabled(market, 'costs')) return [];
  return gruppen().map((gruppe) => ({ params: { gruppe: gruppe.slug }, props: { gruppe } }));
}

interface Props {
  gruppe: Gruppe;
}

const { gruppe } = Astro.props;
const market = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
const quelle = snapshot.source as unknown as {
  effectiveFrom: string;
  sourceVersion: string;
  retrievalDate: string;
  url: string;
};
const eigenerPfad = subroutePath(market, 'costs', 'gruppe', gruppe.slug);
const titelIstSehrLang = gruppe.name.length > 95;
---

<BaseLayout
  title={`${gruppe.name} — ${gruppe.teil}`}
  description={`${gruppe.name}: Gebührenpositionen aus ${gruppe.teil} der GOT mit Grundbeträgen und Links zu den Einzelpositionen.`}
  route="costs"
  canonicalPfad={eigenerPfad}
>
  <Breadcrumbs
    market={market}
    stufen={[
      { label: 'Tierarztkosten', route: 'costs' },
      { label: 'Gebührenkatalog', route: 'costs', slugs: ['katalog'] },
      { label: gruppe.name },
    ]}
  />

  <h1>{titelIstSehrLang ? 'GOT-Gebührengruppe' : gruppe.name}</h1>
  {
    titelIstSehrLang && (
      <p class="amtliche-bezeichnung">
        <strong>Amtliche Bezeichnung:</strong> {gruppe.name}
      </p>
    )
  }
  <p>
    {gruppe.positionen.length}{' '}
    {gruppe.positionen.length === 1 ? 'Position' : 'Positionen'} aus {gruppe.teil} der Fassung {
      quelle.sourceVersion
    }. Angegeben ist der Grundbetrag ohne Umsatzsteuer; die Gebührensätze stehen auf der jeweiligen
    Seite.
  </p>

  <ul class="positionen">
    {
      gruppe.positionen.map((eintrag) => (
        <li>
          <a href={subroutePath(market, 'costs', eintrag.slug)}>
            <span class="positionen__nummer">Nr. {eintrag.item.officialItemId}</span>
            <span>{eintrag.item.originalLabel}</span>
          </a>
          <span class="positionen__betrag zahl">
            {formatMoney(money(eintrag.item.baseAmountMinor, eintrag.item.currency), market.locale)}
          </span>
        </li>
      ))
    }
  </ul>

  <DataStatus stand={quelle.effectiveFrom} quelle={quelle.sourceVersion} locale={market.locale} />
  <ReviewStatus
    status={COST_CONFIG.clinicalReview === 'approved' ? 'approved' : 'pending'}
    reviewedAt={COST_CONFIG.reviewedAt}
    reviewedBy={COST_CONFIG.reviewedBy}
    lastVerifiedAt={quelle.retrievalDate.slice(0, 10)}
    responsibility="Noch keiner fachlich prüfenden Person zugeordnet"
    sources={[{ label: quelle.sourceVersion, url: quelle.url }]}
  >
    {
      COST_CONFIG.clinicalReview === 'approved' ? (
        <p>Die amtlichen Positionen und die Rechenregeln wurden fachlich geprüft.</p>
      ) : (
        <p>
          Die amtlichen Positionen sind belegt. Die fachliche Einordnung der Rechenregeln ist noch
          nicht abgenommen.
        </p>
      )
    }
  </ReviewStatus>
</BaseLayout>

<style>
  h1,
  .amtliche-bezeichnung,
  .positionen a {
    overflow-wrap: anywhere;
  }

  .positionen {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .positionen li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    align-items: baseline;
    margin: 0;
    padding-block: var(--space-3);
    border-block-end: 1px solid var(--color-border);
    max-inline-size: none;
    min-inline-size: 0;
  }

  .positionen a {
    min-inline-size: 0;
  }

  .positionen__nummer {
    display: inline-block;
    min-inline-size: 4.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-micro);
  }

  .positionen__betrag {
    white-space: nowrap;
    font-weight: var(--weight-label);
  }
</style>
