---
/**
 * M20-01 — Detailseite einer Gebührenposition.
 *
 * Zeigt genau das, was in der Verordnung steht: Bezeichnung, Betrag,
 * Bezugsgröße, Fundstelle, Geltung. Dazu die Faktorstufen, die sich daraus
 * rechnen lassen, und den Weg in den Rechner.
 *
 * Was hier **nicht** steht: was die Leistung umfasst, wie lange sie dauert,
 * wann sie nötig ist oder was sie „normalerweise“ kostet. Nichts davon
 * steht in der Verordnung, und nichts davon wird erfunden.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import Button from '../../../components/ui/Button.astro';
import TechnicalHeading from '../../../components/ui/TechnicalHeading.astro';
import DataStatus from '../../../components/DataStatus.astro';
import ReviewStatus from '../../../components/ReviewStatus.astro';
import { defaultMarket, isFeatureEnabled, withEnabledFeatures } from '../../../domain/market.ts';
import { devFeatureOverrides } from '../../../../config/build.ts';
import { routePath, subroutePath } from '../../../lib/routes.ts';
import { formatMoney, money } from '../../../domain/money.ts';
import { COST_CONFIG } from '../../../features/costs/engine.ts';
import {
  faktorzeilen,
  nachbarn,
  positionen,
  type Gebuehrenposition,
} from '../../../features/costs/detail.ts';
import { istIndexierbareGotPosition } from '../../../features/seo/index-quality.ts';
import snapshot from '../../../../data-snapshots/got/got-2022.json' with { type: 'json' };

export function getStaticPaths() {
  const market = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
  // Ohne Rechnerfunktion gibt es die Route darüber nicht — und damit auch
  // keine Unterseite.
  if (!isFeatureEnabled(market, 'costs')) return [];

  return positionen().map((eintrag) => ({
    params: { position: eintrag.slug },
    props: { eintrag },
  }));
}

interface Props {
  eintrag: Gebuehrenposition;
}

const { eintrag } = Astro.props as Props;
const market = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
const { item } = eintrag;

const quelle = snapshot.source as unknown as {
  effectiveFrom: string;
  sourceVersion: string;
  legalBasis: string;
  url: string;
  retrievalDate: string;
};

const regulaer = faktorzeilen(item, 'regular');
const notdienst = faktorzeilen(item, 'emergency');
const eigenerPfad = subroutePath(market, 'costs', eintrag.slug);
const rechner = routePath(market, 'costs');
const verwandte = nachbarn(eintrag);
const titelIstSehrLang = item.originalLabel.length > 95;

function betrag(minor: number): string {
  return formatMoney(money(minor, item.currency), market.locale);
}
---

<BaseLayout
  title={`${item.originalLabel} — GOT-Nr. ${item.officialItemId}`}
  description={`GOT-Nr. ${item.officialItemId}: Grundbetrag, Gebührensätze und Berechnungsgrundlagen für „${item.originalLabel}“ nachvollziehen.`}
  route="costs"
  canonicalPfad={eigenerPfad}
  neverIndex={!istIndexierbareGotPosition(eintrag)}
  weit
>
  <Breadcrumbs
    market={market}
    stufen={[
      { label: 'Tierarztkosten', route: 'costs' },
      { label: 'Gebührenkatalog', route: 'costs', slugs: ['katalog'] },
      { label: `Nr. ${item.officialItemId}` },
    ]}
  />

  <header class="position-kopf">
    <p class="position-kopf__eyebrow">
      Gebührenordnung für Tierärzte · GOT 2022 · Nr. {item.officialItemId}
    </p>
    <TechnicalHeading
      text={titelIstSehrLang ? `GOT-Position ${item.officialItemId}` : item.originalLabel}
    />
    {
      titelIstSehrLang && (
        <p class="amtliche-bezeichnung">
          <strong>Amtliche Bezeichnung:</strong> {item.originalLabel}
        </p>
      )
    }
    <p>
      Position {item.officialItemId} der Gebührenordnung für Tierärztinnen und Tierärzte, Fassung {
        quelle.sourceVersion
      }. Der Grundbetrag ist der Betrag der Verordnung — was eine Praxis abrechnet, hängt vom
      Gebührensatz und den tatsächlich erbrachten Leistungen ab.
    </p>
  </header>

  <div class="position">
    <div class="position__main">
      <h2>Gebührensätze</h2>
      <p>
        Die Verordnung erlaubt einen Rahmen. Welcher Satz gilt, entscheidet die Praxis im Einzelfall
        — hier stehen die Stufen, nicht eine Empfehlung.
      </p>

      <div class="saetze">
        <table>
          <caption
            >Regulärer Rahmen: {COST_CONFIG.standardFactorMin}-fach bis {
              COST_CONFIG.standardFactorMax
            }-fach</caption
          >
          <thead>
            <tr>
              <th scope="col">Satz</th>
              <th scope="col" class="zahl">Netto</th>
              <th scope="col" class="zahl">Mit {COST_CONFIG.vatPercent} % Umsatzsteuer</th>
            </tr>
          </thead>
          <tbody>
            {
              regulaer.map((zeile) => (
                <tr>
                  <th scope="row">{zeile.faktor}-fach</th>
                  <td class="zahl">{betrag(zeile.nettoMinor)}</td>
                  <td class="zahl">{betrag(zeile.bruttoMinor)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <table>
          <caption>
            Im einschlägigen Notdienst: {COST_CONFIG.emergencyFactorMin}-fach bis {
              COST_CONFIG.emergencyFactorMax
            }-fach, zuzüglich Notdienstgebühr
          </caption>
          <thead>
            <tr>
              <th scope="col">Satz</th>
              <th scope="col" class="zahl">Netto</th>
              <th scope="col" class="zahl">Mit {COST_CONFIG.vatPercent} % Umsatzsteuer</th>
            </tr>
          </thead>
          <tbody>
            {
              notdienst.map((zeile) => (
                <tr>
                  <th scope="row">{zeile.faktor}-fach</th>
                  <td class="zahl">{betrag(zeile.nettoMinor)}</td>
                  <td class="zahl">{betrag(zeile.bruttoMinor)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="hinweis">
        Die Notdienstgebühr beträgt grundsätzlich {betrag(COST_CONFIG.emergencyFeeMinor)} netto. In derselben
        Angelegenheit wird sie nur einmal angesetzt, auch wenn mehrere Tiere desselben Halters behandelt
        werden. Diese Berechnung bildet eine Angelegenheit ab. Bestätigte Abweichungen sind gesondert
        zu berücksichtigen. Die Gebühr ist in den Beträgen oben <strong>nicht</strong>
        enthalten.
      </p>

      <ReviewStatus
        status={COST_CONFIG.clinicalReview === 'approved' ? 'approved' : 'pending'}
        reviewedAt={COST_CONFIG.reviewedAt}
        reviewedBy={COST_CONFIG.reviewedBy}
        lastVerifiedAt={quelle.retrievalDate.slice(0, 10)}
        responsibility="Noch keiner fachlich prüfenden Person zugeordnet"
        sources={[{ label: quelle.sourceVersion, url: quelle.url }]}
      >
        {
          COST_CONFIG.clinicalReview === 'approved' ? (
            <p>Die Rechenannahmen dieser Seite wurden fachlich geprüft.</p>
          ) : (
            <p>
              Die Rechenannahmen — Faktorbereiche, Notdienstgebühr, Steuerbehandlung und Rundung —
              sind
              <strong>von keiner fachlich geeigneten Person abgenommen</strong>. Diese Seite gibt
              den amtlichen Betrag wieder und rechnet ihn hoch; sie ist keine Auskunft und kein
              Kostenvoranschlag.
            </p>
          )
        }
      </ReviewStatus>

      <h2>Fundstelle</h2>
      <dl class="fundstelle">
        <dt>Verordnung</dt>
        <dd>{quelle.sourceVersion}</dd>
        <dt>Fundstelle</dt>
        <dd>{item.sourceReference}</dd>
        <dt>Gilt ab</dt>
        <dd>{item.validity.from}</dd>
        <dt>Rechtsgrundlage</dt>
        <dd>{quelle.legalBasis}</dd>
        <dt>Bezogen über</dt>
        <dd><a href={quelle.url} rel="nofollow noopener">{quelle.url}</a></dd>
      </dl>

      {
        verwandte.length > 0 && (
          <>
            <h2>Weitere Positionen in dieser Gruppe</h2>
            <ul>
              {verwandte.map((andere) => (
                <li>
                  <a href={subroutePath(market, 'costs', andere.slug)}>
                    Nr. {andere.item.officialItemId} — {andere.item.originalLabel}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
    <aside class="position__aside">
      <div class="gebuehr card">
        <p class="gebuehr__label">Grundbetrag (netto)</p>
        <p class="gebuehr__wert zahl">{betrag(item.baseAmountMinor)}</p>
        <p class="gebuehr__bezug">je {item.baseUnit}</p>
      </div>

      <p class="position__knopf">
        <Button variante="primaer" href={rechner}>Im Rechner verwenden</Button>
      </p>
      <p class="position__hilfe">
        Typische Rechnungen mit mehreren Positionen:
        <a href="/de-de/tierarztkosten/behandlung/impfung-hund/">Kostenbeispiele</a>
      </p>
    </aside>
  </div>

  <DataStatus stand={quelle.effectiveFrom} quelle={quelle.sourceVersion} locale={market.locale} />
</BaseLayout>

<style>
  .amtliche-bezeichnung {
    overflow-wrap: anywhere;
  }

  .amtliche-bezeichnung {
    max-inline-size: 68ch;
  }

  .position-kopf {
    margin-block: var(--space-2) var(--space-8);
    padding: clamp(var(--space-4), 4vw, var(--space-10));
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 0% 0%, rgb(255 255 255 / 65%), transparent 40%),
      var(--color-primary-soft);
  }

  .position-kopf > :global(h1) {
    max-inline-size: 28ch;
    margin-block: 0 var(--space-3);
    font-size: clamp(1.5rem, 1.05rem + 2.2vw, var(--text-h1));
    hyphens: auto;
  }

  .position-kopf > p:last-child {
    max-inline-size: 68ch;
    margin-block-end: 0;
  }

  .position-kopf__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .position {
    display: grid;
    gap: var(--space-8);
  }

  .position__main :is(p, li, dd) {
    max-inline-size: 68ch;
  }

  .position__main {
    min-inline-size: 0;
  }

  .position__main > :global(h2:first-child) {
    margin-block-start: 0;
  }

  .saetze {
    display: grid;
    gap: var(--space-4);
  }

  .saetze table {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    border-collapse: separate;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .position__aside {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .position__knopf,
  .position__hilfe {
    margin: 0;
  }

  .position__hilfe {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .gebuehr {
    margin: 0;
    padding: var(--space-5);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .gebuehr__label {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-micro);
    font-weight: var(--weight-label);
  }

  .gebuehr__wert {
    margin: var(--space-1) 0;
    font-size: var(--text-h2);
    font-weight: var(--weight-h1);
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .gebuehr__bezug {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  table {
    margin-block: var(--space-4) var(--space-8);
    max-inline-size: 100%;
  }

  th,
  td,
  caption {
    overflow-wrap: anywhere;
  }

  caption {
    text-align: start;
    font-weight: var(--weight-label);
    padding-block-end: var(--space-2);
  }

  .hinweis {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  li a {
    overflow-wrap: anywhere;
  }

  .fundstelle {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    margin-block: var(--space-4);
  }

  .fundstelle dt {
    font-weight: var(--weight-label);
    color: var(--color-text-muted);
  }

  .fundstelle dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  @media (min-width: 64rem) {
    .position {
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: start;
    }

    .position__aside {
      position: sticky;
      inset-block-start: calc(var(--header-height-desktop) + var(--space-4));
    }

    .saetze {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    table {
      display: block;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
    }

    .fundstelle {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .fundstelle dd + dt {
      margin-block-start: var(--space-2);
    }
  }
</style>
