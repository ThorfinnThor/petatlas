---
import PageIntro from '../../../../components/ui/PageIntro.astro';
/**
 * M20-01 — Einstieg in den Gebührenkatalog.
 *
 * 1006 Positionen auf einer Seite wären weder les- noch bedienbar. Die
 * Verordnung ist selbst gegliedert; diese Seite zeigt genau diese
 * Gliederung — Teile, Gruppen, Anzahl — und nichts darüber hinaus.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/ui/Breadcrumbs.astro';
import DataStatus from '../../../../components/DataStatus.astro';
import ReviewStatus from '../../../../components/ReviewStatus.astro';
import { defaultMarket, isFeatureEnabled, withEnabledFeatures } from '../../../../domain/market.ts';
import { devFeatureOverrides } from '../../../../../config/build.ts';
import { routePath, subroutePath } from '../../../../lib/routes.ts';
import { positionen, teile } from '../../../../features/costs/detail.ts';
import { COST_CONFIG } from '../../../../features/costs/engine.ts';
import snapshot from '../../../../../data-snapshots/got/got-2022.json' with { type: 'json' };

/**
 * Der Katalog liegt als Restroute vor, obwohl er nur einen einzigen Pfad
 * kennt: eine statische `.astro`-Datei würde immer gebaut werden, auch wenn
 * die Funktion im Markt aus ist — und dann auf eine Route verweisen, die es
 * dort nicht gibt. Als dynamische Route entsteht sie gar nicht erst.
 */
export function getStaticPaths() {
  const market = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
  return isFeatureEnabled(market, 'costs') ? [{ params: { rest: undefined } }] : [];
}

const market = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
const quelle = snapshot.source as unknown as {
  effectiveFrom: string;
  sourceVersion: string;
  retrievalDate: string;
  url: string;
};
const gliederung = teile();
const anzahl = positionen().length;
const eigenerPfad = subroutePath(market, 'costs', 'katalog');
---

<BaseLayout
  title="Gebührenkatalog"
  description="Gebührenkatalog der GOT 2022: Tierarztleistungen, Grundbeträge und Bezugsgrößen mit Quellen und Datenstand."
  route="costs"
  canonicalPfad={eigenerPfad}
  weit
>
  <Breadcrumbs
    market={market}
    stufen={[{ label: 'Tierarztkosten', route: 'costs' }, { label: 'Gebührenkatalog' }]}
  />

  <PageIntro titel="Gebührenkatalog" eyebrow="Tierarztkosten · GOT 2022" bild="health-dog-home">
    <p>
      Alle {anzahl} Positionen der Fassung {quelle.sourceVersion}, gegliedert wie die Verordnung
      selbst. Jede Position hat eine eigene Seite mit Betrag, Gebührensätzen und Fundstelle.
    </p>
    <p>
      Suchst du eine bestimmte Leistung? Im <a href={routePath(market, 'costs')}>Kostenrechner</a>
      findest du sie per Suche.
    </p>
  </PageIntro>

  {
    gliederung.map((teil) => (
      <section class="teil">
        <h2>{teil.name}</h2>
        <ul class="gruppen">
          {teil.gruppen.map((gruppe) => (
            <li>
              <a href={subroutePath(market, 'costs', 'gruppe', gruppe.slug)}>
                <span>{gruppe.name}</span>
                <span class="gruppen__anzahl">
                  {gruppe.positionen.length}{' '}
                  {gruppe.positionen.length === 1 ? 'Position' : 'Positionen'}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <DataStatus stand={quelle.effectiveFrom} quelle={quelle.sourceVersion} locale={market.locale} />
  <ReviewStatus
    status={COST_CONFIG.clinicalReview === 'approved' ? 'approved' : 'pending'}
    reviewedAt={COST_CONFIG.reviewedAt}
    reviewedBy={COST_CONFIG.reviewedBy}
    lastVerifiedAt={quelle.retrievalDate.slice(0, 10)}
    responsibility="Noch keiner fachlich prüfenden Person zugeordnet"
    sources={[{ label: quelle.sourceVersion, url: quelle.url }]}
  >
    {
      COST_CONFIG.clinicalReview === 'approved' ? (
        <p>Der Katalog und die Rechenregeln wurden fachlich geprüft.</p>
      ) : (
        <p>
          Der Katalog gibt amtliche Positionen wieder. Die fachliche Einordnung der Rechenregeln ist
          noch nicht abgenommen.
        </p>
      )
    }
  </ReviewStatus>
</BaseLayout>

<style>
  .teil {
    margin-block: var(--space-8);
  }

  .teil h2 {
    margin-block: 0 var(--space-4);
  }

  /* Flex statt Raster: Teile mit wenigen Gruppen lassen keine leeren Spalten. */
  .gruppen {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gruppen li {
    flex: 1 1 18rem;
    min-inline-size: 0;
    margin: 0;
  }

  .gruppen a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    align-items: baseline;
    block-size: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: break-word;
    hyphens: auto;
    transition: border-color var(--transition-fast);
  }

  .gruppen a:hover {
    border-color: var(--color-primary);
  }

  .gruppen__anzahl {
    flex: none;
    color: var(--color-text-muted);
    font-size: var(--text-micro);
    font-weight: 400;
    white-space: nowrap;
  }
</style>
