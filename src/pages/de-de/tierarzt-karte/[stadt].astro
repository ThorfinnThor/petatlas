---
/**
 * Lokale Stadtseite mit derselben interaktiven Umkreislogik wie die Hauptkarte.
 * Gebaut wird sie nur für Orte, die die Qualitätskriterien der Allowlist erfüllen.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import Notice from '../../../components/Notice.astro';
import DataStatus from '../../../components/DataStatus.astro';
import { darstellung } from '../../../features/map/website.ts';
import { defaultMarket, isFeatureEnabled, withEnabledFeatures } from '../../../domain/market.ts';
import { devFeatureOverrides, resolveBuildConfig } from '../../../../config/build.ts';
import { routePath, subroutePath } from '../../../lib/routes.ts';
import { PFLICHT_KATEGORIEN, STADT_KRITERIEN } from '../../../features/map/city.ts';
import { baubareStadtseiten, type Stadtseite } from '../../../features/map/city-allowlist.ts';
import {
  KATEGORIE_LABEL,
  RADIEN_METER,
  formatiereEntfernung,
  mengeMitLabel,
  notdienstHinweis,
  type ListenOrt,
} from '../../../features/map/list.ts';
import { ART_LABEL, kommunaleFlaechen } from '../../../features/map/municipal.ts';
import { TILES } from '../../../features/map/tiles.ts';
import { formatCalendarDate } from '../../../domain/dates.ts';
import { verzeichnisKontaktLink } from '../../../features/map/contact.ts';
import { createSiteConfig } from '../../../../config/site.ts';
import snapshot from '../../../../data-snapshots/places/places-de.json' with { type: 'json' };
import { oeffentlicheProjektion } from '../../../../scripts/publish/places.ts';
import type { Place } from '../../../domain/schemas/places.ts';
import { applyDirectoryControls } from '../../../features/map/directory-controls.ts';

const MAX_TREFFER = 100;

export function getStaticPaths() {
  const market = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
  if (!isFeatureEnabled(market, 'map')) return [];

  const orte = applyDirectoryControls(snapshot.places as unknown as Place[]).map(
    oeffentlicheProjektion,
  ) as unknown as ListenOrt[];
  const seiten = baubareStadtseiten(orte);

  return seiten.map((seite) => ({
    params: { stadt: seite.slug },
    props: {
      seite,
      nachbarn: seiten.map((andere) => ({ slug: andere.slug, name: andere.stadt.name })),
    },
  }));
}

interface Nachbar {
  readonly slug: string;
  readonly name: string;
}

const { seite, nachbarn } = Astro.props as { seite: Stadtseite; nachbarn: readonly Nachbar[] };
const market = defaultMarket();
const quelle = snapshot.source as {
  name: string;
  licenseId: string;
  attribution: string;
  attributionUrl: string;
  retrievalDate: string;
};
const kartenMarkt = withEnabledFeatures(market, devFeatureOverrides());
const kartenPfad = routePath(kartenMarkt, 'map');
const eigenerPfad = subroutePath(kartenMarkt, 'map', seite.slug);
const umkreis = formatiereEntfernung(STADT_KRITERIEN.radiusMeter);
const build = resolveBuildConfig();
const kontakt = createSiteConfig(build.mode, process.env).operator.contactEmail;
const mengen = PFLICHT_KATEGORIEN.map((kategorie) =>
  mengeMitLabel(seite.befund.jeKategorie[kategorie] ?? 0, kategorie),
);
const bestand = `${mengen.slice(0, -1).join(', ')} und ${mengen[mengen.length - 1]}`;
const initialTreffer = seite.treffer.slice(0, MAX_TREFFER);
const kommunal = kommunaleFlaechen(seite.slug);
const KOMMUNAL_MAX = 30;
---

<BaseLayout
  title={`Tierärzte und Tierbedarf in ${seite.stadt.name}`}
  description={`Tierärzte, Tierbedarf, Tierheime und Hundewiesen in ${seite.stadt.name} und Umgebung – mit Filtern, Karte, Datenstand und Quellen.`}
  route="map"
  canonicalPfad={eigenerPfad}
  weit
>
  <Breadcrumbs
    market={kartenMarkt}
    stufen={[{ label: 'Tierärzte in der Nähe', route: 'map' }, { label: seite.stadt.name }]}
  />

  <header class="city-hero">
    <div>
      <p class="eyebrow">Lokales Verzeichnis · {umkreis} Umkreis</p>
      <h1>Tierärzte und Tierbedarf in {seite.stadt.name}</h1>
      <p>
        Rund um {seite.stadt.name} sind {seite.befund.gesamt} Orte erfasst: {bestand}. Filtern Sie
        die Liste nach Kategorie und Umkreis oder öffnen Sie die Karte direkt auf dieser Seite.
      </p>
      <DataStatus
        stand={quelle.retrievalDate}
        quelle={`${quelle.name} · ${quelle.licenseId}`}
        locale={market.locale}
      />
    </div>
    <div class="city-notices">
      <Notice variante="hinweis" titel="Daten einordnen">
        <p>
          Die Liste zeigt Einträge aus OpenStreetMap. Sie ist{' '}
          <strong>nicht vollständig</strong>; Öffnungszeiten können veraltet sein. Vor einem Besuch
          bitte anrufen. Sortiert wird nach Entfernung, nicht nach Bewertung oder Bezahlung.
        </p>
      </Notice>
      <Notice variante="warnung" titel="Kein Notdienstverzeichnis">
        <p>
          Im Notfall gilt der Notdienstplan der zuständigen Tierärztekammer oder die telefonische
          Auskunft einer Praxis.
        </p>
      </Notice>
    </div>
  </header>

  <section class="city-directory" aria-labelledby="verzeichnis-titel">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Filtern und ansehen</p>
        <h2 id="verzeichnis-titel">Orte rund um {seite.stadt.name}</h2>
      </div>
      <a href={kartenPfad}>Anderen Ort suchen</a>
    </div>

    <div class="city-tools">
      <form
        id="ortsfilter"
        class="city-filter"
        aria-labelledby="filter-titel"
        data-initial-name={seite.stadt.name}
        data-initial-latitude={seite.stadt.latitude}
        data-initial-longitude={seite.stadt.longitude}
      >
        <h3 id="filter-titel">Auswahl</h3>
        <input id="ort" type="hidden" value={seite.stadt.name} />
        <p id="ort-hinweis" hidden>Ausschnitt um {seite.stadt.name}.</p>
        <ul id="ort-treffer" hidden></ul>
        <p id="orts-ladefehler" role="status" hidden></p>
        <button id="ortsdaten-erneut" type="button" hidden>Ortsdaten erneut laden</button>

        <fieldset>
          <legend>Kategorie</legend>
          {
            Object.entries(KATEGORIE_LABEL).map(([schluessel, label]) => (
              <label class="wahl">
                <input type="checkbox" name="kategorie" value={schluessel} />
                <span>{label}</span>
                <span class="anzahl" data-category-count={schluessel}>
                  {(seite.befund.jeKategorie[schluessel] ?? 0).toLocaleString('de-DE')}
                </span>
              </label>
            ))
          }
          <p class="hilfe">Ohne Auswahl werden alle Kategorien gezeigt.</p>
        </fieldset>

        <label for="radius">Umkreis</label>
        <select id="radius">
          {
            RADIEN_METER.map((meter) => (
              <option value={meter} selected={meter === STADT_KRITERIEN.radiusMeter}>
                {formatiereEntfernung(meter)}
              </option>
            ))
          }
        </select>
      </form>

      <section class="map-output" aria-labelledby="karte-titel">
        <div class="map-copy">
          <div>
            <p class="eyebrow">Interaktive Karte</p>
            <h3 id="karte-titel">{seite.stadt.name} und Umgebung</h3>
          </div>
          <button type="button" id="karte-anzeigen">Karte anzeigen</button>
        </div>
        <p class="kartenhinweis">
          Die Karte lädt erst auf Klick. {TILES.noticeText}
        </p>
        <div id="karte" class="karte" hidden></div>
        <p id="karte-status" class="hilfe" role="status" aria-live="polite"></p>
      </section>
    </div>

    <section class="results" aria-labelledby="treffer-titel">
      <div class="results-heading">
        <h3 id="treffer-titel">Treffer</h3>
        <p id="treffer-status" role="status" aria-live="polite">
          {
            initialTreffer.length < seite.befund.gesamt
              ? `Erste ${initialTreffer.length} von ${seite.befund.gesamt} erfassten Orten im Umkreis von ${umkreis} um ${seite.stadt.name}.`
              : `${seite.befund.gesamt} erfasste Orte im Umkreis von ${umkreis} um ${seite.stadt.name}.`
          }
        </p>
      </div>
      <ul
        id="trefferliste"
        class="treffer"
        tabindex="0"
        aria-label={`Erfasste Orte rund um ${seite.stadt.name}`}
        data-profile={String(kartenMarkt.featureFlags.profile === true)}
        data-contact-email={kontakt ?? ''}
        data-page-path={eigenerPfad}
      >
        {
          initialTreffer.map((treffer) => (
            <li>
              <p class="kategorie">
                {KATEGORIE_LABEL[treffer.ort.category] ?? treffer.ort.category}
              </p>
              <h3>{treffer.ort.name}</h3>
              <p class="meta">
                {formatiereEntfernung(treffer.entfernungMeter)} vom Stadtmittelpunkt ·{' '}
                {treffer.ortsLabel}
                {treffer.punktBerechnet && ' · Position berechnet'}
              </p>
              {treffer.ort.openingHours !== null ? (
                <p>Öffnungszeiten: {treffer.ort.openingHours}</p>
              ) : (
                <p class="unbekannt">Öffnungszeiten nicht erfasst</p>
              )}
              {treffer.ort.phone !== null && (
                <p>
                  Telefon:{' '}
                  <a href={`tel:${treffer.ort.phone.replace(/\s/g, '')}`}>{treffer.ort.phone}</a>
                </p>
              )}
              {(() => {
                const web = darstellung(treffer.ort.website);
                if (web.art === 'link')
                  return (
                    <p>
                      <a href={web.url} rel="nofollow noopener">
                        Website
                      </a>
                    </p>
                  );
                if (web.art === 'text')
                  return (
                    <p class="unbekannt">
                      Website: {web.adresse} ({web.hinweis})
                    </p>
                  );
                return null;
              })()}
              {notdienstHinweis(treffer.ort.emergency) !== null && (
                <p class="notdienst">{notdienstHinweis(treffer.ort.emergency)}</p>
              )}
              {verzeichnisKontaktLink(kontakt, treffer.ort.id, eigenerPfad) !== null && (
                <p class="hilfe">
                  <a href={verzeichnisKontaktLink(kontakt, treffer.ort.id, eigenerPfad)!}>
                    Eintrag berichtigen oder Datenschutzanfrage stellen
                  </a>
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </section>

  {
    kommunal !== null && (
      <section aria-labelledby="kommunal-titel" class="kommunal">
        <h2 id="kommunal-titel">Von der Verwaltung ausgewiesene Flächen</h2>
        <p>
          Der Datensatz von {kommunal.gemeinde} führt {kommunal.freilauf} ausgewiesene
          Freilauffläche{kommunal.freilauf === 1 ? '' : 'n'}
          {kommunal.verbot > 0 &&
            ` und ${kommunal.verbot} Hundemitnahmeverbot${kommunal.verbot === 1 ? '' : 'e'}`}
          .
        </p>
        <p class="hilfe">
          Datenstand: {formatCalendarDate(kommunal.stand.slice(0, 10), market.locale)} ·{' '}
          <a href={kommunal.attributionUrl} rel="nofollow noopener">
            Quelle und Lizenz
          </a>
        </p>
        <Notice variante="hinweis" titel="Geltungsbereich der Verwaltungsdaten">
          <p>{kommunal.geltung}</p>
        </Notice>
        <ul class="flaechen">
          {kommunal.flaechen.slice(0, KOMMUNAL_MAX).map((flaeche) => (
            <li>
              <h3>{flaeche.name ?? 'Ohne Bezeichnung in der Quelle'}</h3>
              <p class={flaeche.kind === 'dog_off_leash' ? 'ausweisung' : 'ausweisung verbot'}>
                {ART_LABEL[flaeche.kind]}
              </p>
              {flaeche.address !== null && flaeche.address !== flaeche.name && (
                <p>{flaeche.address}</p>
              )}
              {flaeche.district !== null && <p>Bezirk: {flaeche.district}</p>}
              {flaeche.note !== null && <p>{flaeche.note}</p>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    nachbarn.length > 1 && (
      <section aria-labelledby="staedte-titel" class="other-cities">
        <h2 id="staedte-titel">Weitere Städte</h2>
        <ul class="staedte">
          {nachbarn
            .filter((nachbar) => nachbar.slug !== seite.slug)
            .map((nachbar) => (
              <li>
                <a href={subroutePath(kartenMarkt, 'map', nachbar.slug)}>{nachbar.name}</a>
              </li>
            ))}
        </ul>
      </section>
    )
  }

  <section class="source" aria-labelledby="quelle-titel">
    <h2 id="quelle-titel">Quelle</h2>
    <p>
      {quelle.attribution}. Die Ortsdaten stehen unter der Open Database License;{' '}
      <a href={quelle.attributionUrl} rel="nofollow noopener">Herkunft und Lizenz</a>.
    </p>
  </section>

  <script>
    import { listeStarten } from '../../../features/map/list-ui.ts';
    listeStarten();
  </script>

  <style>
    .eyebrow,
    .kategorie {
      color: var(--color-primary);
      font-size: var(--text-small);
      font-weight: 700;
      letter-spacing: 0.08em;
      margin: 0 0 var(--space-2);
      text-transform: uppercase;
    }

    .city-hero {
      display: grid;
      gap: var(--space-8);
      margin-block-end: var(--space-10);
    }

    .city-hero h1,
    .section-heading h2,
    .map-copy h3,
    .results-heading h3 {
      margin-block-start: 0;
    }

    .city-notices :global(.hinweisbox) {
      margin-block: 0 var(--space-3);
    }

    .city-directory {
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: var(--space-5);
    }

    .section-heading,
    .map-copy,
    .results-heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-4);
    }

    .city-tools {
      display: grid;
      gap: var(--space-5);
      margin-block: var(--space-5) var(--space-8);
    }

    .city-filter,
    .map-output {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--space-4);
      min-width: 0;
    }

    .city-filter h3 {
      margin-top: 0;
    }

    .city-filter fieldset {
      border: 0;
      padding: 0;
      margin: 0 0 var(--space-4);
    }

    .city-filter legend,
    .city-filter > label {
      font-weight: 600;
      margin-block-end: var(--space-2);
    }

    .wahl {
      align-items: center;
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-2);
      min-height: 2.5rem;
      border-bottom: 1px solid var(--color-border);
    }

    .anzahl {
      color: var(--color-text-muted);
      font-variant-numeric: tabular-nums;
    }

    select {
      width: 100%;
      padding: var(--space-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-surface);
    }

    .kartenhinweis,
    .hilfe,
    .meta {
      color: var(--color-text-muted);
      font-size: var(--text-small);
    }

    .karte {
      height: 28rem;
      max-height: 65vh;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      margin-block-start: var(--space-3);
    }

    .treffer,
    .flaechen,
    .staedte {
      list-style: none;
      padding: 0;
    }

    .treffer {
      display: grid;
      gap: var(--space-3);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
      max-height: 54rem;
      overflow-y: auto;
      padding-inline-end: var(--space-1);
    }

    .treffer > li,
    .flaechen > li {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--space-3) var(--space-4);
      min-width: 0;
    }

    .treffer h3,
    .flaechen h3 {
      font-size: var(--text-body);
      margin: 0 0 var(--space-1);
    }

    .treffer p,
    .flaechen p {
      margin-block: var(--space-1);
      overflow-wrap: anywhere;
    }

    .unbekannt {
      color: var(--color-text-muted);
      font-style: italic;
    }

    .notdienst,
    .ausweisung {
      border-inline-start: 3px solid var(--color-warning);
      padding-inline-start: var(--space-2);
    }

    .ausweisung {
      border-inline-start-color: var(--color-success);
    }

    .ausweisung.verbot {
      border-inline-start-color: var(--color-warning);
    }

    .kommunal,
    .other-cities,
    .source {
      margin-block-start: var(--space-12);
    }

    .flaechen {
      display: grid;
      gap: var(--space-3);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    }

    .staedte {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
    }

    @media (min-width: 900px) {
      .city-hero {
        grid-template-columns: minmax(0, 1.25fr) minmax(23rem, 0.75fr);
        align-items: start;
      }

      .city-tools {
        grid-template-columns: 18rem minmax(0, 1fr);
      }

      .map-output {
        min-height: 25rem;
      }
    }

    @media (max-width: 640px) {
      .city-directory {
        padding: var(--space-3);
      }

      .section-heading,
      .map-copy,
      .results-heading {
        display: block;
      }

      .map-copy button {
        margin-block: var(--space-2);
      }
    }
  </style>
</BaseLayout>
