---
import { existsSync } from 'node:fs';

import { getCollection, render, type CollectionEntry } from 'astro:content';

import {
  devFeatureOverrides,
  productionFeatures,
  resolveBuildConfig,
} from '../../../../config/build.ts';
import { createSiteConfig } from '../../../../config/site.ts';
import ArticleRenderer from '../../../components/guides/ArticleRenderer.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import { editorialSources } from '../../../domain/editorial-sources.ts';
import { defaultMarket, withEnabledFeatures } from '../../../domain/market.ts';
import {
  validateEditorialArticles,
  type EditorialArticleCandidate,
} from '../../../features/editorial/quality.ts';
import { ARTICLE_TOOL_LABELS } from '../../../features/editorial/navigation.ts';
import { articlePath } from '../../../features/editorial/paths.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { routeExists, routePath, type RouteKey } from '../../../lib/routes.ts';

const market = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
const build = resolveBuildConfig();

export async function getStaticPaths() {
  const staticMarket = withEnabledFeatures(defaultMarket(), productionFeatures());
  const articles = await getCollection('ratgeber');
  const paths = new Set<string>();
  for (const article of articles) paths.add(articlePath(article.data));
  for (const key of Object.keys(ARTICLE_TOOL_LABELS) as RouteKey[]) {
    if (routeExists(staticMarket, key)) paths.add(routePath(staticMarket, key));
  }

  const candidates: EditorialArticleCandidate[] = articles.map((article) => ({
    id: article.id,
    data: article.data,
    body: article.body ?? '',
  }));
  const issues = validateEditorialArticles(candidates, editorialSources(), {
    now: new Date().toISOString().slice(0, 10),
    validInternalPaths: paths,
    dataFileExists: existsSync,
  });
  if (issues.length > 0) {
    throw new Error(
      `Redaktionelle Qualitätsprüfung fehlgeschlagen:\n${issues
        .map((issue) => `- ${issue.slug} · ${issue.field}: ${issue.problem}`)
        .join('\n')}`,
    );
  }

  return articles
    .filter((article) => article.data.section === 'guide')
    .map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

interface Props {
  article: CollectionEntry<'ratgeber'>;
}

const { article } = Astro.props;
const allArticles = await getCollection('ratgeber');
const { Content, headings } = await render(article);
const sourceById = new Map(editorialSources().map((source) => [source.id, source]));
const sources = article.data.sourceIds.map((id) => sourceById.get(id)!);
const relatedArticles = article.data.relatedArticles
  .map((slug) => allArticles.find((entry) => entry.data.slug === slug))
  .filter((entry): entry is CollectionEntry<'ratgeber'> => entry !== undefined)
  .map((entry) => ({ href: articlePath(entry.data), title: entry.data.title }));
const toolLinks = article.data.relatedTools
  .filter((key) => routeExists(market, key))
  .map((key) => ({ key, label: ARTICLE_TOOL_LABELS[key] ?? key, path: routePath(market, key) }));
const path = articlePath(article.data);
const canonical = new URL(path, build.baseUrl).toString();
const site = createSiteConfig(build.mode, process.env);
const shouldIndex = article.data.status === 'published' && article.data.indexable;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.data.title,
    description: article.data.description,
    datePublished: article.data.publishedAt,
    dateModified: article.data.updatedAt,
    mainEntityOfPage: canonical,
    isAccessibleForFree: true,
    author: { '@type': 'Organization', name: site.brandName },
    publisher: { '@type': 'Organization', name: site.brandName, url: build.baseUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Start',
        item: new URL('/de-de/', build.baseUrl).toString(),
      },
      { '@type': 'ListItem', position: 2, name: article.data.title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  canonicalPfad={path}
  neverIndex={!shouldIndex}
  weit={article.data.legacyRenderer !== undefined}
  structuredData={structuredData}
  ogType="article"
>
  <Breadcrumbs market={market} stufen={[{ label: article.data.title }]} />
  <a class="back-link" href="/de-de/ratgeber/">← Alle Ratgeber</a>
  <ArticleRenderer {article} {Content} {headings} {sources} {relatedArticles} {toolLinks} />
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin-block-end: var(--space-2);
  }
</style>
