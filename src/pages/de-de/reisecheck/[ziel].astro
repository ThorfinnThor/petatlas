---
/**
 * M12-05 — Zielseite je unterstütztem Land.
 *
 * Eine Seite entsteht **nur** für Ziele, die im geprüften Umfang stehen. Für
 * alle anderen gibt es keine Seite — auch keine mit dem Hinweis „bald“. Eine
 * Seite zu einem Land, dessen Regeln niemand gelesen hat, wäre eine Auskunft.
 *
 * Die Seite ist zum Ausdrucken gedacht: die Packliste hat Kästchen zum
 * Abhaken, und die Druckregeln in `src/styles/print.css` blenden aus, was auf
 * Papier nichts nützt.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import Notice from '../../../components/Notice.astro';
import ReviewStatus from '../../../components/ReviewStatus.astro';
import { defaultMarket, isFeatureEnabled, withEnabledFeatures } from '../../../domain/market.ts';
import { devFeatureOverrides } from '../../../../config/build.ts';
import { routePath, subroutePath } from '../../../lib/routes.ts';
import { reiseUmfang } from '../../../features/travel/scope.ts';
import { regelSaetze } from '../../../features/travel/rules.ts';
import { KATEGORIE_TITEL, packlisteNach } from '../../../features/travel/packing.ts';
import type { TravelRuleSet } from '../../../domain/schemas/travel.ts';
import { nationalGuidance } from '../../../features/travel/national.ts';
import { ZIELLAENDER } from '../../../features/travel/laender.ts';
import { freigabeFuer } from '../../../features/travel/freigabe.ts';
import { fristenAus, fristenplan } from '../../../features/travel/fristen.ts';
import TravelPlan from '../../../components/travel/TravelPlan.astro';
import PageIntro from '../../../components/ui/PageIntro.astro';

export function getStaticPaths() {
  const market = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
  if (!isFeatureEnabled(market, 'travel')) return [];

  return reiseUmfang()
    .destinations.filter((code) => ZIELLAENDER[code] !== undefined)
    .map((code) => ({
      params: { ziel: ZIELLAENDER[code]!.slug },
      props: { code, name: ZIELLAENDER[code]!.name },
    }));
}

const { code, name } = Astro.props as { code: string; name: string };
const market = withEnabledFeatures(defaultMarket(), devFeatureOverrides());
const checkPfad = routePath(market, 'travel');
const eigenerPfad = subroutePath(market, 'travel', ZIELLAENDER[code]!.slug);

const satz: TravelRuleSet = regelSaetze()[0]!;
const freigabe = freigabeFuer(satz);
const letzteQuellenpruefung = satz.sources
  .map((quelle) => quelle.retrievedAt)
  .sort()
  .at(-1)!;
const umfang = reiseUmfang();
const national = nationalGuidance(code);
const fristen = fristenAus(satz);
/** Verständliche Überschrift je Anforderung; die Fundstelle steht darunter. */
const TITEL: Record<string, string> = {
  microchip: 'Mikrochip',
  'rabies-vaccination': 'Gültige Tollwutimpfung',
  'identification-document': 'EU-Heimtierausweis',
  'owner-accompanied': 'Reise mit dem Halter',
  'max-five-animals': 'Höchstens fünf Tiere',
};
const BILD: Record<string, string> = {
  AT: 'hero-dog-alpine-lake',
  FR: 'travel-human-dog-sunset',
  IT: 'play-dog-alpine-lake',
  NL: 'travel-human-dog-sunset',
};
const schritte = fristenplan(satz, code);
const fragen = [
  {
    frage: `Wie lange vor der Reise nach ${name} muss die Tollwutimpfung sein?`,
    antwort: `Bei einer Erstimpfung oder einer neuen Impfung nach abgelaufenem Schutz mindestens ${fristen.wartezeitTage} Tage vor der Einreise. Eine Auffrischung, die vor Ablauf der bisherigen Impfung gegeben wurde, löst keine neue Wartezeit aus. Die Impfung muss auch am Tag der Rückreise noch gültig sein.`,
  },
  {
    frage: `Braucht mein Hund für ${name} eine Bandwurmbehandlung?`,
    antwort:
      'Nein. Eine Behandlung gegen den Fuchsbandwurm ist nur für die Einreise nach Finnland, Irland, Malta, Nordirland und Norwegen vorgeschrieben.',
  },
  {
    frage: 'Gilt mein alter EU-Heimtierausweis noch?',
    antwort:
      'Ältere Ausweismodelle können nach Übergangsregeln weitergelten; ein alter Ausweis muss nicht pauschal ersetzt werden. Er muss vollständig ausgefüllt sein und Chip und gültige Tollwutimpfung zeigen. Im Zweifel bestätigt die ausstellende Praxis die Gültigkeit.',
  },
  ...(code === 'FR'
    ? [
        {
          frage: 'Darf ich mit einem Listenhund nach Frankreich?',
          antwort:
            'Hunde der französischen Kategorie 1 dürfen weder einreisen noch durchreisen. Für Kategorie 2 gelten zusätzliche Voraussetzungen. Die französische Einstufung lässt sich nicht aus einer deutschen Liste übernehmen; kläre sie vor der Buchung.',
        },
      ]
    : []),
];
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: fragen.map((f) => ({
      '@type': 'Question',
      name: f.frage,
      acceptedAnswer: { '@type': 'Answer', text: f.antwort },
    })),
  },
];
---

<BaseLayout
  title={`Mit Hund oder Katze nach ${name}: Fristenplan, Impfung, Ausweis`}
  description={`Was du für die Reise mit Hund oder Katze nach ${name} brauchst und bis wann: Fristenplan mit Datumsrechner, Tollwutimpfung (${fristen.wartezeitTage} Tage Wartezeit), Heimtierausweis, Landesregeln und Packliste.`}
  structuredData={structuredData}
  route="travel"
  canonicalPfad={eigenerPfad}
  weit
>
  <Breadcrumbs
    market={market}
    stufen={[{ label: 'Reisecheck', route: 'travel' }, { label: name }]}
  />

  <PageIntro
    titel={`Mit Hund oder Katze nach ${name}`}
    eyebrow="Reisecheck · Zielland"
    bild={BILD[code] ?? 'travel-human-dog-sunset'}
  >
    <p>
      Was für die private, begleitete Reise aus Deutschland nach {name} zu erledigen ist – mit Fundstelle
      zu jedem Punkt und einer Packliste zum Ausdrucken. Für den Abgleich mit Ihren eigenen Daten gibt
      es den <a href={checkPfad}>Reisecheck</a>.
    </p>
  </PageIntro>

  <div class="ziel">
    <TravelPlan land={name} schritte={schritte} fristen={fristen} />

    <section class="ziel__abschnitt" aria-labelledby="gilt-titel">
      <p class="eyebrow">Einreiseregeln der EU</p>
      <h2 id="gilt-titel">Was gilt</h2>
      <p class="grundlage">Rechtsgrundlage: {satz.legalBasis}.</p>
      <ul class="anforderungen">
        {
          satz.requirements.map((anforderung) => (
            <li data-anforderung={anforderung.requirementId}>
              <h3>{TITEL[anforderung.requirementId] ?? anforderung.citation}</h3>
              <p class="zitat">{anforderung.citation}</p>
              <p>{anforderung.guidance}</p>
              <p class="fundstelle">
                <a href={anforderung.officialSourceUrl} rel="nofollow noopener">
                  Amtliche Fundstelle
                </a>
              </p>
            </li>
          ))
        }
      </ul>
      <ReviewStatus
        status={freigabe.freigegeben ? 'approved' : 'pending'}
        reviewedAt={freigabe.reviewedAt}
        reviewedBy={freigabe.reviewedBy}
        lastVerifiedAt={letzteQuellenpruefung}
        responsibility="Noch keiner fachlich prüfenden Person zugeordnet"
        sources={satz.sources.map((quelle) => ({ label: quelle.title, url: quelle.url }))}
      >
        {
          freigabe.freigegeben ? (
            <p>Der Regelsatz wurde fachlich freigegeben. Jede Anforderung nennt ihre Fundstelle.</p>
          ) : (
            <p>
              Die Anforderungen stammen aus der Rechtsgrundlage und sind mit Fundstelle belegt, aber
              <strong>fachlich noch nicht abgenommen</strong>. Verbindlich ist die Auskunft der
              zuständigen Behörde. Diese Seite ist eine Vorbereitung, keine Genehmigung.
            </p>
          )
        }
      </ReviewStatus>
    </section>

    {
      national && (
        <section class="ziel__abschnitt ziel__land" aria-labelledby="land-titel">
          <p class="eyebrow">Zusätzlich in {name}</p>
          <h2 id="land-titel">{national.title}</h2>
          <p>{national.text}</p>
          <p class="fundstelle">
            Quellenprüfung: 09.09.2026 · <a href={national.url}>Offizielle Landesquelle</a>
            {code === 'FR' && (
              <>
                {' '}
                ·{' '}
                <a href="https://www.service-public.gouv.fr/particuliers/vosdroits/F1839">
                  Zusätzliche Voraussetzungen für Kategoriehunde
                </a>
              </>
            )}
            {code === 'NL' && (
              <>
                {' '}
                ·{' '}
                <a href="https://www.amsterdam.nl/leefomgeving/dieren/honden-riem-hondenpoep-opruimen/">
                  Beispiel Amsterdam: amtliche Auslaufregeln
                </a>
              </>
            )}
          </p>
        </section>
      )
    }

    <section class="ziel__abschnitt" aria-labelledby="packliste-titel">
      <p class="eyebrow">Zum Abhaken</p>
      <h2 id="packliste-titel">Packliste</h2>
      <p class="hilfe">
        Zum Abhaken und Ausdrucken gedacht – die Häkchen bleiben auf diesem Gerät und werden
        nirgends abgeglichen. <button type="button" id="drucken" hidden>Seite drucken</button>
        <span id="druckhinweis">Im Browser über „Drucken“ (Strg+P beziehungsweise Cmd+P).</span>
      </p>
      <p id="packliste-stand" role="status" aria-live="polite" class="hilfe"></p>
      <p>
        <button type="button" id="packliste-zuruecksetzen" hidden>Häkchen zurücksetzen</button>
      </p>
      <div class="packliste-raster" data-packliste={ZIELLAENDER[code]!.slug}>
        {
          (['rule_task', 'documents', 'equipment'] as const).map((kategorie) => (
            <section class="packliste-gruppe" aria-labelledby={`packliste-${kategorie}`}>
              <h3 id={`packliste-${kategorie}`}>{KATEGORIE_TITEL[kategorie]}</h3>
              <ul class="packliste" data-kategorie={kategorie}>
                {packlisteNach(kategorie).map((eintrag) => (
                  <li data-eintrag={eintrag.itemId}>
                    <label class="packliste__zeile">
                      <input type="checkbox" data-eintrag={eintrag.itemId} />
                      <span>
                        <strong>{eintrag.label}.</strong> {eintrag.note}
                      </span>
                    </label>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <Notice variante="hinweis" titel="Keine Reiseapotheke">
        <p>
          Auf dieser Liste stehen keine Medikamente, keine Wirkstoffe und keine Dosierungen. Was Ihr
          Tier auf einer Reise braucht — gegen Reiseübelkeit, gegen Zecken, bei bestehenden
          Erkrankungen —, entscheidet die Tierarztpraxis, die es kennt.
        </p>
      </Notice>
    </section>

    <section class="ziel__abschnitt ziel__transport" aria-labelledby="transport-titel">
      <h2 id="transport-titel">Fluggesellschaft, Bahn und Fähre</h2>
      <p>
        Die Beförderungsbedingungen des Unternehmens sind <strong>etwas anderes</strong> als die staatlichen
        Einreiseregeln: Größe und Art der Transportbox, Gewichtsgrenzen, Anzahl der Tiere an Bord, Anmeldefristen
        und Aufpreise legt jedes Unternehmen selbst fest, und sie ändern sich häufig. Sie werden hier
        weder geprüft noch wiedergegeben.
      </p>
      <p>
        Fragen Sie vor der Buchung beim konkreten Unternehmen nach — und lassen Sie sich die Zusage
        für Ihr Tier schriftlich geben, nicht nur telefonisch.
      </p>
    </section>

    <section class="ziel__abschnitt" aria-labelledby="fragen-titel">
      <h2 id="fragen-titel">Häufige Fragen</h2>
      <div class="fragen">
        {
          fragen.map((f) => (
            <details>
              <summary>{f.frage}</summary>
              <p>{f.antwort}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="ziel__abschnitt" aria-labelledby="ziele-titel">
      <h2 id="ziele-titel">Andere Ziele</h2>
      <p>
        Eigene Seiten gibt es nur für {umfang.destinations.length} Ziele:
        {' '}{umfang.destinations.map((c) => ZIELLAENDER[c]?.name ?? c).join(', ')}. Fehlt Ihr Ziel,
        heißt das nicht, dass die Reise unzulässig wäre — nur, dass hier niemand die Regeln dafür
        geprüft hat.
      </p>
      <ul class="ziele">
        {
          umfang.destinations
            .filter((c) => c !== code && ZIELLAENDER[c] !== undefined)
            .map((c) => (
              <li>
                <a href={subroutePath(market, 'travel', ZIELLAENDER[c]!.slug)}>
                  {ZIELLAENDER[c]!.name} →
                </a>
              </li>
            ))
        }
      </ul>
    </section>
  </div>

  <script>
    import { packlisteStarten } from '../../../features/profile/packing-ui.ts';

    packlisteStarten();

    // Der Druckknopf erscheint nur mit JavaScript; ohne bleibt der Hinweis
    // auf die Druckfunktion des Browsers stehen.
    const knopf = document.querySelector<HTMLButtonElement>('#drucken');
    const hinweis = document.querySelector<HTMLElement>('#druckhinweis');
    if (knopf !== null) {
      knopf.hidden = false;
      if (hinweis !== null) hinweis.hidden = true;
      knopf.addEventListener('click', () => window.print());
    }
  </script>

  <style>
    .ziel {
      display: grid;
      gap: var(--space-4);
    }
    .ziel__abschnitt {
      margin-block: var(--space-8) 0;
    }
    .ziel__abschnitt h2 {
      margin-block: 0 var(--space-3);
    }
    .eyebrow {
      margin: 0 0 var(--space-2);
      color: var(--color-primary);
      font-size: var(--text-small);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .grundlage,
    .fundstelle,
    .hilfe,
    .zitat {
      color: var(--color-text-muted);
      font-size: var(--text-small);
    }
    .zitat {
      margin: 0 0 var(--space-2);
    }
    .anforderungen,
    .packliste,
    .ziele {
      list-style: none;
      padding: 0;
    }
    .anforderungen {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-block: var(--space-4);
    }
    .anforderungen > li {
      flex: 1 1 22rem;
      min-inline-size: 0;
      padding: var(--space-4) var(--space-5);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
      box-shadow: var(--shadow-sm);
      overflow-wrap: break-word;
    }
    .anforderungen h3 {
      margin: 0 0 var(--space-1);
      font-size: var(--text-lead);
    }
    .anforderungen p {
      margin-block: var(--space-1);
    }
    .ziel__land {
      padding: var(--space-6);
      border: 1px solid var(--color-primary-border);
      border-radius: var(--radius-xl);
      background: var(--color-primary-soft);
    }
    .ziel__land > p {
      max-inline-size: 70ch;
    }
    .packliste-raster {
      display: grid;
      gap: var(--space-4);
      margin-block: var(--space-4);
    }
    .packliste-gruppe {
      min-inline-size: 0;
      padding: var(--space-4) var(--space-5);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
    }
    .packliste-gruppe h3 {
      margin: 0 0 var(--space-2);
      font-size: var(--text-body);
    }
    .packliste > li {
      margin-block: var(--space-2);
    }
    .packliste__zeile {
      display: flex;
      gap: var(--space-2);
      align-items: baseline;
      cursor: pointer;
    }
    .packliste__zeile input {
      flex: 0 0 auto;
      width: 1em;
      height: 1em;
      margin: 0;
    }
    .ziel__transport {
      padding: var(--space-5) var(--space-6);
      border-inline-start: 4px solid var(--color-warning-border);
      border-radius: var(--radius-md);
      background: var(--color-surface);
    }
    .ziel__transport p {
      max-inline-size: 72ch;
    }
    .fragen details {
      padding-block: var(--space-3);
      border-block-end: 1px solid var(--color-border);
    }
    .fragen summary {
      cursor: pointer;
      font-weight: 600;
    }
    .ziele {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .ziele a {
      display: inline-block;
      padding: var(--space-2) var(--space-4);
      border: 1px solid var(--color-primary-border);
      border-radius: var(--radius-pill);
      background: var(--color-primary-soft);
      color: var(--color-primary-hover);
      font-weight: 600;
      text-decoration: none;
    }
    @media (min-width: 760px) {
      .packliste-raster {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  </style>
</BaseLayout>
