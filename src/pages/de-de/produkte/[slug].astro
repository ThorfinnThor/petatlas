---
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import PurchaseGuide from '../../../components/pages/PurchaseGuide.astro';
import { defaultMarket } from '../../../domain/market.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  PURCHASE_GUIDES,
  type PurchaseGuide as PurchaseGuideData,
} from '../../../features/commerce/purchase-guides.ts';

export function getStaticPaths() {
  return PURCHASE_GUIDES.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: PurchaseGuideData;
}

const { guide } = Astro.props;
const canonicalPfad = `/de-de/produkte/${guide.slug}/`;
const market = defaultMarket();
---

<BaseLayout title={guide.metaTitle} description={guide.description} canonicalPfad={canonicalPfad}>
  <Breadcrumbs market={market} stufen={[{ label: guide.title }]} />
  <PurchaseGuide guide={guide} />
</BaseLayout>
