---
/**
 * Übersicht der Produktvergleiche. /de-de/produkte/ war bisher eine 404,
 * obwohl alle Vergleiche darunter liegen.
 */
import PageIntro from '../../../components/ui/PageIntro.astro';
import { FUTTER_VERGLEICHE } from '../../../features/food/comparison-pages.ts';
import { PRODUKT_VERGLEICHE, produkteFuer } from '../../../features/products/comparison-pages.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const gruppen = [
  { tier: 'cat' as const, titel: 'Für Katzen' },
  { tier: 'dog' as const, titel: 'Für Hunde' },
].map((gruppe) => ({
  ...gruppe,
  seiten: PRODUKT_VERGLEICHE.filter((seite) => seite.tier === gruppe.tier),
}));
---

<BaseLayout
  title="Produktvergleiche für Hund und Katze"
  description="Alle Produktvergleiche: Trinkbrunnen, Futterautomaten, Katzentoiletten, Transportboxen, Rampen, Leinen und Spielzeug – je mindestens sechs Modelle mit offengelegten Kriterien."
  canonicalPfad="/de-de/produkte/"
  weit
>
  <PageIntro titel="Produktvergleiche" eyebrow="Produkte · Hund und Katze" bild="play-cat-home">
    <p>
      Je Produktart mindestens sechs Modelle aus mehreren Marken, bewertet nach offengelegten
      Kriterien, mit Empfehlung je Einsatz und Quellen. Keine bezahlte Rangfolge.
    </p>
  </PageIntro>

  {
    gruppen.map((gruppe) => (
      <section class="vergleiche" aria-labelledby={`vergleiche-${gruppe.tier}`}>
        <h2 id={`vergleiche-${gruppe.tier}`}>{gruppe.titel}</h2>
        <ul>
          {gruppe.seiten.map((seite) => (
            <li>
              <a class="vergleich" href={`/de-de/produkte/${seite.slug}/`}>
                <span class="vergleich__eyebrow">{seite.eyebrow}</span>
                <span class="vergleich__titel">{seite.titel.split(':')[0]}</span>
                <span class="vergleich__frage">{seite.frage}</span>
                <span class="vergleich__meta">
                  {produkteFuer(seite).length} Modelle · mit Empfehlung{' '}
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="vergleiche" aria-labelledby="vergleiche-futter">
    <h2 id="vergleiche-futter">Futter</h2>
    <p class="vergleiche__hinweis">
      Futtervergleiche rechnen Protein und Kosten pro Tag für ein Referenztier aus; die Übersicht
      steht unter <a href="/de-de/futter/vergleich/">Futtervergleiche</a>.
    </p>
    <ul>
      {
        FUTTER_VERGLEICHE.map((seite) => (
          <li>
            <a class="vergleich" href={`/de-de/futter/vergleich/${seite.slug}/`}>
              <span class="vergleich__eyebrow">
                {seite.species === 'cat' ? 'Katze' : 'Hund'} ·{' '}
                {seite.format === 'dry' ? 'Trockenfutter' : 'Nassfutter'}
              </span>
              <span class="vergleich__titel">{seite.titel.split(':')[0]}</span>
              <span class="vergleich__frage">{seite.referenzLabel}</span>
              <span class="vergleich__meta">
                Zum Vergleich <span aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .vergleiche {
    margin-block-end: var(--space-12);
  }

  .vergleiche h2 {
    margin-block: 0 var(--space-4);
  }

  .vergleiche__hinweis {
    color: var(--color-text-muted);
  }

  .vergleiche ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vergleiche li {
    margin: 0;
    max-inline-size: none;
  }

  .vergleich {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    block-size: 100%;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }

  .vergleich:hover {
    border-color: var(--color-primary);
  }

  .vergleich__eyebrow {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: 700;
  }

  .vergleich__titel {
    font-size: var(--text-h4);
    font-weight: 700;
    line-height: 1.25;
  }

  .vergleich__frage {
    color: var(--color-text);
  }

  .vergleich__meta {
    margin-block-start: auto;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
</style>
