---
/**
 * M04-03 — Alle Marktseiten entstehen aus der Route Registry.
 *
 * `getStaticPaths` erzeugt genau die Pfade, die `buildablePaths` nennt. Damit
 * kann per Konstruktion keine Seite gebaut werden, die es laut Registry nicht
 * gibt — und kein Navigationseintrag auf eine leere Ankündigungsseite zeigen.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  allMarkets,
  requireMarket,
  withEnabledFeatures,
  type MarketConfig,
} from '../domain/market.ts';
import { devFeatureOverrides } from '../../config/build.ts';
import { translate, type LocaleId } from '../domain/i18n.ts';
import { ROUTES, routeExists, routePath, type RouteKey } from '../lib/routes.ts';

import Care from '../components/pages/Care.astro';
import Catalog from '../components/pages/Catalog.astro';
import Costs from '../components/pages/Costs.astro';
import Accessibility from '../components/pages/Accessibility.astro';
import DataStatusPage from '../components/pages/DataStatusPage.astro';
import Method from '../components/pages/Method.astro';
import Favorites from '../components/pages/Favorites.astro';
import Supplements from '../components/pages/Supplements.astro';
import Food from '../components/pages/Food.astro';
import Home from '../components/pages/Home.astro';
import Imprint from '../components/pages/Imprint.astro';
import Map from '../components/pages/Map.astro';
import Privacy from '../components/pages/Privacy.astro';
import Profile from '../components/pages/Profile.astro';
import Sources from '../components/pages/Sources.astro';
import Toys from '../components/pages/Toys.astro';
import Travel from '../components/pages/Travel.astro';

export function getStaticPaths() {
  // In einem Entwicklungsbuild dürfen zusätzliche Funktionen sichtbar sein;
  // die versionierte Marktkonfiguration bleibt davon unberührt.
  const overrides = devFeatureOverrides();
  return allMarkets()
    .filter((market) => market.enabled)
    .map((market) => withEnabledFeatures(market, overrides))
    .flatMap((market) =>
      ROUTES.filter((route) => routeExists(market, route.key)).map((route) => ({
        // Astro erwartet den Pfad ohne führenden und abschließenden Schrägstrich.
        params: { pfad: routePath(market, route.key).slice(1, -1) || undefined },
        props: { marketId: market.id, routeKey: route.key },
      })),
    );
}

interface Props {
  marketId: string;
  routeKey: RouteKey;
}

const { marketId, routeKey } = Astro.props as Props;
const market: MarketConfig = withEnabledFeatures(requireMarket(marketId), devFeatureOverrides());
const locale = market.locale as LocaleId;
const titel = translate(locale, `nav.${routeKey}`);

/**
 * Breite Seiten nutzen den Seitencontainer statt der Lesebreite
 * (Designvertrag Abschnitt 6.2 und 6.3): Startseite, Karte und die
 * Produktübersichten zeigen Raster, keine Fließtexte.
 *
 * Seit M21-03 gehören Rechner und Reisecheck dazu: eine zweispaltige
 * Tool-Ansicht in Lesebreite ist keine — sie quetscht beide Spalten auf je
 * 300 px. Die Fließtexte bleiben trotzdem bei 68ch, das regelt die
 * Typografie und nicht der Container.
 */
const WEITE_SEITEN: readonly RouteKey[] = [
  'home',
  'costs',
  'map',
  'travel',
  'catalog',
  'care',
  'toys',
  'food',
];
---

<BaseLayout title={titel} route={routeKey} weit={WEITE_SEITEN.includes(routeKey)}>
  {routeKey === 'home' && <Home market={market} />}
  {routeKey === 'costs' && <Costs />}
  {routeKey === 'map' && <Map />}
  {routeKey === 'catalog' && <Catalog />}
  {routeKey === 'profile' && <Profile />}
  {routeKey === 'favorites' && <Favorites />}
  {routeKey === 'travel' && <Travel />}
  {routeKey === 'care' && <Care />}
  {routeKey === 'toys' && <Toys />}
  {routeKey === 'food' && <Food />}
  {routeKey === 'supplements' && <Supplements />}
  {routeKey === 'sources' && <Sources />}
  {routeKey === 'dataStatus' && <DataStatusPage />}
  {routeKey === 'imprint' && <Imprint />}
  {routeKey === 'privacy' && <Privacy />}
  {routeKey === 'method' && <Method />}
  {routeKey === 'accessibility' && <Accessibility />}
</BaseLayout>
