# M01-04 — Vorlage. Ausschließlich Namen und unschädliche Beispielwerte.
# Echte Werte gehören nie in diese Datei und nie ins Repository.
# Ablageorte der echten Secrets stehen in docs/EXTERNAL_SETUP.md.

# development | preview | production
BUILD_MODE=development

# In development/preview zulässige Platzhalterdomain (RFC 6761).
# production verweigert den Build mit diesem Wert.
PUBLIC_SITE_URL=https://example.invalid

# Markt-Kennung. Sie ist keine Veröffentlichungserlaubnis.
MARKET=DE

# Offene Daten, die per GitHub Actions importiert werden (ADR-009).
OPEN_DATA_REPO=
OPEN_DATA_REF=

# --- Ab hier nur Namen. Werte ausschließlich im jeweils genannten Kontext. ---

# Secret. Nur als Cloudflare-Build-Secret im freigegebenen Produktionskontext.
# Kein PUBLIC_-Präfix: alles mit PUBLIC_ landet im ausgelieferten Browsercode.
AWIN_FEED_URL=

# Secret. Nur als GitHub-Secret für den vertrauenswürdigen Rebuildjob.
# Die vollständige Hook-URL ist selbst das Geheimnis.
CLOUDFLARE_DEPLOY_HOOK=

# Reale, nicht indexierbare App-Vorschau: BUILD_MODE=preview und APP_PROFILE=real.
APP_PROFILE=
PUBLIC_BRAND_NAME=PetAtlas

# Öffentliche Betreiberangaben; vor Produktion vollständig setzen.
OPERATOR_LEGAL_NAME=
OPERATOR_ADDRESS=
OPERATOR_CONTACT_EMAIL=
OPERATOR_RESPONSIBLE=
OPERATOR_REGISTER_ENTRY=
OPERATOR_VAT_ID=
