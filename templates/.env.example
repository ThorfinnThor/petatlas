# Nur Namen/ungefährliche Defaults. Echte Werte nie committen.
BUILD_MODE=development
PUBLIC_SITE_URL=https://example.invalid
OPEN_DATA_REPO=
OPEN_DATA_REF=
# Secret nur in autorisiertem Cloudflare-Produktionsbuild:
AWIN_FEED_URL=
# Secret nur im vertrauenswürdigen GitHub-Rebuildjob:
CLOUDFLARE_BUILD_HOOK=
# MARKET ist keine automatische Veröffentlichungserlaubnis.
MARKET=DE
